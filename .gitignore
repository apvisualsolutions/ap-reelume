# Self-hosted CI runner living inside the project tree; never part of the sources
.runner/

# Build and IDE output
.vs/
.idea/
bin/
obj/
artifacts/
TestResults/
*.trx
*.coverage
coverage.*.xml
*.binlog
.dotnet/
*.user
*.suo

# Local application state and secrets
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.cache/

# User-owned media library files
*.avi
*.m2ts
*.m4v
*.mkv
*.mov
*.mp4
*.mpeg
*.mpg
*.ts
*.webm
*.wmv
*.ass
*.ssa
*.srt
*.vtt

# Third-party kits that must never be published: NVIDIA's RTX Video SDK forbids stand-alone
# distribution and its guide is confidential. A dot folder on purpose: the privacy test reads any
# other unknown folder at the root as someone's own library.
/.vendor/

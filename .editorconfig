root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = suggestion
# The repository is published under the project's own licence, whose text is LICENSE at the root. A
# licence stated only there stops being attached to a file the moment that file is copied out of the
# tree; the SPDX header travels with it. `dotnet format --verify-no-changes` is the gate: a source
# file added without the header fails the same check that already guards the rest of the style.
#
# The identifier carries NO version, and that is deliberate. It used to name a licence outright
# (`GPL-3.0-or-later`), so the day the licence changed, 1.028 files had to change with it. A
# `LicenseRef-` names the project's own licence and points at the document; the version and the date
# live inside LICENSE, which is where a reader has to go anyway to learn the terms. Rewording the
# licence now touches one file instead of a thousand, and this line never moves again.
file_header_template = SPDX-FileCopyrightText: 2026 AP Solutions\nSPDX-License-Identifier: LicenseRef-APSolutions
dotnet_diagnostic.IDE0073.severity = warning
# QA-001: where a format is data rather than language, the culture has to be stated. These three are
# off by default, so nothing was watching: CA1305 for a missing IFormatProvider, CA1304 and CA1310
# for culture-dependent casing and comparison. Measured on 2026-08-14 before turning them on — the
# whole solution produced zero of them, and a deliberate violation of each was compiled to prove the
# zero was a measurement and not a rule that never ran. They are errors rather than warnings so the
# gate survives somebody relaxing TreatWarningsAsErrors.
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1310.severity = error

[tests/**/*.cs]
# Descriptive xUnit behavior names intentionally use underscores.
dotnet_diagnostic.CA1707.severity = none

[*.{csproj,props,targets,axaml,xaml,xml,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

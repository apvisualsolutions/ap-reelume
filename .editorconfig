root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = suggestion
# The repository is published under GPL-3.0-or-later, and a licence stated only in LICENSE stops
# being attached to a file the moment that file is copied out of the tree. The SPDX header travels
# with it. `dotnet format --verify-no-changes` is the gate: a source file added without the header
# fails the same check that already guards the rest of the style.
file_header_template = SPDX-FileCopyrightText: 2026 AP Solutions\nSPDX-License-Identifier: GPL-3.0-or-later
dotnet_diagnostic.IDE0073.severity = warning

[tests/**/*.cs]
# Descriptive xUnit behavior names intentionally use underscores.
dotnet_diagnostic.CA1707.severity = none

[*.{csproj,props,targets,axaml,xaml,xml,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

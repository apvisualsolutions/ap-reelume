<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The idle-cost measurement builds the real Windows tray, so this suite targets the Windows
      framework for the same reason the integration suite does: the adapter under measurement only
      exists there.
    -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ApSolutions.LocalMedia.Application\ApSolutions.LocalMedia.Application.csproj" />
    <ProjectReference Include="..\..\src\ApSolutions.LocalMedia.Infrastructure\ApSolutions.LocalMedia.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ApSolutions.LocalMedia.Presentation\ApSolutions.LocalMedia.Presentation.csproj" />
    <ProjectReference Include="..\..\src\ApSolutions.LocalMedia.Windows\ApSolutions.LocalMedia.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
</Project>

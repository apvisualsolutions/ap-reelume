<!--
  SPDX-FileCopyrightText: 2026 Carlos Armando Puche Martín
  SPDX-License-Identifier: LicenseRef-APSolutions

  Copies the LibVLC tree libvlc.lock.json pins into the output, in place of the
  VideoLAN.LibVLC.Windows NuGet package, which carried GPL plugins. The shape is that package's on purpose: the
  same libvlc\win-<arch>\ folders, chosen by $(Platform) the same way, as Content with
  PreserveNewest. So LibVLCSharp's Core.Initialize() finds the engine where it always did, the
  content flows to every project that references Infrastructure as it always did, and the
  packaging scripts, which delete the foreign architecture from a layout, keep working unchanged.

  What changed is where the tree comes from: fetch-libvlc.ps1 downloads it and refuses any bytes
  that are not the pinned ones. It is skipped when neither the lock file nor the script changed
  since the markers were written, which is what keeps it off the cost of an ordinary build.
-->
<Project>
  <PropertyGroup>
    <LibVlcDirectory>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\..\artifacts\libvlc))</LibVlcDirectory>
    <LibVlcX64Enabled Condition="'$(LibVlcX64Enabled)' == '' AND ('$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU')">true</LibVlcX64Enabled>
    <LibVlcArm64Enabled Condition="'$(LibVlcArm64Enabled)' == '' AND ('$(Platform)' == 'ARM64' OR '$(Platform)' == 'AnyCPU')">true</LibVlcArm64Enabled>
    <LibVlcArchitectures Condition="'$(LibVlcX64Enabled)' == 'true'">x64</LibVlcArchitectures>
    <LibVlcArchitectures Condition="'$(LibVlcArm64Enabled)' == 'true'">$(LibVlcArchitectures),arm64</LibVlcArchitectures>
    <LibVlcArchitectures>$(LibVlcArchitectures.TrimStart(','))</LibVlcArchitectures>
  </PropertyGroup>

  <ItemGroup>
    <LibVlcMarker Include="$(LibVlcDirectory)win-x64.sha512" Condition="'$(LibVlcX64Enabled)' == 'true'" />
    <LibVlcMarker Include="$(LibVlcDirectory)win-arm64.sha512" Condition="'$(LibVlcArm64Enabled)' == 'true'" />
  </ItemGroup>

  <Target Name="FetchLibVlc"
          BeforeTargets="BeforeBuild"
          Condition="'$(LibVlcArchitectures)' != ''"
          Inputs="$(MSBuildThisFileDirectory)libvlc.lock.json;$(MSBuildThisFileDirectory)fetch-libvlc.ps1"
          Outputs="@(LibVlcMarker)">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)fetch-libvlc.ps1&quot; -Architecture $(LibVlcArchitectures)" />
  </Target>

  <!--
    Every build, not only the ones that fetch. FetchLibVlc is skipped whenever its markers are newer
    than the lock file, so the "unpinned" warning fetch-libvlc.ps1 prints could not be relied on to
    reach anyone: a marker set to unpinned with the lock pinned built in silence.
    This reads the markers themselves.
  -->
  <Target Name="WarnOnUnpinnedLibVlc" AfterTargets="FetchLibVlc" BeforeTargets="BeforeBuild" Condition="'$(LibVlcArchitectures)' != ''">
    <ReadLinesFromFile File="%(LibVlcMarker.Identity)" Condition="Exists('%(LibVlcMarker.Identity)')">
      <Output TaskParameter="Lines" ItemName="LibVlcMarkerLine" />
    </ReadLinesFromFile>
    <Warning Condition="'%(LibVlcMarkerLine.Identity)' == 'unpinned'" Text="LibVLC: this build copies a tree installed with fetch-libvlc.ps1 -FromTree, not the one libvlc.lock.json pins. Only for testing before publication." />
  </Target>

  <!--
    Plugins of the pinned tree that never reach a build, each with its reason.
    libi420_yuy2_sse2_plugin.dll: VLC 3.0.23's SSE2 conversion from I420 to UYVY writes out of bounds
    when the visible width is not a multiple of eight (852, 854 and 1918 measured; 640, 848, 856 and
    864 not), and took the whole application down on an 854-wide video. Without it VLC
    picks the MMX one, which converts the same widths; the ARM64 tree never had an SSE2 variant.
  -->
  <PropertyGroup>
    <LibVlcX64Withheld>plugins\video_chroma\libi420_yuy2_sse2_plugin.dll</LibVlcX64Withheld>
  </PropertyGroup>

  <!-- A target and not a static ItemGroup: the tree does not exist until FetchLibVlc has run. -->
  <Target Name="CollectLibVlcFiles" AfterTargets="FetchLibVlc" BeforeTargets="BeforeBuild">
    <ItemGroup Condition="'$(LibVlcX64Enabled)' == 'true'">
      <LibVlcX64File Include="$(LibVlcDirectory)win-x64\libvlc.dll;$(LibVlcDirectory)win-x64\libvlccore.dll;$(LibVlcDirectory)win-x64\hrtfs\**;$(LibVlcDirectory)win-x64\licenses\**;$(LibVlcDirectory)win-x64\plugins\**"
                     Exclude="$(LibVlcDirectory)win-x64\$(LibVlcX64Withheld)" />
      <Content Include="@(LibVlcX64File)">
        <Link>libvlc\win-x64\$([MSBuild]::MakeRelative($(LibVlcDirectory)win-x64\, %(FullPath)))</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(LibVlcArm64Enabled)' == 'true'">
      <LibVlcArm64File Include="$(LibVlcDirectory)win-arm64\libvlc.dll;$(LibVlcDirectory)win-arm64\libvlccore.dll;$(LibVlcDirectory)win-arm64\hrtfs\**;$(LibVlcDirectory)win-arm64\licenses\**;$(LibVlcDirectory)win-arm64\plugins\**" />
      <Content Include="@(LibVlcArm64File)">
        <Link>libvlc\win-arm64\$([MSBuild]::MakeRelative($(LibVlcDirectory)win-arm64\, %(FullPath)))</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <Error Condition="'$(LibVlcX64Enabled)' == 'true' AND !Exists('$(LibVlcDirectory)win-x64\libvlc.dll')" Text="The pinned LibVLC x64 tree is not in $(LibVlcDirectory)win-x64: run eng/libvlc/fetch-libvlc.ps1." />
    <Error Condition="'$(LibVlcArm64Enabled)' == 'true' AND !Exists('$(LibVlcDirectory)win-arm64\libvlc.dll')" Text="The pinned LibVLC arm64 tree is not in $(LibVlcDirectory)win-arm64: run eng/libvlc/fetch-libvlc.ps1." />
  </Target>

  <!--
    PreserveNewest copies and never removes, so an output folder built before a plugin was withheld
    would keep it and crash the same way. Taken out after every copy and every publish.
  -->
  <Target Name="RemoveWithheldLibVlcFiles" AfterTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(LibVlcX64Enabled)' == 'true'">
    <Delete Files="$(OutDir)libvlc\win-x64\$(LibVlcX64Withheld)" />
    <Delete Files="$(PublishDir)libvlc\win-x64\$(LibVlcX64Withheld)" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>

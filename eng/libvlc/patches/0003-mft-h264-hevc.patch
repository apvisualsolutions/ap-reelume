+    size_t prefix = IsNalCodec(p_dec) && p_sys->send_parameter_sets
+                  ? p_dec->fmt_in.i_extra : 0;
+
+    if (AllocateInputSample(p_dec, stream_id, &input_sample, prefix + p_block->i_buffer))
         goto error;
 
     IMFMediaBuffer *input_media_buffer = NULL;
@@ -582,19 +610,20 @@ static int ProcessInputStream(decoder_t *p_dec, DWORD stream_id, block_t *p_bloc

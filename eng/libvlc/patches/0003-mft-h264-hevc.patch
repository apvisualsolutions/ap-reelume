+    if (IsNalCodec(p_dec))
     {
-        /* in-place NAL to annex B conversion. */
-        h264_AVC_to_AnnexB(buffer_start, p_block->i_buffer, p_sys->nal_length_size);
+        /* in-place NAL to annex B conversion, of the packet only. */
+        h264_AVC_to_AnnexB(buffer_start + prefix, p_block->i_buffer, p_sys->nal_length_size);
     }
 
     hr = IMFMediaBuffer_Unlock(input_media_buffer);
     if (FAILED(hr))
         goto error;
 
-    hr = IMFMediaBuffer_SetCurrentLength(input_media_buffer, p_block->i_buffer);
+    hr = IMFMediaBuffer_SetCurrentLength(input_media_buffer, prefix + p_block->i_buffer);
     if (FAILED(hr))

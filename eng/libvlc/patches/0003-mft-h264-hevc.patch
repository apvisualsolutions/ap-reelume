             goto error;
+        p_sys->output_events++;
         return VLC_SUCCESS;
     }
     else if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT)
@@ -767,6 +798,7 @@ static int ProcessOutputStream(decoder_t *p_dec, DWORD stream_id)
         goto error;

  */
+static const GUID VLC_MFVideoFormat_HEVC =
+    { 0x43564548, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 } };
+
+/* H.264 and HEVC travel as NAL units: length-prefixed in MP4 and Matroska, with their parameter
+ * sets out of band, while the Media Foundation decoders want Annex B with the sets in the stream. */
+static bool IsNalCodec(const decoder_t *p_dec)
+{
+    return p_dec->fmt_in.i_codec == VLC_CODEC_H264 || p_dec->fmt_in.i_codec == VLC_CODEC_HEVC;
+}
+
 static const pair_format_guid video_format_table[] =
 {
     { VLC_CODEC_H264, &MFVideoFormat_H264 },
+    { VLC_CODEC_HEVC, &VLC_MFVideoFormat_HEVC },
     { VLC_CODEC_MJPG, &MFVideoFormat_MJPG },
     { VLC_CODEC_WMV1, &MFVideoFormat_WMV1 },
     { VLC_CODEC_WMV2, &MFVideoFormat_WMV2 },
@@ -569,7 +593,11 @@ static int ProcessInputStream(decoder_t *p_dec, DWORD stream_id, block_t *p_bloc
     HRESULT hr;
     IMFSample *input_sample = NULL;
 

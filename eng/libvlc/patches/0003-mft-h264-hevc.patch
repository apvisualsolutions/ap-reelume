@@ -783,12 +815,31 @@ error:
     return VLC_EGENERIC;
 }
 
+/* Takes every output the decoder has ready, not just one. */
+static int ProcessAllOutput(decoder_t *p_dec)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    unsigned before;
+    do
+    {
+        before = p_sys->output_events;
+        if (ProcessOutputStream(p_dec, p_sys->output_stream_id))
+            return VLC_EGENERIC;
+    } while (p_sys->output_events != before);
+    return VLC_SUCCESS;
+}
+
 static int DecodeSync(decoder_t *p_dec, block_t *p_block)
 {
     decoder_sys_t *p_sys = p_dec->p_sys;
 
-    if (!p_block) /* No Drain */
+    if (!p_block)
+    {
+        /* Drain: what the decoder still holds at the end of the stream is the last frames. */
+        if (SUCCEEDED(IMFTransform_ProcessMessage(p_sys->mft, MFT_MESSAGE_COMMAND_DRAIN, 0)))
+            ProcessAllOutput(p_dec);
         return VLCDEC_SUCCESS;
+    }
 
     if (p_block->i_flags & (BLOCK_FLAG_CORRUPTED))
     {

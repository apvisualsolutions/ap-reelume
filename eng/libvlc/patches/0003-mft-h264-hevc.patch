-            if (h264_isavcC((uint8_t*)p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra))
+            if (p_dec->fmt_in.i_codec == VLC_CODEC_H264
+                && h264_isavcC((uint8_t*)p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra))
             {
                 size_t i_buf;
                 uint8_t *buf = h264_avcC_to_AnnexB_NAL(p_dec->fmt_in.p_extra,
@@ -999,6 +1053,21 @@ static int InitializeMFT(decoder_t *p_dec)
                     p_dec->fmt_in.i_extra = i_buf;
                 }
             }
+            else if (p_dec->fmt_in.i_codec == VLC_CODEC_HEVC
+                     && hevc_ishvcC((uint8_t*)p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra))
+            {
+                size_t i_buf;

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApSolutions.LocalMedia.Application\ApSolutions.LocalMedia.Application.csproj" />
    <ProjectReference Include="..\ApSolutions.LocalMedia.Domain\ApSolutions.LocalMedia.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Ed25519 and Blake2b for minisign verification (SEC-003). The BCL ships neither: its Ed25519
      only exists inside the composite post-quantum names, and Blake2b not at all. Managed-only,
      no native payload, pinned like everything else.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
    <EmbeddedResource Include="Data\Migrations\Manifest.json" />
  </ItemGroup>
</Project>

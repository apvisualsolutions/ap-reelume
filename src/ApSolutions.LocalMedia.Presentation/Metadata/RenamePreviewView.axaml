<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Metadata.RenamePreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:discovery="using:ApSolutions.LocalMedia.Domain.Discovery"
    xmlns:home="using:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:metadata="using:ApSolutions.LocalMedia.Presentation.Metadata"
    x:DataType="metadata:RenamePreviewViewModel"
    automation:AutomationProperties.Name="{DynamicResource RenamePreviewAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="RenameResourceKey" />
  </UserControl.Resources>
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="{DynamicResource Space12}">
    <StackPanel Spacing="{DynamicResource Space4}">
      <!-- A section of the library pane, whose level one belongs to LibraryView. -->
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource RenamePreviewTitle}"
          automation:AutomationProperties.HeadingLevel="2" />
      <TextBlock Text="{DynamicResource RenamePreviewDescription}" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Operations}" automation:AutomationProperties.Name="{DynamicResource RenameOperationListName}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="discovery:RenameOperation">
          <!--
            Fixed width, so the two paths line up character under character and the eye finds the one
            segment that differs instead of hunting for it.

            PathSegmentEllipsis and not CharacterEllipsis, which is what these carried: character
            trimming eats the END, and the end of a rename is the file name - the only part that
            differs. This one drops middle segments and keeps both ends. §4 says the same thing about
            the restore wizard's roots in its own words: paths are told apart by their end.

            The arrow stays a symbol and gains the words behind it, which is the half a screen reader
            gets; without them the row reads as two paths and a character.
          -->
          <Grid Margin="4" ColumnDefinitions="*,Auto,*" ColumnSpacing="{DynamicResource Space8}">
            <TextBlock
                FontFamily="{DynamicResource FontFamilyMono}"
                Text="{Binding SourcePath}"
                TextTrimming="PathSegmentEllipsis" />
            <TextBlock
                Grid.Column="1"
                Text="→"
                automation:AutomationProperties.Name="{DynamicResource RenameSeparatorAccessibleName}" />
            <TextBlock
                Grid.Column="2"
                FontFamily="{DynamicResource FontFamilyMono}"
                Text="{Binding DestinationPath}"
                TextTrimming="PathSegmentEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Spacing="{DynamicResource Space8}">
      <ItemsControl ItemsSource="{Binding Conflicts}" IsVisible="{Binding HasConflicts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="discovery:RenameConflict">
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock
          x:Name="RenameFailureText"
          IsVisible="{Binding HasFailure}"
          Text="{Binding FailureKey, Converter={StaticResource RenameResourceKey}}"
          TextWrapping="Wrap"
          automation:AutomationProperties.Name="{Binding FailureKey, Converter={StaticResource RenameResourceKey}}" />
    </StackPanel>
    <CheckBox
        Grid.Row="3"
        IsChecked="{Binding IsConfirmed}"
        Content="{DynamicResource RenameExplicitConsent}"
        automation:AutomationProperties.Name="{DynamicResource RenameExplicitConsent}" />
    <!-- A WrapPanel, for the reason written eight times in this repository. -->
    <WrapPanel Grid.Row="4" ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          Command="{Binding ExecuteCommand}"
          Content="{DynamicResource RenameExecuteAction}"
          automation:AutomationProperties.Name="{DynamicResource RenameExecuteAction}" />
      <Button
          Command="{Binding UndoCommand}"
          Content="{DynamicResource RenameUndoAction}"
          automation:AutomationProperties.Name="{DynamicResource RenameUndoAction}" />
    </WrapPanel>
  </Grid>
</UserControl>

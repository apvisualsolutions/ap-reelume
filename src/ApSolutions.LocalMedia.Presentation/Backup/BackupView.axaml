<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Backup.BackupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:backup="clr-namespace:ApSolutions.LocalMedia.Presentation.Backup"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="backup:BackupViewModel"
    automation:AutomationProperties.Name="{DynamicResource BackupAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="BackupResourceKey" />
  </UserControl.Resources>
  <StackPanel x:Name="BackupSurface" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource BackupTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource BackupDescription}"
        TextWrapping="Wrap" />

    <!--
      The base's whereabouts, reachable in normal operation: what the recovery screen says about
      the database should not require a failure to read. Label and path, nothing interactive.
    -->
    <StackPanel IsVisible="{Binding HasDatabasePath}" Spacing="{DynamicResource Space4}">
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource RecoveryDatabasePathLabel}" />
      <TextBlock
          x:Name="BackupDatabasePathText"
          MaxWidth="640"
          FontFamily="{DynamicResource FontFamilyMono}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding DatabasePath}"
          TextWrapping="WrapWithOverflow" />
    </StackPanel>

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          x:Name="CreateCopyButton"
          Command="{Binding CreateCopyCommand}"
          Content="{DynamicResource BackupCreateCopyLabel}"
          IsEnabled="{Binding IsIdle}"
          automation:AutomationProperties.Name="{DynamicResource BackupCreateCopyLabel}" />
      <Button
          x:Name="ExportButton"
          Command="{Binding ExportCommand}"
          Content="{DynamicResource BackupExportLabel}"
          IsEnabled="{Binding IsIdle}"
          automation:AutomationProperties.Name="{DynamicResource BackupExportLabel}" />
      <Button
          x:Name="CancelBackupButton"
          Command="{Binding CancelCommand}"
          Content="{DynamicResource BackupCancelLabel}"
          IsEnabled="{Binding IsRunning}"
          automation:AutomationProperties.Name="{DynamicResource BackupCancelLabel}" />
    </WrapPanel>

    <!--
      A failed copy is painted as one. This block said "there was not enough room on the disk" on the
      same surface as "done" until 2026-08-22, so the two read alike. Two borders and not one bound
      background, because HighContrastTests refuses a Background that comes from a binding - and
      rightly: a state told apart by a colour a binding chose is a state nobody can gate.

      Cancelled stays on the neutral one. Its own words say nothing was left half-written.
    -->
    <Border
        x:Name="BackupFailureSurface"
        Padding="16"
        Background="{DynamicResource DangerSurfaceBrush}"
        BorderBrush="{DynamicResource DangerBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        IsVisible="{Binding HasFailed}"
        automation:AutomationProperties.Name="{DynamicResource BackupStatusAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Top"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="⚠" />
        <StackPanel Grid.Column="1" Spacing="{DynamicResource Space4}">
          <TextBlock
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{Binding StatusKey, Converter={StaticResource BackupResourceKey}}"
              TextWrapping="Wrap" />
          <!-- The reassurance the approved batch wrote for exactly this block. -->
          <TextBlock
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource BackupFailedIntactNotice}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        x:Name="BackupStatusSurface"
        IsVisible="{Binding !HasFailed}"
        Padding="16"
        Background="{DynamicResource AccentSubtleBrush}"
        BorderBrush="{DynamicResource ShellHairlineBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        automation:AutomationProperties.Name="{DynamicResource BackupStatusAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <StackPanel Spacing="{DynamicResource Space8}">
        <TextBlock
            x:Name="BackupStatusText"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding StatusKey, Converter={StaticResource BackupResourceKey}}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="BackupStageText"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            IsVisible="{Binding IsRunning}"
            Text="{Binding StageKey, Converter={StaticResource BackupResourceKey}}"
            TextWrapping="Wrap" />
        <ProgressBar
            x:Name="BackupProgressBar"
            Maximum="{Binding Total}"
            Minimum="0"
            IsVisible="{Binding IsRunning}"
            Value="{Binding Completed}"
            automation:AutomationProperties.Name="{DynamicResource BackupProgressAccessibleName}" />
      </StackPanel>
    </Border>

    <!--
      What exists now. Both names were built for a screen - "the name, never the path" - and no view
      painted either, so somebody who had just made a copy could only find out by opening a file
      manager. The names are safe to show for the same reason they were shaped that way.
    -->
    <!-- No history yet, said in positive terms: what the first copy costs, not what is missing. -->
    <StackPanel IsVisible="{Binding HasNoHistory}" Spacing="{DynamicResource Space4}">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource BackupHistoryEmptyTitle}" />
      <TextBlock
          MaxWidth="640"
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource BackupHistoryEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock
          x:Name="BackupLastCopyText"
          MaxWidth="640"
          FontFamily="{DynamicResource FontFamilyMono}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          IsVisible="{Binding HasLastCopy}"
          Text="{Binding LastCopyName}"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="BackupLastArchiveText"
          MaxWidth="640"
          FontFamily="{DynamicResource FontFamilyMono}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          IsVisible="{Binding HasLastArchive}"
          Text="{Binding LastArchiveName}"
          TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource BackupExcludedNotice}"
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

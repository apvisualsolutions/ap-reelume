<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Backup.RestoreWizardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:backup="clr-namespace:ApSolutions.LocalMedia.Presentation.Backup"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="backup:RestoreWizardViewModel"
    automation:AutomationProperties.Name="{DynamicResource RestoreAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="RestoreResourceKey" />
  </UserControl.Resources>
  <StackPanel x:Name="RestoreSurface" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource RestoreTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource RestoreDescription}"
        TextWrapping="Wrap" />

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          x:Name="ChooseArchiveButton"
          Command="{Binding ChooseArchiveCommand}"
          Content="{DynamicResource RestoreChooseArchiveLabel}"
          IsEnabled="{Binding IsIdle}"
          automation:AutomationProperties.Name="{DynamicResource RestoreChooseArchiveLabel}" />
      <Button
          Classes="primary-action"
          x:Name="ConfirmRestoreButton"
          Command="{Binding ConfirmCommand}"
          Content="{DynamicResource RestoreConfirmLabel}"
          IsEnabled="{Binding CanRestore}"
          automation:AutomationProperties.Name="{DynamicResource RestoreConfirmLabel}" />
    </WrapPanel>

    <Border
        x:Name="RestoreStatusSurface"
        Padding="16"
        Background="{DynamicResource AccentSubtleBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        automation:AutomationProperties.Name="{DynamicResource RestoreStatusAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <StackPanel Spacing="{DynamicResource Space8}">
        <TextBlock
            x:Name="RestoreStatusText"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding StatusKey, Converter={StaticResource RestoreResourceKey}}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="RestoreCountsText"
            Foreground="{DynamicResource TextPrimaryBrush}"
            IsVisible="{Binding HasPreview}"
            Text="{DynamicResource RestoreCountsLabel}" />
        <ItemsControl x:Name="RestoreFindingsList" ItemsSource="{Binding Findings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="backup:RestoreFindingViewModel">
              <TextBlock
                  MaxWidth="600"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding MessageKey, Converter={StaticResource RestoreResourceKey}}"
                  TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ItemsControl
        x:Name="RestoreRootsList"
        IsVisible="{Binding HasPreview}"
        ItemsSource="{Binding Roots}"
        automation:AutomationProperties.Name="{DynamicResource RestoreRootsAccessibleName}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="backup:RootRemapRowViewModel">
          <!--
            Two columns: the folder the backup recorded, and what this row is. §4 asks for the path
            trimmed from the left because paths are told apart by their end; PathSegmentEllipsis keeps
            the end and the drive letter, which matters when two roots live on different drives, and it
            is what the rename preview already uses for the same problem. Fixed width so two of them
            read one under the other.

            The box only appears where somebody is being asked for something. Every row carried one, so
            a restore of five roots offered five invitations to change a folder and four of them
            answered a question nobody asked.
          -->
          <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
            <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}">
              <TextBlock
                  FontFamily="{DynamicResource FontFamilyMono}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding OldPath}"
                  TextTrimming="PathSegmentEllipsis" />
              <TextBox
                  MaxWidth="520"
                  HorizontalAlignment="Left"
                  FontFamily="{DynamicResource FontFamilyMono}"
                  IsVisible="{Binding NeedsFolder}"
                  Text="{Binding NewPath}"
                  automation:AutomationProperties.Name="{DynamicResource RestoreNewFolderLabel}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding StatusKey, Converter={StaticResource RestoreResourceKey}}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        IsVisible="{Binding PreservedDatabaseName, Converter={x:Static ObjectConverters.IsNotNull}}"
        Text="{DynamicResource RestorePreservedNotice}"
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Show.EpisodeRowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:show="clr-namespace:ApSolutions.LocalMedia.Presentation.Show"
    x:DataType="show:EpisodeRowViewModel">
  <!--
    A fixed 56 px row rather than one that grows with its contents: a season is a column of these, and
    rows of different heights read as a list that is still loading. The number is monospaced and
    right-aligned inside a fixed width so that 9 and 10 end on the same pixel — what lines the column
    up is the width and the alignment; the family only keeps the digits themselves even.
  -->
  <Grid Height="56" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space12}">
    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource Space4}">
      <TextBlock VerticalAlignment="Center" Text="{DynamicResource EpisodePrefix}" />
      <TextBlock
          Width="32"
          VerticalAlignment="Center"
          FontFamily="Consolas, Courier New, monospace"
          FontWeight="SemiBold"
          Text="{Binding EpisodeNumberText}"
          TextAlignment="Right" />
    </StackPanel>

    <StackPanel
        Grid.Column="1"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{DynamicResource Space8}">
      <TextBlock IsVisible="{Binding IsWatched}" Text="{DynamicResource WatchStatusWatched}" />
      <TextBlock IsVisible="{Binding IsInProgress}" Text="{DynamicResource WatchStatusInProgress}" />
      <TextBlock IsVisible="{Binding IsNotStarted}" Text="{DynamicResource WatchStatusNotStarted}" />
      <TextBlock IsVisible="{Binding IsManualOverride}" Text="{DynamicResource WatchStatusManualOverride}" />
      <library:UnavailableBadge />
      <TextBlock IsVisible="{Binding !IsPlayable}" Text="{DynamicResource EpisodeNoFile}" />
    </StackPanel>

    <Button
        Grid.Column="2"
        VerticalAlignment="Center"
        Click="OnPlayClick"
        Content="{DynamicResource EpisodePlayAction}"
        IsEnabled="{Binding IsPlayable}"
        automation:AutomationProperties.Name="{DynamicResource EpisodePlayAction}"
        automation:AutomationProperties.HelpText="{Binding SeasonEpisodeLabel}" />
  </Grid>
</UserControl>

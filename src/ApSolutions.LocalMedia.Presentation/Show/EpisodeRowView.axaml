<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Show.EpisodeRowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:show="clr-namespace:ApSolutions.LocalMedia.Presentation.Show"
    x:DataType="show:EpisodeRowViewModel">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock Text="{DynamicResource EpisodePrefix}" />
      <TextBlock FontWeight="SemiBold" Text="{Binding EpisodeNumberText}" />
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <TextBlock IsVisible="{Binding IsWatched}" Text="{DynamicResource WatchStatusWatched}" />
      <TextBlock IsVisible="{Binding IsInProgress}" Text="{DynamicResource WatchStatusInProgress}" />
      <TextBlock IsVisible="{Binding IsNotStarted}" Text="{DynamicResource WatchStatusNotStarted}" />
      <TextBlock IsVisible="{Binding IsManualOverride}" Text="{DynamicResource WatchStatusManualOverride}" />
      <Border
          Padding="8,2"
          Background="{DynamicResource AccentSubtleBrush}"
          CornerRadius="4"
          IsVisible="{Binding !IsAvailable}"
          automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
        <TextBlock FontSize="12" Text="{DynamicResource MediaUnavailable}" />
      </Border>
      <TextBlock IsVisible="{Binding !IsPlayable}" Text="{DynamicResource EpisodeNoFile}" />
    </StackPanel>

    <Button
        Grid.Column="2"
        Click="OnPlayClick"
        Content="{DynamicResource EpisodePlayAction}"
        IsEnabled="{Binding IsPlayable}"
        automation:AutomationProperties.Name="{DynamicResource EpisodePlayAction}"
        automation:AutomationProperties.HelpText="{Binding SeasonEpisodeLabel}" />
  </Grid>
</UserControl>

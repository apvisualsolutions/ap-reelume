<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Show.ShowDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:catalog="clr-namespace:ApSolutions.LocalMedia.Presentation.Catalog"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:show="clr-namespace:ApSolutions.LocalMedia.Presentation.Show"
    x:DataType="show:ShowDetailsViewModel"
    automation:AutomationProperties.Name="{DynamicResource ShowDetailsAccessibleName}">
  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource Space16}">
    <!--
      The film card's banner, on the series card: the same frame, the same coin, the same payment —
      PlayerSurfaceBrush under the title's art wall, the player's text brushes, and the computed
      layers off in both high contrasts through PosterArtOpacity, asserted by the colour-alone gate.
    -->
    <Border ClipToBounds="True" CornerRadius="{DynamicResource CornerRadiusMedium}">
      <Panel Background="{DynamicResource PlayerSurfaceBrush}">
        <Panel>
          <library:PosterArtView Classes="wide" Title="{Binding Title}" />
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#F2090C10" />
                <GradientStop Offset="0.56" Color="#B8090C10" />
                <GradientStop Offset="1" Color="#4D090C10" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>
        <Grid Margin="28" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space24}">
          <Border
              Width="136"
              Height="204"
              VerticalAlignment="Top"
              ClipToBounds="True"
              Background="{DynamicResource ControlFillBrush}"
              BorderBrush="{DynamicResource PlayerHairlineBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusMedium}">
            <Panel>
              <library:PosterArtView Title="{Binding Title}" />
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeDisplay}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource PosterInitialsBrush}"
                  Text="{Binding Initials}"
                  automation:AutomationProperties.AccessibilityView="Raw" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Space12}">
            <TextBlock
                FontSize="{DynamicResource FontSizeDisplay}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PlayerTextBrush}"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                automation:AutomationProperties.HeadingLevel="1" />
            <TextBlock
                Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                IsVisible="{Binding HasMeta}"
                Text="{Binding MetaText}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                MaxWidth="620"
                MaxHeight="160"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource PlayerTextBrush}"
                IsVisible="{Binding HasOverview}"
                Text="{Binding Overview}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                automation:AutomationProperties.Name="{DynamicResource MetadataOverviewLabel}" />
            <!--
              How far through the series you are, which is the one number a person opening a series
              card is looking for. The bar is announced with its own name and the sentence under it
              says the same thing in words, because a bar alone is a proportion nobody can read.
            -->
            <StackPanel
                Width="360"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasProgress}"
                Spacing="{DynamicResource Space4}">
              <ProgressBar
                  Height="4"
                  MinHeight="4"
                  MinWidth="0"
                  Background="{DynamicResource PlayerHairlineBrush}"
                  Foreground="{DynamicResource AccentBrush}"
                  Maximum="1"
                  Value="{Binding WatchedFraction}"
                  automation:AutomationProperties.Name="{DynamicResource HomeResumeProgressLabel}" />
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                  Text="{Binding ProgressText}" />
            </StackPanel>
            <!--
              The one episode this series is waiting on, named and startable in one place. Without it
              the card answered «here are three seasons» to the question «where was I», and the
              answer was somewhere down a list.
            -->
            <Border
                MaxWidth="540"
                Padding="14,12"
                HorizontalAlignment="Left"
                Background="{DynamicResource PlayerPanelBrush}"
                CornerRadius="{DynamicResource CornerRadiusMedium}"
                IsVisible="{Binding HasNextEpisode}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock
                      Classes="hero-overline"
                      Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                      Text="{DynamicResource ShowNextEpisodeHeading}" />
                  <TextBlock
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource PlayerTextBrush}"
                      Text="{Binding NextEpisodeLabel}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                  <TextBlock
                      FontSize="{DynamicResource FontSizeCaption}"
                      Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                      Text="{Binding NextEpisodeSubText}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="primary-action"
                    x:Name="ShowContinueAction"
                    VerticalAlignment="Center"
                    Command="{Binding ContinueCommand}"
                    automation:AutomationProperties.Name="{DynamicResource HomeResumeAction}"
                    automation:AutomationProperties.HelpText="{Binding NextEpisodeLabel}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
                    <Path Classes="icon size-14 filled" Data="{DynamicResource IconPlay}" />
                    <TextBlock Text="{DynamicResource HomeResumeAction}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <!--
              The banner's own row, and only what the prototype puts in it. The personal marks used
              to be here, which put a rating of ten buttons over the artwork and pushed the episodes
              off the first screen; they live in the column beside the episodes now, where the film
              card already keeps them.
            -->
            <WrapPanel
                x:Name="ShowActionsSurface"
                ItemSpacing="{DynamicResource Space8}"
                LineSpacing="{DynamicResource Space8}">
              <catalog:TitleActionsView />
              <Button
                  Command="{Binding OpenTrailerLinkCommand}"
                  Content="{DynamicResource DetailsTrailerLinkAction}"
                  IsVisible="{Binding HasTrailerLink}"
                  automation:AutomationProperties.Name="{DynamicResource DetailsTrailerLinkAction}" />
            </WrapPanel>
            <!--
              A series carries no local trailer on purpose: the on-disk convention
              (TrailerDiscoveryPolicy) names the trailer after a film's own video file, and a series
              has no single file to name it after — so only the browser link exists here, with the
              consequence that matters about it.
            -->
            <TextBlock
                FontSize="{DynamicResource FontSizeCaption}"
                Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                IsVisible="{Binding HasTrailerLink}"
                Text="{DynamicResource TrailerBrowserLeavesAppNotice}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Panel>
    </Border>

    <TextBlock
        Grid.Row="1"
        IsVisible="{Binding IsEmpty}"
        Text="{DynamicResource ShowDetailsEmpty}"
        TextWrapping="Wrap" />

    <!--
      The prototype's own division of a details card, which the film card already draws: what there
      is on the left, what you can do about it on the right. The series card carried its personal
      marks inside the banner instead, which is the one place the prototype never puts a control.
    -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space24}">
      <StackPanel
          Grid.Column="1"
          Width="320"
          VerticalAlignment="Top"
          Spacing="{DynamicResource Space8}">
        <TextBlock
            FontSize="{DynamicResource FontSizeSubtitle}"
            FontWeight="SemiBold"
            Text="{DynamicResource MovieOtherActionsHeading}"
            automation:AutomationProperties.HeadingLevel="2" />
        <catalog:PersonalActionsView DataContext="{Binding PersonalActions}" />
      </StackPanel>
      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Space8}">
      <!--
        The seasons, all of them on the surface. This was a dropdown, which is the right control for
        a list nobody wants to see and the wrong one for three items: it hid two thirds of a series
        behind a click and printed the chosen one in a box. The pills say what there is and which one
        is open, and the pill of the season on screen is the only one filled — enforced in the view
        model rather than here, so a second one cannot light up.

        They wrap, because a series with nine seasons is a row that would otherwise run off a 900 px
        window.
      -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space12}">
        <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{DynamicResource ShowEpisodesHeading}"
            automation:AutomationProperties.HeadingLevel="2" />
        <ItemsControl
            x:Name="SeasonPicker"
            IsVisible="{Binding HasSeasonChoice}"
            ItemsSource="{Binding Seasons}"
            automation:AutomationProperties.Name="{DynamicResource SeasonPickerLabel}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="show:SeasonViewModel">
              <!--
                The pill is named by what it says, like the continue rail's cards: three pills that
                all announced «Elegir temporada» would be three identical sentences, and the walk
                would have nothing to aim at. Checked one way only — the command decides which
                season is on screen, so a click that unchecked a pill would leave the card showing a
                season no pill claims.
              -->
              <ToggleButton
                  Classes="segment"
                  Command="{Binding $parent[ItemsControl].((show:ShowDetailsViewModel)DataContext).SelectSeasonCommand}"
                  CommandParameter="{Binding}"
                  Content="{Binding SeasonLabel}"
                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                  automation:AutomationProperties.Name="{Binding SeasonLabel}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ContentControl Grid.Row="1" Content="{Binding SelectedSeason}" IsVisible="{Binding HasSeasons}">
        <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="show:SeasonViewModel">
              <ItemsControl ItemsSource="{Binding Episodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="show:EpisodeRowViewModel">
                    <show:EpisodeRowView Margin="0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

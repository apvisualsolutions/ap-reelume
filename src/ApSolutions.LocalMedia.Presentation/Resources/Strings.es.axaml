  <x:String x:Key="RootOnboardingTitle">Añade tus carpetas</x:String>
  <x:String x:Key="RootOnboardingDescription">AP Reelume cataloga los vídeos en su ubicación original. Nunca los copia ni los mueve.</x:String>

  <x:String x:Key="DuplicatesOverviewAccessibleName">Grupos de duplicados</x:String>
  <x:String x:Key="DuplicatesIntro">Los duplicados son versiones del mismo contenido. Ningún archivo se elimina, oculta ni mueve; solo eliges cuál se reproduce por defecto.</x:String>
  <x:String x:Key="DuplicateFilesLabel">archivos · una entidad</x:String>
  <x:String x:Key="DuplicateColumnFile">ARCHIVO</x:String>
  <x:String x:Key="DuplicateColumnResolution">RESOLUCIÓN</x:String>
  <x:String x:Key="DuplicateColumnCodec">CÓDEC</x:String>
  <x:String x:Key="DuplicateColumnAudio">AUDIO</x:String>

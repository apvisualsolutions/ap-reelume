  <x:String x:Key="RenamePreviewAccessibleName">Previsualización segura de renombrado</x:String>
  <x:String x:Key="RenamePreviewTitle">Previsualizar renombrado</x:String>
  <x:String x:Key="RenamePreviewDescription">Revisa cada ruta de origen y destino. No se modificará ningún archivo hasta que confirmes expresamente.</x:String>
  <x:String x:Key="RenameOperationListName">Operaciones de renombrado previsualizadas</x:String>

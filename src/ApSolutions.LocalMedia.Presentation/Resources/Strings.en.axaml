  <x:String x:Key="AddRootBrowseDialogTitle">Choose a folder that holds your videos</x:String>
  <x:String x:Key="AddRootDetectedKindLabel">Detected source kind</x:String>
  <x:String x:Key="RootKindLocalHint">Watched continuously; changes show up in seconds.</x:String>
  <x:String x:Key="RootKindUsbHint">Not always connected. Its titles stay in the catalogue and are marked unavailable while the drive is out.</x:String>
  <x:String x:Key="RootKindUncHint">Over the network, so scanning is slower and falls back to periodic checks.</x:String>
  <x:String x:Key="RootRemoveKeepAction">Keep</x:String>
  <x:String x:Key="RootScanConsentDescription">The folder is saved. Confirm before its first scan starts.</x:String>
  <x:String x:Key="RootScanConsentAction">Allow first scan</x:String>

  <x:String x:Key="AboutTmdbAttribution">This product uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.</x:String>
  <x:String x:Key="WelcomeTitle">Your library, on your PC</x:String>
  <x:String x:Key="WelcomeDescription">Organize and review local videos without accounts, cloud services, or synchronization.</x:String>
  <x:String x:Key="CurrentAreaAccessibleName">Current content area</x:String>
  <x:String x:Key="EmptyLibraryTitle">Your library is ready</x:String>
  <x:String x:Key="EmptyLibraryDescription">Add local, USB, or UNC folders. Nothing leaves this computer.</x:String>
  <x:String x:Key="RootOnboardingAccessibleName">Add a library root</x:String>
  <x:String x:Key="RootOnboardingTitle">Add your folders</x:String>
  <x:String x:Key="RootOnboardingDescription">AP Reelume catalogs videos in their original location. It never copies or moves them.</x:String>
  <x:String x:Key="RootListTitle">Library folders</x:String>
  <x:String x:Key="RootListEmptyTitle">No folders yet</x:String>
  <x:String x:Key="RootListEmptyDescription">Add the first one above: type its path, choose which kind it is and confirm. It will appear in this list.</x:String>
  <x:String x:Key="RootRemoveAction">Remove</x:String>
  <x:String x:Key="RootRemoveConfirmAccessibleName">Confirm removing the folder</x:String>
  <x:String x:Key="RootRemoveConfirmDescription">The folder is removed from the catalog. No video on disk is touched, and adding it again catalogs it anew.</x:String>
  <x:String x:Key="RootRemoveConfirmAction">Remove from catalog</x:String>
  <x:String x:Key="RootRemoveCancelAction">Cancel</x:String>

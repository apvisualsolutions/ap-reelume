<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Movie.MovieDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:catalog="clr-namespace:ApSolutions.LocalMedia.Presentation.Catalog"
    xmlns:movie="clr-namespace:ApSolutions.LocalMedia.Presentation.Movie"
    x:DataType="movie:MovieDetailsViewModel"
    automation:AutomationProperties.Name="{DynamicResource MovieDetailsAccessibleName}">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="{DynamicResource Space12}">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Text="{Binding Title}"
          TextTrimming="CharacterEllipsis"
          automation:AutomationProperties.HeadingLevel="1" />
      <TextBlock
          VerticalAlignment="Center"
          IsVisible="{Binding HasYear}"
          Text="{Binding YearText}" />
      <Border
          Padding="8,4"
          VerticalAlignment="Center"
          Background="{DynamicResource AccentSubtleBrush}"
          CornerRadius="{DynamicResource CornerRadiusSmall}"
          IsVisible="{Binding !IsAvailable}"
          automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{DynamicResource MediaUnavailable}" />
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          Command="{Binding ResumeCommand}"
          Content="{DynamicResource MovieResumeAction}"
          IsVisible="{Binding CanResume}"
          automation:AutomationProperties.Name="{DynamicResource MovieResumeAction}" />
      <TextBlock
          VerticalAlignment="Center"
          IsVisible="{Binding CanResume}"
          Text="{Binding ResumePositionText}" />
      <Button
          Command="{Binding PlayCommand}"
          Content="{DynamicResource MoviePlayAction}"
          automation:AutomationProperties.Name="{DynamicResource MoviePlayAction}" />
      <Button
          Command="{Binding PlayTrailerCommand}"
          Content="{DynamicResource MovieTrailerAction}"
          IsVisible="{Binding HasTrailer}"
          automation:AutomationProperties.Name="{DynamicResource MovieTrailerAction}" />
      <Button
          Command="{Binding OpenTrailerLinkCommand}"
          Content="{DynamicResource DetailsTrailerLinkAction}"
          IsVisible="{Binding HasTrailerLink}"
          automation:AutomationProperties.Name="{DynamicResource DetailsTrailerLinkAction}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="{DynamicResource Space8}">
      <catalog:WatchStatusControl DataContext="{Binding WatchStatus}" />
      <catalog:PersonalActionsView DataContext="{Binding PersonalActions}" />
    </StackPanel>

    <!--
      The synopsis is a paragraph, so it wraps and is capped: a card that grows without limit pushes
      the versions off the screen for the one title whose provider was talkative.
    -->
    <TextBlock
        Grid.Row="3"
        MaxHeight="160"
        IsVisible="{Binding HasOverview}"
        Text="{Binding Overview}"
        TextTrimming="CharacterEllipsis"
        TextWrapping="Wrap"
        automation:AutomationProperties.Name="{DynamicResource MetadataOverviewLabel}" />

    <StackPanel Grid.Row="4" IsVisible="{Binding HasVersions}" Spacing="{DynamicResource Space8}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource MovieVersionsHeading}" />
      <ItemsControl ItemsSource="{Binding Versions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="movie:MediaVersionRowViewModel">
            <Grid Margin="0,2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
              <TextBlock Text="{Binding QualityLabel}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Space8}">
                <TextBlock IsVisible="{Binding IsEffective}" Text="{DynamicResource MovieVersionEffective}" />
                <TextBlock IsVisible="{Binding IsPreferred}" Text="{DynamicResource MovieVersionPreferred}" />
                <TextBlock IsVisible="{Binding !IsAvailable}" Text="{DynamicResource MediaUnavailable}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>

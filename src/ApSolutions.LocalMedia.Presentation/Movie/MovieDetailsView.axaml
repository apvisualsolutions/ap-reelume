<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Movie.MovieDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:catalog="clr-namespace:ApSolutions.LocalMedia.Presentation.Catalog"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:movie="clr-namespace:ApSolutions.LocalMedia.Presentation.Movie"
    x:DataType="movie:MovieDetailsViewModel"
    automation:AutomationProperties.Name="{DynamicResource MovieDetailsAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="DetailWord" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space12}">
    <!--
      The banner the prototype draws: the title's own art wall bled edge to edge, the poster raised
      over it, and the film's facts on the dark ground. The frame is the hero's, coin for coin — the
      base is PlayerSurfaceBrush (#0B0D10 in all four themes), the text is the player's brushes with
      their measured contrast, and the computed layers switch off in both high contrasts through
      PosterArtOpacity, which the colour-alone gate asserts by name. §4's two columns survive inside
      it: the poster fixed, the text fluid.
    -->
    <Border ClipToBounds="True" CornerRadius="{DynamicResource CornerRadiusMedium}">
      <Panel Background="{DynamicResource PlayerSurfaceBrush}">
        <Panel>
          <library:PosterArtView Classes="wide" Title="{Binding Title}" />
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#F2090C10" />
                <GradientStop Offset="0.54" Color="#BD090C10" />
                <GradientStop Offset="1" Color="#47090C10" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>
        <Grid Margin="32" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space24}">
          <!--
            The raised poster: the card's art alone, without the card — its title is already written
            beside it at display size, and writing it twice under a poster this close would be the
            initials defect with more letters. The initials themselves stay: two letters still say
            which title this is before the colour has taught anybody anything.
          -->
          <Border
              Width="158"
              Height="237"
              VerticalAlignment="Top"
              ClipToBounds="True"
              Background="{DynamicResource ControlFillBrush}"
              BorderBrush="{DynamicResource PlayerHairlineBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusMedium}">
            <Panel>
              <library:PosterArtView Title="{Binding Title}" />
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeDisplay}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource PosterInitialsBrush}"
                  Text="{Binding Initials}"
                  automation:AutomationProperties.AccessibilityView="Raw" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Space12}">
            <TextBlock
                FontSize="{DynamicResource FontSizeDisplay}"
                FontWeight="Light"
                Foreground="{DynamicResource PlayerTextBrush}"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                automation:AutomationProperties.HeadingLevel="1" />
            <!--
              What this is, in one line, and then two chips saying where it stands: whether the file
              is reachable and how far through it is. The prototype writes exactly this pair under
              the title, and the card used to answer with a bare year and a warning badge.
            -->
            <TextBlock
                Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                IsVisible="{Binding HasMeta}"
                Text="{Binding MetaText}"
                TextTrimming="CharacterEllipsis" />
            <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
              <Border Classes="state-chip" Classes.pending="{Binding !IsAvailable}">
                <TextBlock Text="{Binding AvailabilityKey, Converter={StaticResource DetailWord}}" />
              </Border>
              <Border Classes="state-chip">
                <TextBlock Text="{Binding WatchStatusKey, Converter={StaticResource DetailWord}}" />
              </Border>
            </WrapPanel>
            <!--
              The synopsis is a paragraph, so it wraps and is capped: a banner that grows without
              limit pushes the versions off the screen for the one title whose provider was
              talkative.
            -->
            <TextBlock
                MaxWidth="620"
                MaxHeight="160"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource PlayerTextBrush}"
                IsVisible="{Binding HasOverview}"
                Text="{Binding Overview}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                automation:AutomationProperties.Name="{DynamicResource MetadataOverviewLabel}" />
            <!--
              Four buttons carrying translated words is the shape that has drawn a control off the
              side of this window seven times, so the row wraps rather than pushing the last one out
              of reach.
            -->
            <WrapPanel
                x:Name="MovieActionsSurface"
                ItemSpacing="{DynamicResource Space8}"
                LineSpacing="{DynamicResource Space8}">
              <Button
                  Classes="primary-action"
                  Command="{Binding ResumeCommand}"
                  Content="{DynamicResource MovieResumeAction}"
                  IsVisible="{Binding CanResume}"
                  automation:AutomationProperties.Name="{DynamicResource MovieResumeAction}" />
              <TextBlock
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                  IsVisible="{Binding CanResume}"
                  Text="{Binding ResumePositionText}" />
              <Button
                  Command="{Binding PlayCommand}"
                  Content="{DynamicResource MoviePlayAction}"
                  automation:AutomationProperties.Name="{DynamicResource MoviePlayAction}" />
              <Button
                  Command="{Binding PlayTrailerCommand}"
                  Content="{DynamicResource MovieTrailerAction}"
                  IsVisible="{Binding HasTrailer}"
                  automation:AutomationProperties.Name="{DynamicResource MovieTrailerAction}" />
              <Button
                  Command="{Binding OpenTrailerLinkCommand}"
                  Content="{DynamicResource DetailsTrailerLinkAction}"
                  IsVisible="{Binding HasTrailerLink}"
                  automation:AutomationProperties.Name="{DynamicResource DetailsTrailerLinkAction}" />
              <!--
                The three title tools, which the prototype puts in this row and this application drew
                under the library: a row of buttons acting on a card that might not even be open.
              -->
              <catalog:TitleActionsView />
            </WrapPanel>
            <!--
              The three consequences the design package wrote for the trailer, each beside the state
              it explains: what a local trailer costs (nothing), what the browser link does (leaves
              this process), and how to make a local one exist when none does — the convention is
              TrailerDiscoveryPolicy's, not this view's invention.
            -->
            <StackPanel Spacing="{DynamicResource Space4}">
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                  IsVisible="{Binding HasTrailer}"
                  Text="{DynamicResource TrailerLocalFileNotice}"
                  TextWrapping="Wrap" />
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                  IsVisible="{Binding HasTrailerLink}"
                  Text="{DynamicResource TrailerBrowserLeavesAppNotice}"
                  TextWrapping="Wrap" />
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource PlayerTextSecondaryBrush}"
                  IsVisible="{Binding !HasTrailer}"
                  Text="{DynamicResource TrailerConventionHint}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>

    <!--
      Two columns under the banner, which is the prototype's own division of this card: what there is
      of this film on the left, and what you can do about it on the right. They were a stack of loose
      rows — status, then personal actions, then versions — which read as a list of controls rather
      than as two answers.

      The columns collapse to one at the narrowest window the application allows, because 900 px
      cannot hold 620 of versions beside 320 of actions; the grid's second column is Auto and the
      panel wraps.
    -->
    <Grid
        Grid.Row="1"
        ColumnDefinitions="*,Auto"
        ColumnSpacing="{DynamicResource Space24}"
        RowDefinitions="Auto">
      <StackPanel Grid.Column="1" Width="320" Spacing="{DynamicResource Space8}">
        <TextBlock
            FontSize="{DynamicResource FontSizeSubtitle}"
            FontWeight="SemiBold"
            Text="{DynamicResource MovieOtherActionsHeading}"
            automation:AutomationProperties.HeadingLevel="2" />
        <catalog:WatchStatusControl DataContext="{Binding WatchStatus}" />
        <catalog:PersonalActionsView DataContext="{Binding PersonalActions}" />
      </StackPanel>
      <StackPanel IsVisible="{Binding HasVersions}" Spacing="{DynamicResource Space8}">
        <TextBlock
            FontSize="{DynamicResource FontSizeSubtitle}"
            FontWeight="SemiBold"
            Text="{DynamicResource MovieVersionsHeading}"
            automation:AutomationProperties.HeadingLevel="2" />
      <ItemsControl ItemsSource="{Binding Versions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="movie:MediaVersionRowViewModel">
            <!--
              The prototype's version row: a card with the quality in bold, what it weighs and how
              long it runs under it, the path in the mono face, and the state at the right. It was
              one line of text with three words beside it, which said the same things and looked
              like a log entry.
            -->
            <Border
                Margin="0,3"
                Padding="12"
                Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource ShellHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusMedium}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
                <StackPanel Spacing="{DynamicResource Space4}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding QualityLabel}" />
                  <TextBlock
                      FontSize="{DynamicResource FontSizeCaption}"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      IsVisible="{Binding HasTechnical}"
                      Text="{Binding TechnicalText}" />
                  <TextBlock
                      FontFamily="{DynamicResource FontFamilyMono}"
                      FontSize="{DynamicResource FontSizeCaption}"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Text="{Binding PathText}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource Space8}">
                  <Border Classes="state-chip" IsVisible="{Binding IsEffective}">
                    <TextBlock Text="{DynamicResource MovieVersionEffective}" />
                  </Border>
                  <Border Classes="state-chip" IsVisible="{Binding IsPreferred}">
                    <TextBlock Text="{DynamicResource MovieVersionPreferred}" />
                  </Border>
                  <!--
                    The badge itself and not a copy of it: whether a file is reachable is said in one
                    place in this application, and a row that drew its own would be the fourth copy
                    UnavailableBadgeTests exists to prevent.
                  -->
                  <library:UnavailableBadge />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

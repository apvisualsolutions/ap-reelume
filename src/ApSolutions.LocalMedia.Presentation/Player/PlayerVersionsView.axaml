<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.PlayerVersionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:PlayerVersionsViewModel"
    automation:AutomationProperties.Name="{DynamicResource PlayerVersionsAccessibleName}">
  <!--
    This one says "only one version" rather than disappearing, which is the opposite of the grammar
    the rest of the tree uses for an absent thing. The reason is where it lives: this list sits in the
    player's side column beside three others, and one that vanishes moves the rest — so somebody
    asking "is there another version of this?" reads the answer instead of finding nothing where the
    list used to be.
  -->
  <StackPanel Spacing="{DynamicResource Space8}">
    <TextBlock
        FontSize="{DynamicResource FontSizeBody}"
        FontWeight="SemiBold"
        Text="{DynamicResource PlayerVersionsTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <StackPanel
        VerticalAlignment="Top"
        IsVisible="{Binding !HasAlternatives}"
        Spacing="{DynamicResource Space4}">
      <TextBlock FontWeight="SemiBold" Text="{DynamicResource PlayerVersionsEmptyTitle}" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource PlayerVersionsEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>
    <ItemsControl IsVisible="{Binding HasAlternatives}" ItemsSource="{Binding Alternatives}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="player:PlayerVersionRowViewModel">
          <!--
            A Grid and not a horizontal StackPanel, which is the sixth time this shape has been
            measured here: a StackPanel offers its children infinite width, so a label of free width
            beside a button pushes the button as far right as the text is long. Measured on
            2026-08-17 at x=1674 in a 1600 px window, with nothing to scroll sideways — the row of a
            version nobody could switch to. The label takes the star column and wraps; the button
            keeps its own width and its place.
          -->
          <!--
            36 tall, which is what §4 gives a row of this column, and the 2 above and below is the gap
            between rows rather than part of one. The label truncates instead of wrapping: in a row of
            fixed height a second line is hidden rather than read, so the whole string goes to the
            tooltip and the first line ends in an ellipsis.
          -->
          <Grid Height="36" Margin="0,2" ColumnDefinitions="*,Auto">
            <TextBlock
                Grid.Column="0"
                Classes="row-label"
                Margin="0,0,12,0"
                Text="{Binding QualityLabel}"
                ToolTip.Tip="{Binding QualityLabel}" />
            <Button
                Grid.Column="1"
                automation:AutomationProperties.Name="{DynamicResource PlayerVersionsSwitchAction}"
                Command="{Binding SwitchCommand}"
                Content="{DynamicResource PlayerVersionsSwitchAction}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

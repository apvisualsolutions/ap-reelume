<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.VersionSwitchDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:VersionSwitchViewModel"
    automation:AutomationProperties.Name="{DynamicResource VersionSwitchAccessibleName}">
  <!--
    A question, and it has to be sized to itself. Without these two alignments the panel stretches to
    whatever contains it, and in the shell that is the whole player stage: measured on 2026-08-17 at
    1280x1400 over a 1280x1400 stage, with the three answers at its top-left corner. Third of the
    three overlays the walk found undimensioned, after the resume prompt and the next-episode offer.
  -->
  <Border
      x:Name="VersionSwitchSurface"
      MaxWidth="520"
      MaxHeight="560"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      IsVisible="{Binding IsVisible}"
      Padding="16"
      Background="{DynamicResource ShellSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
  <StackPanel Spacing="{DynamicResource Space12}">
    <TextBlock
        x:Name="VersionSwitchHeadline"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource VersionSwitchTitle}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="LargeDifferenceText"
        IsVisible="{Binding IsLargeDifference}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource VersionSwitchLargeDifference}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="UnknownDurationText"
        IsVisible="{Binding IsUnknownDuration}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource VersionSwitchUnknownDuration}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="IncompatibleStructureText"
        IsVisible="{Binding IsIncompatibleStructure}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource VersionSwitchIncompatibleStructure}"
        TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource VersionSwitchSuggestedLabel}" />
      <TextBlock
          x:Name="SuggestedPositionText"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding SuggestedPositionText}" />
    </StackPanel>

    <!--
      A WrapPanel and not a horizontal StackPanel, for the reason measured five times before this
      one: a horizontal StackPanel offers its children infinite width, so three answers of unknown
      length draw where they fall rather than where they fit.
    -->
    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          x:Name="ConfirmSwitchButton"
          Command="{Binding ConfirmCommand}"
          Content="{DynamicResource VersionSwitchConfirm}"
          automation:AutomationProperties.Name="{DynamicResource VersionSwitchConfirm}" />
      <Button
          x:Name="RestartSwitchButton"
          Command="{Binding RestartCommand}"
          Content="{DynamicResource VersionSwitchRestart}"
          automation:AutomationProperties.Name="{DynamicResource VersionSwitchRestart}" />
      <Button
          x:Name="CancelSwitchButton"
          Command="{Binding CancelCommand}"
          Content="{DynamicResource VersionSwitchCancel}"
          automation:AutomationProperties.Name="{DynamicResource VersionSwitchCancel}" />
    </WrapPanel>
  </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.SubtitleStyleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:SubtitleStyleViewModel"
    automation:AutomationProperties.Name="{DynamicResource SubtitleStyleAccessibleName}">
  <StackPanel x:Name="SubtitleStyleSurface" Spacing="12">
    <TextBlock
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource SubtitleStyleAccessibleName}"
        automation:AutomationProperties.HeadingLevel="2" />
    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleSizeLabel}" />
      <Slider
          x:Name="SubtitleSizeSlider"
          Minimum="{x:Static player:SubtitleStyleViewModel.MinimumFontSizePercent}"
          Maximum="{x:Static player:SubtitleStyleViewModel.MaximumFontSizePercent}"
          TickFrequency="10"
          IsSnapToTickEnabled="True"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleSizeLabel}"
          Value="{Binding FontSizePercent, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleFamilyLabel}" />
      <ComboBox
          x:Name="SubtitleFamilySelector"
          MinWidth="220"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleFamilyLabel}"
          ItemsSource="{x:Static player:SubtitleStyleViewModel.SafeFontFamilies}"
          SelectedItem="{Binding FontFamily, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleForegroundLabel}" />
      <TextBox
          x:Name="SubtitleForegroundBox"
          MinWidth="140"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleForegroundLabel}"
          Text="{Binding ForegroundHex, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleBackgroundLabel}" />
      <TextBox
          x:Name="SubtitleBackgroundBox"
          MinWidth="140"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleBackgroundLabel}"
          Text="{Binding BackgroundHex, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleBackgroundOpacityLabel}" />
      <Slider
          x:Name="SubtitleBackgroundOpacitySlider"
          Minimum="0"
          Maximum="1"
          TickFrequency="0.1"
          IsSnapToTickEnabled="True"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleBackgroundOpacityLabel}"
          Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStyleOutlineLabel}" />
      <Slider
          x:Name="SubtitleOutlineSlider"
          Minimum="0"
          Maximum="{x:Static player:SubtitleStyleViewModel.MaximumOutlineThickness}"
          TickFrequency="0.5"
          IsSnapToTickEnabled="True"
          automation:AutomationProperties.Name="{DynamicResource SubtitleStyleOutlineLabel}"
          Value="{Binding OutlineThickness, Mode=TwoWay}" />
    </StackPanel>

    <Border
        x:Name="SubtitlePreviewSurface"
        Padding="12"
        Background="{DynamicResource CardSurfaceBrush}"
        CornerRadius="8"
        automation:AutomationProperties.Name="{DynamicResource SubtitleStylePreviewLabel}">
      <TextBlock
          x:Name="SubtitlePreviewText"
          HorizontalAlignment="Center"
          FontFamily="{Binding FontFamily}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SubtitleStylePreviewSample}"
          TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>

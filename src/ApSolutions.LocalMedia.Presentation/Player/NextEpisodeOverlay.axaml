<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.NextEpisodeOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:NextEpisodeViewModel"
    automation:AutomationProperties.Name="{DynamicResource NextEpisodeAccessibleName}"
    automation:AutomationProperties.LiveSetting="Polite">
  <!--
    Sized to itself, like the status badge corrected on 2026-08-15 and the resume offer beside it:
    without the two alignments this stretches to the whole player stage, measured on 2026-08-17 at
    1280x1400, with its buttons in the corner rather than in the card they belong to.
  -->
  <Border
      x:Name="NextEpisodeSurface"
      MaxWidth="420"
      MaxHeight="240"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      Margin="24"
      Padding="16"
      IsVisible="{Binding IsVisible}"
      Background="{DynamicResource ShellSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
  <StackPanel Spacing="{DynamicResource Space8}">
    <TextBlock
        x:Name="NextEpisodeHeadline"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource NextEpisodeTitle}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="NextEpisodeLabel"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{Binding EpisodeLabel}" />

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource NextEpisodeRemainingLabel}" />
      <TextBlock
          x:Name="NextEpisodeCountdown"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding CountdownText}" />
    </StackPanel>

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          x:Name="PlayNextNowButton"
          Command="{Binding PlayNowCommand}"
          Content="{DynamicResource NextEpisodePlayNow}"
          automation:AutomationProperties.Name="{DynamicResource NextEpisodePlayNow}" />
      <Button
          x:Name="CancelNextButton"
          Command="{Binding CancelCommand}"
          Content="{DynamicResource NextEpisodeCancel}"
          automation:AutomationProperties.Name="{DynamicResource NextEpisodeCancel}" />
    </WrapPanel>
  </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.NextEpisodeOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:NextEpisodeViewModel"
    automation:AutomationProperties.Name="{DynamicResource NextEpisodeAccessibleName}"
    automation:AutomationProperties.LiveSetting="Polite">
  <StackPanel x:Name="NextEpisodeSurface" IsVisible="{Binding IsVisible}" Spacing="8">
    <TextBlock
        x:Name="NextEpisodeHeadline"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource NextEpisodeTitle}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="NextEpisodeLabel"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{Binding EpisodeLabel}" />

    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource NextEpisodeRemainingLabel}" />
      <TextBlock
          x:Name="NextEpisodeCountdown"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding CountdownText}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button
          x:Name="PlayNextNowButton"
          Command="{Binding PlayNowCommand}"
          Content="{DynamicResource NextEpisodePlayNow}"
          automation:AutomationProperties.Name="{DynamicResource NextEpisodePlayNow}" />
      <Button
          x:Name="CancelNextButton"
          Command="{Binding CancelCommand}"
          Content="{DynamicResource NextEpisodeCancel}"
          automation:AutomationProperties.Name="{DynamicResource NextEpisodeCancel}" />
    </StackPanel>
  </StackPanel>
</UserControl>

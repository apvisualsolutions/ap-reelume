<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.MiniPlayerChromeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:shell="clr-namespace:ApSolutions.LocalMedia.Presentation.Shell"
    x:DataType="shell:ShellViewModel"
    automation:AutomationProperties.Name="{DynamicResource MiniPlayerChromeAccessibleName}">
  <!--
    A WrapPanel and not a row: the window's own minimum is 320, and the five carried translated words
    until 2026-08-21 - measured folding into three rows inside 480x270, which is what the glyphs of §4
    were for. The wrapping stays, because a glyph shrinks the row without proving it can never wrap:
    this is the shape that has put a control outside the window six times in this repository.
  -->
  <!--
    Only Content changed here. AutomationProperties.Name still points at the resource key, so the five
    answer to the same names the walk presses and a screen reader still reads a word rather than a
    private-use codepoint. The font list lives in the player-chrome class, in one place for all eleven.
  -->
  <!--
    The spacing is the panel's and not the buttons'. It lived in the player-chrome class as a Margin
    until the large transport adopted that class and would have inherited a separation it did not
    want.
  -->
  <WrapPanel
      x:Name="MiniPlayerChromeSurface"
      HorizontalAlignment="Center"
      Background="{DynamicResource ShellSurfaceBrush}"
      ItemSpacing="{DynamicResource Space8}"
      LineSpacing="{DynamicResource Space8}">
    <Button
        x:Name="MiniPlayerPlayPause"
        Classes="player-chrome"
        Command="{Binding Player.Player.TogglePlaybackCommand}"
        Content="&#xE768;"
        automation:AutomationProperties.Name="{DynamicResource MiniPlayerPlayPause}" />
    <Button
        x:Name="MiniPlayerSkipBack"
        Classes="player-chrome"
        Command="{Binding Player.Player.Transport.SkipBackwardCommand}"
        Content="&#xE72B;"
        automation:AutomationProperties.Name="{DynamicResource MiniPlayerSkipBack}" />
    <Button
        x:Name="MiniPlayerSkipForward"
        Classes="player-chrome"
        Command="{Binding Player.Player.Transport.SkipForwardCommand}"
        Content="&#xE72A;"
        automation:AutomationProperties.Name="{DynamicResource MiniPlayerSkipForward}" />
    <Button
        x:Name="MiniPlayerRestore"
        Classes="player-chrome"
        Command="{Binding ToggleMiniPlayerCommand}"
        Content="&#xE73F;"
        automation:AutomationProperties.Name="{DynamicResource MiniPlayerRestore}" />
    <Button
        x:Name="MiniPlayerClose"
        Classes="player-chrome"
        Command="{Binding ClosePlayerCommand}"
        Content="&#xE8BB;"
        automation:AutomationProperties.Name="{DynamicResource MiniPlayerClose}" />
  </WrapPanel>
</UserControl>

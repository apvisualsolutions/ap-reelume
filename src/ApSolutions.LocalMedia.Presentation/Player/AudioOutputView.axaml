<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.AudioOutputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:AudioOutputViewModel"
    automation:AutomationProperties.Name="{DynamicResource AudioOutputAccessibleName}">
  <StackPanel x:Name="AudioOutputSurface" Spacing="{DynamicResource Space12}">
    <StackPanel Spacing="{DynamicResource Space4}">
      <!--
        The heading is its own resource rather than the label put through a converter, and the reason
        is what AXAML does not have: no text-transform, and no way to compose a DynamicResource with
        one — the strings are dynamic because they follow the language. A converter would have needed
        a markup extension of its own to reach them.
        The cost of a second string is that the two could drift apart, so they do not get to: a test
        asserts each heading IS its label uppercased, in both languages.
      -->
      <TextBlock Classes="section-overline" Text="{DynamicResource AudioOutputDeviceHeading}" />
      <ComboBox
          x:Name="AudioDeviceSelector"
          MinWidth="280"
          automation:AutomationProperties.Name="{DynamicResource AudioOutputDeviceLabel}"
          DisplayMemberBinding="{Binding Display}"
          ItemsSource="{Binding Devices}"
          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock Classes="section-overline" Text="{DynamicResource AudioOutputLayoutHeading}" />
      <!--
        Three buttons and not a drop-down, which is what the prototype draws: `chList` is a row of
        three, the one in force carrying the accent border and fill, and the ones the device will not
        take dimmed rather than removed. A drop-down also hid the whole question behind a click and
        showed the enumeration's own words — «Surround51» — in both languages.

        player-pill and not a class of its own: these are the same control the player's panel heads
        already are, paired with `pbtnAudio` at the design's own radius of 4, and the 44 px target
        that class carries is a decision already taken and measured rather than one to re-take here.

        The word and not the value as CommandParameter: `{x:True}` and its kin are not measured in
        this Avalonia, and a parameter arriving as the string "Surround71" leaves every button
        unpressed while looking exactly right.
      -->
      <StackPanel
          x:Name="AudioLayoutSelector"
          Orientation="Horizontal"
          Spacing="{DynamicResource Space4}"
          automation:AutomationProperties.Name="{DynamicResource AudioOutputLayoutLabel}">
        <Button
            x:Name="AudioLayoutStereo"
            Classes="player-pill"
            Classes.selected="{Binding IsStereoChosen}"
            Command="{Binding ChooseLayoutCommand}"
            CommandParameter="stereo"
            Content="{DynamicResource AudioOutputLayoutStereo}"
            IsEnabled="{Binding IsStereoAvailable}"
            automation:AutomationProperties.Name="{DynamicResource AudioOutputLayoutStereo}" />
        <Button
            x:Name="AudioLayoutSurround51"
            Classes="player-pill"
            Classes.selected="{Binding IsSurround51Chosen}"
            Command="{Binding ChooseLayoutCommand}"
            CommandParameter="surround51"
            Content="5.1"
            IsEnabled="{Binding IsSurround51Available}"
            automation:AutomationProperties.Name="5.1" />
        <Button
            x:Name="AudioLayoutSurround71"
            Classes="player-pill"
            Classes.selected="{Binding IsSurround71Chosen}"
            Command="{Binding ChooseLayoutCommand}"
            CommandParameter="surround71"
            Content="7.1"
            IsEnabled="{Binding IsSurround71Available}"
            automation:AutomationProperties.Name="7.1" />
      </StackPanel>

      <!--
        Said before the choice is made and not after it, which is the whole difference between an
        application that changes a system setting and one that changes it behind somebody's back.
        The layout is not a player setting: measured on 2026-09-02, LibVLC has no live API and no
        instance option that reduces channels, so what carries the choice is the endpoint's own
        format in Windows — and that reaches every program on the machine.
      -->
      <Border
          x:Name="LayoutSystemWideNotice"
          Padding="8,4"
          Background="{DynamicResource WarningSurfaceBrush}"
          BorderBrush="{DynamicResource WarningBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusSmall}"
          IsVisible="{Binding LayoutChangeIsSystemWide}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
          <TextBlock VerticalAlignment="Top" Text="⚠" />
          <TextBlock
              Grid.Column="1"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource AudioOutputLayoutSystemWide}"
              TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!--
        And where nothing can write it, the three choices are a readout. Saying so is what keeps this
        from being a control that appears to work: the row still shows what the device delivers.
      -->
      <TextBlock
          x:Name="LayoutReadOnlyNotice"
          Foreground="{DynamicResource TextSecondaryBrush}"
          FontSize="{DynamicResource FontSizeCaption}"
          IsVisible="{Binding !CanChangeLayout}"
          Text="{DynamicResource AudioOutputLayoutReadOnly}"
          TextWrapping="Wrap" />
    </StackPanel>

    <!--
      The three of them are warnings and not information, which is the distinction §4 draws here: what
      is coming out of the speakers is not what was asked for. No device at all, a layout the hardware
      would not take, a device that went away mid-session — none is a failure, because sound is still
      playing or about to; and none is a fact either, because each one means somebody's choice was not
      honoured. They read the same way as the unavailable badge, on purpose.
    -->
    <Border
        x:Name="NoOutputNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding HasNoOutput}">
      <!--
        A Grid and not a horizontal StackPanel: a StackPanel offers its children infinite width,
        so a wrapping TextBlock beside a glyph never wraps and runs off the side. The overflow
        gate measured exactly that here — a TextBlock ending at x=921 in a 900 px window.
      -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputNoneAvailable}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!--
      A note and not a warning, and that is a decision that changed on 2026-09-02. The three notices
      were warnings together on the ground that «each one means somebody's choice was not honoured»,
      and this one is the exception the prototype draws differently: `downmix` is small grey text
      under the buttons — `font-size:11px; opacity:.72` — rather than a bordered box.
      «El prototipo manda», said the owner when asked which of the two to keep.
      <b>The other two stay warnings</b>: no output at all and a device that went away are the ones
      the prototype does not draw as notes either.
    -->
    <TextBlock
        x:Name="DegradedLayoutNotice"
        FontSize="{DynamicResource FontSizeFootnote}"
        Foreground="{DynamicResource TextSecondaryBrush}"
        IsVisible="{Binding LayoutWasDegraded}"
        Text="{DynamicResource AudioOutputLayoutDegraded}"
        TextWrapping="Wrap" />

    <Border
        x:Name="LayoutAppliedNotice"
        Padding="8,4"
        Background="{DynamicResource PositiveSurfaceBrush}"
        BorderBrush="{DynamicResource PositiveBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding LayoutWasApplied}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="✓" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputLayoutApplied}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border
        x:Name="LayoutRefusedNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding LayoutWasRefused}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputLayoutRefused}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border
        x:Name="DeviceFallbackNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding FellBackToDefaultDevice}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputDeviceFallback}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.AudioOutputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:AudioOutputViewModel"
    automation:AutomationProperties.Name="{DynamicResource AudioOutputAccessibleName}">
  <StackPanel x:Name="AudioOutputSurface" Spacing="{DynamicResource Space12}">
    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource AudioOutputDeviceLabel}" />
      <ComboBox
          x:Name="AudioDeviceSelector"
          MinWidth="280"
          automation:AutomationProperties.Name="{DynamicResource AudioOutputDeviceLabel}"
          DisplayMemberBinding="{Binding Display}"
          ItemsSource="{Binding Devices}"
          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource AudioOutputLayoutLabel}" />
      <ComboBox
          x:Name="AudioLayoutSelector"
          MinWidth="200"
          automation:AutomationProperties.Name="{DynamicResource AudioOutputLayoutLabel}"
          ItemsSource="{x:Static player:AudioOutputViewModel.Layouts}"
          SelectedItem="{Binding SelectedLayout, Mode=TwoWay}" />
    </StackPanel>

    <!--
      The three of them are warnings and not information, which is the distinction §4 draws here: what
      is coming out of the speakers is not what was asked for. No device at all, a layout the hardware
      would not take, a device that went away mid-session — none is a failure, because sound is still
      playing or about to; and none is a fact either, because each one means somebody's choice was not
      honoured. They read the same way as the unavailable badge, on purpose.
    -->
    <Border
        x:Name="NoOutputNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding HasNoOutput}">
      <!--
        A Grid and not a horizontal StackPanel: a StackPanel offers its children infinite width,
        so a wrapping TextBlock beside a glyph never wraps and runs off the side. The overflow
        gate measured exactly that here — a TextBlock ending at x=921 in a 900 px window.
      -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputNoneAvailable}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border
        x:Name="DegradedLayoutNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding LayoutWasDegraded}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputLayoutDegraded}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border
        x:Name="DeviceFallbackNotice"
        Padding="8,4"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusSmall}"
        IsVisible="{Binding FellBackToDefaultDevice}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
        <TextBlock VerticalAlignment="Top" Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource AudioOutputDeviceFallback}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

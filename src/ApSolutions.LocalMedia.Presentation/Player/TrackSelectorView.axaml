<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.TrackSelectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:TrackSelectorViewModel"
    automation:AutomationProperties.Name="{DynamicResource TrackSelectorAccessibleName}">
  <StackPanel x:Name="TrackSelectorSurface" Spacing="{DynamicResource Space12}">
    <!--
      Said above the two pickers rather than instead of them: the pickers stay, because the one track
      each of them holds is still what is playing and a person may want to read which one it is. What
      is missing is the choice, not the information.
    -->
    <StackPanel
        VerticalAlignment="Top"
        IsVisible="{Binding HasNothingToChoose}"
        Spacing="{DynamicResource Space4}">
      <TextBlock FontWeight="SemiBold" Text="{DynamicResource TracksEmptyTitle}" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource PlayerTextSecondaryBrush}"
          Text="{DynamicResource TracksEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel
        IsVisible="{Binding $parent[player:TrackSelectorView].ShowsAudio}"
        Spacing="{DynamicResource Space4}">
      <TextBlock
          Foreground="{DynamicResource PlayerTextBrush}"
          Text="{DynamicResource TrackSelectorAudioLabel}" />
      <!--
        A list of radios and not a drop-down, which is what the prototype draws: the tracks of a file
        are three or four, they fit, and a drop-down charges a click to learn what the other choices
        even are. The row keeps the ellipsis and the tooltip it had — a track's name comes out of the
        file and nobody can shorten it.

        The accessible name is the list's own key on every row, with the track's name in HelpText,
        and that is the shape PersonalActionsView's rating buttons already have. Two reasons, and the
        second is the one that is easy to miss: the walk's inventory reads the anchor out of the
        markup, so N rows declared once are one identity — and if that identity were {Binding
        Display} it would be the SAME identity as the subtitle list's, because both are declared in
        this one file. Pressing an audio row would then mark the subtitle row covered, and the gate
        would stay green over a control nobody had ever clicked.
      -->
      <ItemsControl x:Name="AudioTrackSelector" ItemsSource="{Binding AudioTracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="player:TrackOption">
            <Border Classes="option-row" Classes.selected="{Binding IsSelected}">
              <RadioButton
                  Classes="option"
                  Command="{Binding $parent[ItemsControl].((player:TrackSelectorViewModel)DataContext).ChooseAudioCommand}"
                  CommandParameter="{Binding}"
                  GroupName="AudioTrack"
                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                  automation:AutomationProperties.Name="{DynamicResource TrackSelectorAudioLabel}"
                  automation:AutomationProperties.HelpText="{Binding Display}">
                <TextBlock
                    Classes="row-label"
                    Text="{Binding Display}"
                    ToolTip.Tip="{Binding Display}" />
              </RadioButton>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel
        IsVisible="{Binding $parent[player:TrackSelectorView].ShowsSubtitles}"
        Spacing="{DynamicResource Space4}">
      <TextBlock
          Foreground="{DynamicResource PlayerTextBrush}"
          Text="{DynamicResource TrackSelectorSubtitleLabel}" />
      <!--
        The same list one panel over, and its own GroupName: two radio groups in one view that
        shared a name would be one group, so choosing a subtitle would put out the audio row.
      -->
      <ItemsControl x:Name="SubtitleTrackSelector" ItemsSource="{Binding SubtitleTracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="player:TrackOption">
            <Border Classes="option-row" Classes.selected="{Binding IsSelected}">
              <RadioButton
                  Classes="option"
                  Command="{Binding $parent[ItemsControl].((player:TrackSelectorViewModel)DataContext).ChooseSubtitleCommand}"
                  CommandParameter="{Binding}"
                  GroupName="SubtitleTrack"
                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                  automation:AutomationProperties.Name="{DynamicResource TrackSelectorSubtitleLabel}"
                  automation:AutomationProperties.HelpText="{Binding Display}">
                <TextBlock
                    Classes="row-label"
                    Text="{Binding Display}"
                    ToolTip.Tip="{Binding Display}" />
              </RadioButton>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!--
      The label wraps, and that is the whole fix: a CheckBox measures its content with infinite width
      and draws it where it falls, so «Recordar para toda la serie» ran past the right edge of a
      320 px column — the word and its dotted disabled outline both cut off. A TextBlock that wraps
      inside the content is what gives the check box a width to work with.
    -->
    <!--
      Under the audio half and not under both, because there is one setting and it governs the pair:
      choosing to remember applies to whichever track was picked, audio or subtitle. Drawn twice it
      would be two check boxes writing one value, and the second would look like a second decision.
    -->
    <CheckBox
        x:Name="RememberForSeriesToggle"
        IsVisible="{Binding $parent[player:TrackSelectorView].ShowsAudio}"
        IsEnabled="{Binding CanRememberForSeries}"
        IsChecked="{Binding RememberForSeries, Mode=TwoWay}"
        automation:AutomationProperties.Name="{DynamicResource TrackSelectorRememberForSeries}">
      <TextBlock
          Text="{DynamicResource TrackSelectorRememberForSeries}"
          TextWrapping="Wrap" />
    </CheckBox>
  </StackPanel>
</UserControl>

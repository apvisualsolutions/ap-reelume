<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.ShortcutSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:ShortcutSettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource ShortcutSettingsAccessibleName}">
  <!-- §4's skeleton for a settings section: the padded surface and the 620 reading column that every
       section on this page shares. Without it this one started 158 px to the left of the others. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
  <StackPanel x:Name="ShortcutSettingsSurface" MaxWidth="620" Spacing="{DynamicResource Space12}">
    <!--
      UX-010: the button that puts this group back sits inside the group, and in its heading row for
      the reason PictureAdjustmentView already carries — under a list that grows, it would be pushed
      past the first viewport, and the walk's hit testing does not follow a scrolled panel.
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource ShortcutSettingsAccessibleName}"
          automation:AutomationProperties.HeadingLevel="2" />
      <!--
        Always offered, where the picture group offers its own only while something is away from
        neutral. The difference is not a preference: nothing in this application rebinds a shortcut
        yet — the model's TryRebind reaches no view — so a button that appeared only once something
        was customised could never be pressed at all, and an unpressable control raises the walk's
        ratchet, which only comes down.
      -->
      <Button
          x:Name="RestoreDefaultsButton"
          Grid.Column="1"
          VerticalAlignment="Center"
          automation:AutomationProperties.Name="{DynamicResource RestoreDefaultsAction}"
          Command="{Binding RestoreDefaultsCommand}"
          Content="{DynamicResource RestoreDefaultsAction}" />
    </Grid>
    <TextBlock
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource ShortcutSettingsDescription}"
        TextWrapping="Wrap" />

    <!--
      Nothing bound is not the application ignoring the keyboard, which is what a blank panel would
      suggest: the system's own media keys keep working either way, and that is the half worth saying.
    -->
    <StackPanel
        VerticalAlignment="Top"
        IsVisible="{Binding IsEmpty}"
        Spacing="{DynamicResource Space4}">
      <TextBlock FontWeight="SemiBold" Text="{DynamicResource ShortcutsEmptyTitle}" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource ShortcutsEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <ItemsControl
        x:Name="ShortcutList"
        IsVisible="{Binding !IsEmpty}"
        ItemsSource="{Binding Bindings}"
        automation:AutomationProperties.Name="{DynamicResource ShortcutSettingsListName}">
      <!--
        The rows are cards now, like every other setting on this page, and the gap between them comes
        from the panel rather than from a margin on each row: an ItemsControl has no Spacing of its
        own, so the one place that decides how far apart these sit is its ItemsPanel.
      -->
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="{DynamicResource Space8}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="player:ShortcutRow">
          <Border Classes="row-box">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space12}">
              <TextBlock
                  Classes="setting-name"
                  VerticalAlignment="Center"
                  Text="{Binding CommandLabel}" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding GestureLabel}" />
              <TextBlock
                  Grid.Column="2"
                  Classes="setting-state"
                  IsVisible="{Binding IsCustomised}"
                  Text="{DynamicResource ShortcutSettingsCustomised}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock
        x:Name="ConflictNotice"
        IsVisible="{Binding HasConflict}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{Binding ConflictMessage}"
        TextWrapping="Wrap" />
  </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.DetectedMarkerReviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    xmlns:continuity="clr-namespace:ApSolutions.LocalMedia.Domain.Continuity;assembly=ApSolutions.LocalMedia.Domain"
    x:DataType="player:DetectedMarkerReviewViewModel"
    automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewAccessibleName}">
  <UserControl.Resources>
    <player:MarkerRowLabelConverter x:Key="DetectionRowLabel" />
  </UserControl.Resources>
  <StackPanel x:Name="DetectedMarkerReviewSurface" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontWeight="SemiBold"
        Text="{DynamicResource DetectedMarkerReviewTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource DetectedMarkerReviewDescription}"
        TextWrapping="Wrap" />
    <StackPanel
        VerticalAlignment="Top"
        IsVisible="{Binding IsEmpty}"
        Spacing="{DynamicResource Space4}">
      <TextBlock FontWeight="SemiBold" Text="{DynamicResource DetectedMarkersEmptyTitle}" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource DetectedMarkersEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <!--
    The row says whether somebody confirmed this detection, which is the one thing on it that a person
    set and the thing that decides whether the next detector run may touch the range. Nothing painted
    it until 2026-08-21, so pressing accept changed the model and left the list looking identical.

    Confidence stays off the row on purpose: it is the detector arguing with itself, and a percentage
    invites arguing back about a number nobody can act on.
    -->
    <ListBox
        x:Name="DetectedMarkerList"
        Classes="side-list"
        IsVisible="{Binding !IsEmpty}"
        MinHeight="72"
        ItemsSource="{Binding Detections}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected, Mode=TwoWay}"
        automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewListName}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="continuity:DetectedMarker">
          <TextBlock
              Classes="row-label"
              Text="{Binding ., Converter={StaticResource DetectionRowLabel}}"
              ToolTip.Tip="{Binding ., Converter={StaticResource DetectionRowLabel}}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!--
    WrapPanels for the reason the marker editor's are: a horizontal StackPanel offers its children
    infinite width, and this surface shares the player's 320 px column, where three buttons and two
    spinners never fit on one line. Measured as a press landing at x=1611 in a 1600 px window.
    -->
    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <NumericUpDown
          x:Name="DetectedStartSelector"
          Minimum="0"
          Value="{Binding StartSeconds, Mode=TwoWay}"
          automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewStartLabel}" />
      <NumericUpDown
          x:Name="DetectedEndSelector"
          Minimum="0"
          Value="{Binding EndSeconds, Mode=TwoWay}"
          automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewEndLabel}" />
    </WrapPanel>

    <TextBlock
        x:Name="DetectedRangeErrorText"
        IsVisible="{Binding HasRangeError}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource DetectedMarkerReviewRangeError}"
        TextWrapping="Wrap" />

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          x:Name="AcceptDetectionButton"
          Command="{Binding AcceptCommand}"
          Content="{DynamicResource DetectedMarkerReviewAccept}"
          automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewAccept}" />
      <Button
          x:Name="CorrectDetectionButton"
          Command="{Binding CorrectCommand}"
          Content="{DynamicResource DetectedMarkerReviewCorrect}"
          automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewCorrect}" />
      <Button
          x:Name="DeleteDetectionButton"
          Command="{Binding DeleteCommand}"
          Content="{DynamicResource DetectedMarkerReviewDelete}"
          automation:AutomationProperties.Name="{DynamicResource DetectedMarkerReviewDelete}" />
    </WrapPanel>
  </StackPanel>
</UserControl>

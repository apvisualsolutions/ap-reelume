<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.LooseFileBanner"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:LooseFileViewModel"
    IsVisible="{Binding IsLooseSession}"
    automation:AutomationProperties.Name="{DynamicResource LooseFileAccessibleName}"
    automation:AutomationProperties.LiveSetting="Polite">
  <!--
    A band across the top of the player column, which is where §4 puts it and where it stopped being an
    overlay on 2026-08-21. Two guards left with that move and one stayed.

    MaxHeight left because it was clipping: measured, this banner asks for 336 px at the mini player's
    480 and 318 at 900, so a 320 cap cut the confirmation off exactly where a narrow window needed it.
    It was there to stop the control stretching to a 1280x1400 stage - the defect of 2026-08-17 - and
    the Auto row it lives in now bounds the height by what the content asks for instead.

    MaxWidth left because a band is the width of what it sits above; the explanation keeps a MaxWidth
    of its own so a wide window does not turn it into one long line.

    VerticalAlignment stayed. It is the guard that still does something: mounted on its own - which is
    what the overflow gate does - Stretch would take the whole window's height back.
  -->
  <Border
      x:Name="LooseFileSurface"
      VerticalAlignment="Top"
      Margin="16"
      Padding="16"
      Background="{DynamicResource CardSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
    <StackPanel Spacing="{DynamicResource Space8}">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LooseFileHeading}" />
      <TextBlock
          x:Name="LooseFileName"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding DisplayName}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          MaxWidth="640"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LooseFileDescription}"
          TextWrapping="Wrap" />

      <!-- The action to the right, which is what §4 asks of a band: the reading runs left to right and
           ends where the thing to press is. Still a WrapPanel, for the reason every row here is one. -->
      <WrapPanel
          HorizontalAlignment="Right"
          ItemSpacing="{DynamicResource Space8}"
          LineSpacing="{DynamicResource Space8}">
        <Button
            Classes="primary-action"
            x:Name="AddContainingFolderButton"
            Command="{Binding AddFolderCommand}"
            Content="{DynamicResource LooseFileAddFolderAction}"
            IsVisible="{Binding !IsAddFolderConfirmationPending}"
            automation:AutomationProperties.Name="{DynamicResource LooseFileAddFolderAction}" />
      </WrapPanel>

      <Border
          x:Name="AddFolderConfirmationSurface"
          Padding="12"
          Background="{DynamicResource AccentSubtleBrush}"
          BorderBrush="{DynamicResource ShellBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusMedium}"
          IsVisible="{Binding IsAddFolderConfirmationPending}"
          automation:AutomationProperties.Name="{DynamicResource LooseFileConfirmAccessibleName}"
          automation:AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="{DynamicResource Space8}">
          <TextBlock
              MaxWidth="600"
              Text="{DynamicResource LooseFileConfirmDescription}"
              TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
            <Button
                x:Name="ConfirmAddFolderButton"
                Command="{Binding ConfirmAddFolderCommand}"
                Content="{DynamicResource LooseFileConfirmAction}"
                automation:AutomationProperties.Name="{DynamicResource LooseFileConfirmAction}" />
            <Button
                x:Name="CancelAddFolderButton"
                Command="{Binding CancelAddFolderCommand}"
                Content="{DynamicResource LooseFileCancelAction}"
                automation:AutomationProperties.Name="{DynamicResource LooseFileCancelAction}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

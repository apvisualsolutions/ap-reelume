<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.LooseFileBanner"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:LooseFileViewModel"
    IsVisible="{Binding IsLooseSession}"
    automation:AutomationProperties.Name="{DynamicResource LooseFileAccessibleName}"
    automation:AutomationProperties.LiveSetting="Polite">
  <!--
    A notice, and it has to be sized to itself. Without the alignments it stretches to whatever
    contains it, and in the shell that is the whole player stage: measured on 2026-08-17 at 1280x1400
    over a 1280x1400 stage. It carries a background, so unlike the resume prompt it also swallowed
    every click meant for the picture behind it. Both dimensions are bounded and not just declared:
    a MaxWidth alone leaves the height stretching, which is the half of this defect that keeps coming
    back. It sits at the top because it describes where the session came from, not what it is doing.
  -->
  <Border
      x:Name="LooseFileSurface"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Margin="16"
      MaxWidth="720"
      MaxHeight="320"
      Padding="16"
      Background="{DynamicResource CardSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
    <StackPanel Spacing="{DynamicResource Space8}">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LooseFileHeading}" />
      <TextBlock
          x:Name="LooseFileName"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{Binding DisplayName}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          MaxWidth="640"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LooseFileDescription}"
          TextWrapping="Wrap" />

      <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
        <Button
            x:Name="AddContainingFolderButton"
            Command="{Binding AddFolderCommand}"
            Content="{DynamicResource LooseFileAddFolderAction}"
            IsVisible="{Binding !IsAddFolderConfirmationPending}"
            automation:AutomationProperties.Name="{DynamicResource LooseFileAddFolderAction}" />
      </WrapPanel>

      <Border
          x:Name="AddFolderConfirmationSurface"
          Padding="12"
          Background="{DynamicResource AccentSubtleBrush}"
          BorderBrush="{DynamicResource ShellBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusMedium}"
          IsVisible="{Binding IsAddFolderConfirmationPending}"
          automation:AutomationProperties.Name="{DynamicResource LooseFileConfirmAccessibleName}"
          automation:AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="{DynamicResource Space8}">
          <TextBlock
              MaxWidth="600"
              Text="{DynamicResource LooseFileConfirmDescription}"
              TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
            <Button
                x:Name="ConfirmAddFolderButton"
                Command="{Binding ConfirmAddFolderCommand}"
                Content="{DynamicResource LooseFileConfirmAction}"
                automation:AutomationProperties.Name="{DynamicResource LooseFileConfirmAction}" />
            <Button
                x:Name="CancelAddFolderButton"
                Command="{Binding CancelAddFolderCommand}"
                Content="{DynamicResource LooseFileCancelAction}"
                automation:AutomationProperties.Name="{DynamicResource LooseFileCancelAction}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:PlayerViewModel"
    automation:AutomationProperties.Name="{DynamicResource PlayerAccessibleName}">
  <!--
    The player has a surface of its own and it is the same in all four themes: what sits on it is
    the picture, so the theme does not get a say. It is #0B0D10 and not pure black, which keeps the
    letterbox from reading as a hole in the screen beside a frame that is never quite black.
  -->
  <Panel Background="{DynamicResource PlayerSurfaceBrush}">
    <player:VideoFrameView
        x:Name="VideoSurface"
        FrameSource="{Binding FrameSource}"
        automation:AutomationProperties.Name="{DynamicResource PlayerVideoSurfaceName}" />
    <!--
      A session that will not open is a failure and says so with its own surface, not with the one the
      shell paints everything else on. The glyph is ✕ and not the ⚠ the unavailable badge carries: a
      failure and a notice that shared a glyph would differ only in colour, which is the one thing this
      grammar exists to avoid.
    -->
    <Border
        x:Name="PlayerFailureSurface"
        IsVisible="{Binding HasFailed}"
        Margin="24"
        Padding="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource DangerSurfaceBrush}"
        BorderBrush="{DynamicResource DangerBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}">
      <StackPanel Spacing="{DynamicResource Space8}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
          <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="✕" />
          <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStateFailed}" />
        </StackPanel>
        <TextBlock
            IsVisible="{Binding FileWasNotFound}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureFileNotFound}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding OpenFailed}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureOpenFailed}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding EngineWasUnavailable}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureEngineUnavailable}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding CodecIsUnsupported}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureUnsupportedCodec}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding MediaWasCorrupted}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureCorruptedMedia}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding HasNoPlayableTrack}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureNoPlayableTrack}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding CanChooseAnotherVersion}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerRecoveryChooseAnotherVersion}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding ExternalLaunchFailed}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerRecoveryExternalFailed}"
            TextWrapping="Wrap" />
        <WrapPanel
            x:Name="RecoveryActionsSurface"
            ItemSpacing="{DynamicResource Space8}"
            LineSpacing="{DynamicResource Space8}">
          <!--
            The one action of the one screen here that is for an action. Opening the file elsewhere
            sits beside it as the secondary, and the transport gets none at all.
          -->
          <Button
              Classes="primary-action"
              IsVisible="{Binding CanRetry}"
              automation:AutomationProperties.Name="{DynamicResource PlayerRecoveryRetry}"
              Command="{Binding RetryCommand}"
              Content="{DynamicResource PlayerRecoveryRetry}" />
          <Button
              IsVisible="{Binding CanOpenExternally}"
              automation:AutomationProperties.Name="{DynamicResource PlayerRecoveryOpenExternally}"
              Command="{Binding OpenExternallyCommand}"
              Content="{DynamicResource PlayerRecoveryOpenExternally}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border
        x:Name="AudioAbsenceNotice"
        IsVisible="{Binding HasNoAudioTrack}"
        Margin="16"
        Padding="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource ShellSurfaceBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        Opacity="0.92">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource PlayerNoticeNoAudioTrack}"
          TextWrapping="Wrap" />
    </Border>
    <!--
      The transport is a band across the foot, which is what the prototype draws and what this was
      not: a floating card with a 16 px margin on all four sides, so the picture showed through
      underneath it on the left and the right. A band has one edge - the hairline along its top - and
      the picture stops there.

      Its surface is the player's own and not the shell's. Everything else in the application sits on
      a themed background; this sits beside a frame, and a light-themed strip under a dark picture is
      the seam the whole player surface exists to avoid.
    -->
    <Border
        x:Name="TransportControlsSurface"
        Padding="20,14,20,16"
        VerticalAlignment="Bottom"
        Background="{DynamicResource PlayerChromeBrush}"
        BorderBrush="{DynamicResource PlayerHairlineBrush}"
        BorderThickness="0,1,0,0"
        Opacity="{Binding ControlsOpacity}"
        automation:AutomationProperties.Name="{DynamicResource PlayerTransportName}">
      <StackPanel Spacing="{DynamicResource Space8}">
        <!--
          The scrubber and the two clocks come first and take the whole width, which is the row this
          application never had. It is declared here rather than beside the buttons because a bar
          that shares a line with them is a bar as wide as whatever they left over.
        -->
        <ContentControl
            x:Name="TransportControlsHost"
            IsVisible="{Binding Transport, Converter={x:Static ObjectConverters.IsNotNull}}"
            Content="{Binding Transport}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="player:TransportControlsViewModel">
              <player:TransportControlsView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <!--
          No primary action here, and that is a decision rather than an omission: Play and Pause
          alternate by state, so marking either would make the screen change what it is for depending
          on what is happening, and Stop is the point of nothing.

          The three wear player-chrome for its 44 px target area, which is a real accessibility gain
          and not a layout one. The separation is this panel's spacing, which is why the class no
          longer carries a margin of its own.

          A WrapPanel and not a horizontal StackPanel, which is what this was: measured on 2026-08-20,
          the row ended 74px past the right edge of a 900-wide window, and 900 is the minimum the
          application allows. It is the seventh time this exact shape has drawn a control outside the
          window here, and the fix is the same one the other six got.

          The prototype puts these three between the skips - back, play, forward - and here they come
          after them. That is measured rather than left: Pause, Resume and Stop are the session
          coordinator's and the skips are ControlPlayback's, and the two models are built at
          different moments, so interleaving them means moving commands between them rather than
          moving buttons in a panel.
        -->
        <WrapPanel
            x:Name="SessionActionsSurface"
            ItemSpacing="{DynamicResource Space8}"
            LineSpacing="{DynamicResource Space8}">
          <Button
              Classes="player-chrome"
              IsVisible="{Binding CanResume}"
              automation:AutomationProperties.Name="{DynamicResource PlayerPlayAction}"
              Command="{Binding ResumeCommand}"
              Content="&#xE768;" />
          <Button
              Classes="player-chrome"
              IsVisible="{Binding CanPause}"
              automation:AutomationProperties.Name="{DynamicResource PlayerPauseAction}"
              Command="{Binding PauseCommand}"
              Content="&#xE769;" />
          <Button
              Classes="player-chrome"
              automation:AutomationProperties.Name="{DynamicResource PlayerStopAction}"
              Command="{Binding StopCommand}"
              Content="&#xE71A;" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsIdle}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStateIdle}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsOpening}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStateOpening}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsPlaying}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStatePlaying}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsPaused}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStatePaused}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsStopped}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStateStopped}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

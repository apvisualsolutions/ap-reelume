<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:PlayerViewModel"
    automation:AutomationProperties.Name="{DynamicResource PlayerAccessibleName}">
  <!--
    The player has a surface of its own and it is the same in all four themes: what sits on it is
    the picture, so the theme does not get a say. It is #0B0D10 and not pure black, which keeps the
    letterbox from reading as a hole in the screen beside a frame that is never quite black.
  -->
  <Panel Background="{DynamicResource PlayerSurfaceBrush}">
    <player:VideoFrameView
        x:Name="VideoSurface"
        FrameSource="{Binding FrameSource}"
        automation:AutomationProperties.Name="{DynamicResource PlayerVideoSurfaceName}" />
    <!--
      A session that will not open is a failure and says so with its own surface, not with the one the
      shell paints everything else on. The glyph is ✕ and not the ⚠ the unavailable badge carries: a
      failure and a notice that shared a glyph would differ only in colour, which is the one thing this
      grammar exists to avoid.
    -->
    <Border
        x:Name="PlayerFailureSurface"
        IsVisible="{Binding HasFailed}"
        Margin="24"
        Padding="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource DangerSurfaceBrush}"
        BorderBrush="{DynamicResource DangerBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}">
      <StackPanel Spacing="{DynamicResource Space8}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
          <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="✕" />
          <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource PlayerStateFailed}" />
        </StackPanel>
        <TextBlock
            IsVisible="{Binding FileWasNotFound}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureFileNotFound}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding OpenFailed}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureOpenFailed}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding EngineWasUnavailable}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureEngineUnavailable}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding CodecIsUnsupported}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureUnsupportedCodec}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding MediaWasCorrupted}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureCorruptedMedia}"
            TextWrapping="Wrap" />
        <TextBlock
            IsVisible="{Binding HasNoPlayableTrack}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerFailureNoPlayableTrack}"
            TextWrapping="Wrap" />
        <!--
          A button now, which is the control inventory's one change of type: the same key that used
          to only inform opens the choice itself. The flyout holds the very rows the side column
          lists, so choosing here IS the switch — one surface, two doors, no second grammar.
        -->
        <!--
          The sentence wraps inside the button on purpose: the key is a consequence phrase, and a
          Button's default presenter holds its line - measured 2026-08-23 as a full-width pill
          standing on the detail text above it.
        -->
        <Button
            HorizontalAlignment="Left"
            IsVisible="{Binding CanChooseAnotherVersion}"
            automation:AutomationProperties.Name="{DynamicResource PlayerRecoveryChooseAnotherVersion}">
          <TextBlock
              MaxWidth="520"
              Text="{DynamicResource PlayerRecoveryChooseAnotherVersion}"
              TextWrapping="Wrap" />
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <Border
                  MaxWidth="420"
                  MaxHeight="360"
                  Background="{DynamicResource PlayerPanelBrush}"
                  Padding="12">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <player:PlayerVersionsView DataContext="{Binding Versions}" />
                </ScrollViewer>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock
            IsVisible="{Binding ExternalLaunchFailed}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource PlayerRecoveryExternalFailed}"
            TextWrapping="Wrap" />
        <WrapPanel
            x:Name="RecoveryActionsSurface"
            ItemSpacing="{DynamicResource Space8}"
            LineSpacing="{DynamicResource Space8}">
          <!--
            The one action of the one screen here that is for an action. Opening the file elsewhere
            sits beside it as the secondary, and the transport gets none at all.
          -->
          <!--
            Retry appears only where trying again could answer differently: a missing file may be a
            disk somebody plugs back in, but bytes that failed to decode are still the same bytes,
            and an engine that never initialised will not initialise for being asked twice - so
            those states offer the other exits instead. And "no audio track" is a notice rather
            than a failure on this surface: the picture is playing, which is what a player is for.
          -->
          <Button
              Classes="primary-action"
              IsVisible="{Binding CanRetry}"
              automation:AutomationProperties.Name="{DynamicResource PlayerRecoveryRetry}"
              Command="{Binding RetryCommand}"
              Content="{DynamicResource PlayerRecoveryRetry}" />
          <Button
              IsVisible="{Binding CanOpenExternally}"
              automation:AutomationProperties.Name="{DynamicResource PlayerRecoveryOpenExternally}"
              Command="{Binding OpenExternallyCommand}">
            <!--
              The arrow the prototype puts on anything that leaves this process, which is exactly
              what this does: the file opens in whatever Windows has associated, and this application
              stops being responsible for it.
            -->
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
              <Path Classes="icon size-14" Data="{DynamicResource IconExternal}" />
              <TextBlock Text="{DynamicResource PlayerRecoveryOpenExternally}" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border
        x:Name="AudioAbsenceNotice"
        IsVisible="{Binding HasNoAudioTrack}"
        Margin="16"
        Padding="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource ShellSurfaceBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        Opacity="0.92">
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource PlayerNoticeNoAudioTrack}"
          TextWrapping="Wrap" />
    </Border>
    <!--
      The transport is a band across the foot, which is what the prototype draws and what this was
      not: a floating card with a 16 px margin on all four sides, so the picture showed through
      underneath it on the left and the right. A band has one edge - the hairline along its top - and
      the picture stops there.

      Its surface is the player's own and not the shell's. Everything else in the application sits on
      a themed background; this sits beside a frame, and a light-themed strip under a dark picture is
      the seam the whole player surface exists to avoid.
    -->
    <!--
      IsVisible and not Opacity, and the difference matters: hiding the chrome while a film plays is
      a fade, so the bar stays in the focus and automation trees and a keyboard never loses it. This
      is the other thing — the picture is in the small window, which draws five buttons of its own,
      and a bar that only went transparent there would still be 120 px of nothing between them and
      the picture.
    -->
    <Border
        x:Name="TransportControlsSurface"
        Padding="20,14,20,16"
        VerticalAlignment="Bottom"
        Background="{DynamicResource PlayerChromeBrush}"
        TextElement.Foreground="{DynamicResource PlayerTextBrush}"
        BorderBrush="{DynamicResource PlayerHairlineBrush}"
        BorderThickness="0,1,0,0"
        IsVisible="{Binding HasFullTransport}"
        Opacity="{Binding ControlsOpacity}"
        automation:AutomationProperties.Name="{DynamicResource PlayerTransportName}">
      <StackPanel Spacing="{DynamicResource Space8}">
        <!--
          The gear's panel, and it is the FIRST child of the band rather than a sibling floating over
          the picture: a panel bottom-aligned in the root Panel lands on top of the bar's own right
          hand — measured against the 380 px it asks for — and covers the very buttons somebody needs
          to close it. Inside the band it makes the band taller while it is open and gives the height
          back when it is not, which is what the shape it copies does.

          It travels with the band into the small window and stands down with it there, and the
          player's model shuts the gear on the way, so nothing is left open with no button to close it.

          Host and not Surface: until 2026-09-13 this Border and the StackPanel inside
          PlayerSettingsMenuView both answered to PlayerSettingsSurface, and with the gear open both
          were visible, one inside the other. Nothing resolved that name across the tree yet, but
          Single(control => control.Name == ...) is how this tree reaches a control and it throws on
          two matches — a defect waiting for whoever wrote the next test.
        -->
        <Border
            x:Name="PlayerSettingsHostSurface"
            Classes="player-overlay"
            Width="380"
            HorizontalAlignment="Right"
            Margin="0,0,0,8"
            TextElement.Foreground="{DynamicResource PlayerTextBrush}"
            IsVisible="{Binding Settings.IsOpen, FallbackValue=False}">
          <!--
            Capped and scrolling since 2026-09-13, when the gear grew from one group to three. A
            band that grows with whatever is inside it has no ceiling, and the picture is what pays
            for the height: mounted with every branch drawn at once the menu measured 1.126 px, which
            is taller than the shortest window this application allows.

            360 px is what one group needs with room to spare — the tallest is the countdown, at a
            switch, a slider and their labels — so the scroller does nothing in an ordinary window
            and catches the case where the window itself is short. That matters for the walk: its
            hit testing does not follow a scrolled panel, so a cap that bit in the normal case would
            put controls out of reach and raise a ratchet that only comes down.
          -->
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="PlayerSettingsHost" Content="{Binding Settings}">
              <ContentControl.ContentTemplate>
                <DataTemplate DataType="player:PlayerSettingsMenuViewModel">
                  <player:PlayerSettingsMenuView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </ScrollViewer>
        </Border>
        <!--
          The scrubber and the two clocks come first and take the whole width, which is the row this
          application never had. It is declared here rather than beside the buttons because a bar
          that shares a line with them is a bar as wide as whatever they left over.
        -->
        <ContentControl
            x:Name="TransportControlsHost"
            IsVisible="{Binding Transport, Converter={x:Static ObjectConverters.IsNotNull}}"
            Content="{Binding Transport}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="player:TransportControlsViewModel">
              <player:TransportControlsView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        <!--
          No primary action here, and that is a decision rather than an omission: Play and Pause
          alternate by state, so marking either would make the screen change what it is for depending
          on what is happening, and Stop is the point of nothing.

          The three wear player-chrome for its 44 px target area, which is a real accessibility gain
          and not a layout one. The separation is this panel's spacing, which is why the class no
          longer carries a margin of its own.

          A WrapPanel and not a horizontal StackPanel, which is what this was: measured on 2026-08-20,
          the row ended 74px past the right edge of a 900-wide window, and 900 is the minimum the
          application allows. It is the seventh time this exact shape has drawn a control outside the
          window here, and the fix is the same one the other six got.

          The prototype puts these three between the skips - back, play, forward - and here they come
          after them. That is measured rather than left: Pause, Resume and Stop are the session
          coordinator's and the skips are ControlPlayback's, and the two models are built at
          different moments, so interleaving them means moving commands between them rather than
          moving buttons in a panel.
        -->
        <!--
          A Grid so the endpoint can sit against the right edge, which is where the prototype writes
          it: the state and the key hints take the width they need and this takes what is left. In
          the prototype it shares the transport's own line, and here it cannot — that line already
          holds two sliders and two readouts, and at 900 px, the narrowest window this application
          allows, adding a device name to it is the shape that has drawn a control off the edge
          nine times.
        -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
        <WrapPanel
            x:Name="SessionActionsSurface"
            ItemSpacing="{DynamicResource Space8}"
            LineSpacing="{DynamicResource Space8}">
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsIdle}"
              Foreground="{DynamicResource PlayerTextBrush}"
              Text="{DynamicResource PlayerStateIdle}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsOpening}"
              Foreground="{DynamicResource PlayerTextBrush}"
              Text="{DynamicResource PlayerStateOpening}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsPlaying}"
              Foreground="{DynamicResource PlayerTextBrush}"
              Text="{DynamicResource PlayerStatePlaying}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsPaused}"
              Foreground="{DynamicResource PlayerTextBrush}"
              Text="{DynamicResource PlayerStatePaused}" />
          <TextBlock
              VerticalAlignment="Center"
              IsVisible="{Binding IsStopped}"
              Foreground="{DynamicResource PlayerTextBrush}"
              Text="{DynamicResource PlayerStateStopped}" />
          <!--
            The keyboard, said out loud. The prototype writes this line under its transport and this
            application has every one of these bound — Space, the arrows, F, N and Escape — with the
            gestures announced one control at a time and nowhere on screen. A person who never opens
            a screen reader learns them here or not at all.
          -->
          <TextBlock
              VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeCaption}"
              Foreground="{DynamicResource PlayerTextSecondaryBrush}"
              Text="{DynamicResource PlayerShortcutHint}"
              automation:AutomationProperties.AccessibilityView="Raw" />
        </WrapPanel>
        <!--
          Absent rather than empty while the catalogue has not answered: a pill with nothing in it
          reads as an endpoint whose name is blank, which is worse than saying nothing about one.
        -->
        <Border
            x:Name="OutputSummarySurface"
            Grid.Column="1"
            Padding="8,4"
            VerticalAlignment="Center"
            Background="{DynamicResource ControlFillBrush}"
            CornerRadius="{DynamicResource CornerRadiusSmall}"
            IsVisible="{Binding $parent[player:PlayerView].OutputSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock
              FontSize="{DynamicResource FontSizeCaption}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{Binding $parent[player:PlayerView].OutputSummary}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
        </Border>
        </Grid>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

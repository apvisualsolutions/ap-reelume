<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.MarkerEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    xmlns:continuity="clr-namespace:ApSolutions.LocalMedia.Domain.Continuity;assembly=ApSolutions.LocalMedia.Domain"
    x:DataType="player:MarkerEditorViewModel"
    automation:AutomationProperties.Name="{DynamicResource MarkerEditorAccessibleName}">
  <UserControl.Resources>
    <player:MarkerRowLabelConverter x:Key="MarkerRowLabel" />
  </UserControl.Resources>
  <StackPanel x:Name="MarkerEditorSurface" Spacing="{DynamicResource Space12}">
    <TextBlock
        x:Name="MarkerEditorHeadline"
        Foreground="{DynamicResource PlayerTextBrush}"
        Text="{DynamicResource MarkerEditorDescription}"
        TextWrapping="Wrap" />
    <!-- The consequence of an overlap, said before one is made rather than after. -->
    <TextBlock
        FontSize="{DynamicResource FontSizeCaption}"
        Foreground="{DynamicResource PlayerTextSecondaryBrush}"
        Text="{DynamicResource MarkerOverlapConsequence}"
        TextWrapping="Wrap" />
    <StackPanel
        VerticalAlignment="Top"
        IsVisible="{Binding IsEmpty}"
        Spacing="{DynamicResource Space4}">
      <TextBlock FontWeight="SemiBold" Text="{DynamicResource MarkersEmptyTitle}" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource PlayerTextSecondaryBrush}"
          Text="{DynamicResource MarkersEmptyDescription}"
          TextWrapping="Wrap" />
    </StackPanel>

    <!--
    The template is the whole point. Until 2026-08-21 there was none, so the row painted the record's
    generated ToString() - two GUIDs and a type name - clipped with no ellipsis and no tooltip. The
    row's height, its truncation and its 36 come from the side-list and row-label classes, where the
    four lists of this column share them.
    -->
    <ListBox
        x:Name="MarkerList"
        Classes="side-list"
        IsVisible="{Binding !IsEmpty}"
        MinHeight="96"
        ItemsSource="{Binding Markers}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding SelectedMarker, Mode=TwoWay}"
        automation:AutomationProperties.Name="{DynamicResource MarkerEditorListName}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="continuity:IntroMarker">
          <TextBlock
              Classes="row-label"
              Text="{Binding ., Converter={StaticResource MarkerRowLabel}}"
              ToolTip.Tip="{Binding ., Converter={StaticResource MarkerRowLabel}}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!--
    A WrapPanel and not a horizontal StackPanel, for the reason measured five times in this
    repository: a horizontal StackPanel offers its children infinite width and draws them where they
    fall, so the last one lands wherever the sum says — off the screen, with nothing to scroll. This
    surface lives in the player's 320 px column, where a kind selector and two spinners never fit on
    one line.
    -->
    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <!--
        The three kinds used to paint the enum member's own name - Intro, Recap, Credits - in whatever
        language the application was in, because no key existed for them. The converter that labels the
        rows labels these too, so the words in the picker and the words in the list are the same words.
      -->
      <ComboBox
          x:Name="MarkerKindSelector"
          Classes="side-list"
          MinWidth="160"
          ItemsSource="{x:Static player:MarkerEditorViewModel.Kinds}"
          SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
          automation:AutomationProperties.Name="{DynamicResource MarkerEditorKindLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="continuity:MarkerKind">
            <TextBlock
                Classes="row-label"
                Text="{Binding ., Converter={StaticResource MarkerRowLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <!--
        Each spinner carries its label over it, which is what the prototype draws: a small dimmed
        overline above the field rather than a name only a screen reader could hear. Until 2026-09-03
        the two numbers sat side by side with nothing saying which was which, and the only answer to
        «is this the start or the end?» was to tab into it and listen.

        The heading is its own string and the label keeps ordinary case, because the label is still
        the spinner's accessible name: shouting the resource would have the name announced in
        capitals. AudioOutputView made the same pair for the same reason.
      -->
      <StackPanel Spacing="{DynamicResource Space4}">
        <TextBlock Classes="player-overline" Text="{DynamicResource MarkerEditorStartHeading}" />
        <NumericUpDown
            x:Name="MarkerStartSelector"
            Minimum="0"
            Value="{Binding StartSeconds, Mode=TwoWay}"
            automation:AutomationProperties.Name="{DynamicResource MarkerEditorStartLabel}" />
      </StackPanel>
      <StackPanel Spacing="{DynamicResource Space4}">
        <TextBlock Classes="player-overline" Text="{DynamicResource MarkerEditorEndHeading}" />
        <NumericUpDown
            x:Name="MarkerEndSelector"
            Minimum="0"
            Value="{Binding EndSeconds, Mode=TwoWay}"
            automation:AutomationProperties.Name="{DynamicResource MarkerEditorEndLabel}" />
      </StackPanel>
    </WrapPanel>

    <TextBlock
        x:Name="MarkerRangeErrorText"
        IsVisible="{Binding HasRangeError}"
        Foreground="{DynamicResource PlayerTextBrush}"
        Text="{DynamicResource MarkerEditorRangeError}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="MarkerOverlapErrorText"
        IsVisible="{Binding HasOverlapError}"
        Foreground="{DynamicResource PlayerTextBrush}"
        Text="{DynamicResource MarkerEditorOverlapError}"
        TextWrapping="Wrap" />

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          Classes="primary-action"
          x:Name="SaveMarkerButton"
          Command="{Binding SaveCommand}"
          Content="{DynamicResource MarkerEditorSave}"
          automation:AutomationProperties.Name="{DynamicResource MarkerEditorSave}" />
      <Button
          x:Name="DeleteMarkerButton"
          Command="{Binding DeleteCommand}"
          Content="{DynamicResource MarkerEditorDelete}"
          automation:AutomationProperties.Name="{DynamicResource MarkerEditorDelete}" />
    </WrapPanel>
  </StackPanel>
</UserControl>

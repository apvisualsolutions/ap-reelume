<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.ResumePromptView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:ResumePromptViewModel"
    IsVisible="{Binding IsVisible}"
    automation:AutomationProperties.Name="{DynamicResource ResumePromptAccessibleName}">
  <StackPanel x:Name="ResumePromptSurface" Spacing="12">
    <TextBlock
        x:Name="ResumePromptHeadline"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource ResumePromptTitle}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="ResumePromptPosition"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{Binding ResumePositionText}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button
          x:Name="ResumeButton"
          Command="{Binding ResumeCommand}"
          Content="{DynamicResource ResumePromptResume}"
          automation:AutomationProperties.Name="{DynamicResource ResumePromptResume}" />
      <Button
          x:Name="RestartButton"
          Command="{Binding RestartCommand}"
          Content="{DynamicResource ResumePromptRestart}"
          automation:AutomationProperties.Name="{DynamicResource ResumePromptRestart}" />
    </StackPanel>
  </StackPanel>
</UserControl>

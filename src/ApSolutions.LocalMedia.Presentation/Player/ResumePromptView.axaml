<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.ResumePromptView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:ResumePromptViewModel"
    IsVisible="{Binding IsVisible}"
    automation:AutomationProperties.Name="{DynamicResource ResumePromptAccessibleName}">
  <!--
    An offer, and it has to be sized to itself. Without these two alignments the panel stretches to
    whatever contains it, and in the shell that is the whole player stage: measured on 2026-08-17 at
    1280x1400 over a 1280x1400 stage, with the two buttons at its top-left corner. It carries no
    background, so unlike the status badge corrected on 2026-08-15 it swallowed nothing — what it
    cost was an offer drawn as a full-stage panel instead of as the card it is.
  -->
  <Border
      x:Name="ResumePromptSurface"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Padding="16"
      Background="{DynamicResource ShellSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
  <StackPanel Spacing="{DynamicResource Space12}">
    <TextBlock
        x:Name="ResumePromptHeadline"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource ResumePromptTitle}"
        TextWrapping="Wrap" />

    <TextBlock
        x:Name="ResumePromptPosition"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{Binding ResumePositionText}" />

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          x:Name="ResumeButton"
          Command="{Binding ResumeCommand}"
          Content="{DynamicResource ResumePromptResume}"
          automation:AutomationProperties.Name="{DynamicResource ResumePromptResume}" />
      <Button
          x:Name="RestartButton"
          Command="{Binding RestartCommand}"
          Content="{DynamicResource ResumePromptRestart}"
          automation:AutomationProperties.Name="{DynamicResource ResumePromptRestart}" />
    </WrapPanel>
  </StackPanel>
  </Border>
</UserControl>

<Window
    x:Class="ApSolutions.LocalMedia.Presentation.Player.MiniPlayerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    Width="480"
    Height="270"
    MinWidth="320"
    MinHeight="180"
    ShowInTaskbar="False"
    Topmost="True"
    Title="{DynamicResource MiniPlayerTitle}"
    automation:AutomationProperties.Name="{DynamicResource MiniPlayerTitle}">
  <!--
    The chrome docks and the picture takes what is left, so the two share the window instead of
    replacing each other. Before 2026-08-19 the coordinator assigned Window.Content directly, which
    threw this whole tree away the moment a session moved in: whatever the window declared for itself
    was gone in the one mode it exists for.
  -->
  <DockPanel LastChildFill="True">
    <player:MiniPlayerChromeView x:Name="MiniPlayerChrome" DockPanel.Dock="Bottom" />
    <Panel x:Name="MiniPlayerSurface" Background="Black" />
  </DockPanel>
</Window>

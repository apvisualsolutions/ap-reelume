<Window
    x:Class="ApSolutions.LocalMedia.Presentation.Player.MiniPlayerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    Width="480"
    Height="270"
    MinWidth="320"
    MinHeight="180"
    Background="{DynamicResource PlayerSurfaceBrush}"
    ShowInTaskbar="False"
    Topmost="True"
    WindowDecorations="None"
    Title="{DynamicResource MiniPlayerTitle}"
    automation:AutomationProperties.Name="{DynamicResource MiniPlayerTitle}">
  <!--
    The chrome docks and the picture takes what is left, so the two share the window instead of
    replacing each other. Before 2026-08-19 the coordinator assigned Window.Content directly, which
    threw this whole tree away the moment a session moved in: whatever the window declared for itself
    was gone in the one mode it exists for.
  -->
  <!--
    The border is what a window without decorations has instead of a frame: the prototype draws the
    mini player with a hairline of its own against the desktop, and with WindowDecorations="None"
    nothing else would say where the window ends. It is the player's hairline and not the shell's,
    because what it sits against is the picture.
  -->
  <Border
      x:Name="MiniPlayerFrame"
      BorderBrush="{DynamicResource PlayerHairlineBrush}"
      BorderThickness="1">
    <DockPanel LastChildFill="True">
      <player:MiniPlayerChromeView x:Name="MiniPlayerChrome" DockPanel.Dock="Bottom" />
      <Panel x:Name="MiniPlayerSurface" Background="{DynamicResource PlayerSurfaceBrush}" />
    </DockPanel>
  </Border>
</Window>

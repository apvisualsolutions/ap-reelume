<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Player.VideoStatusOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    x:DataType="player:VideoStatusViewModel"
    automation:AutomationProperties.Name="{DynamicResource VideoStatusAccessibleName}"
    automation:AutomationProperties.LiveSetting="Polite">
  <!--
    A status badge, and it has to be sized to its own text. Without these two alignments the border
    stretches to whatever contains it, and in the shell that is the whole player stage: measured on
    2026-08-15 at 1280x1200 over a 1280x1200 stage, opaque, on top of the video and on top of the
    transport bar. Every click meant for play, pause, stop or the volume landed on this instead, and
    nothing said so because the player answers the keyboard itself.
  -->
  <Border
      x:Name="VideoStatusSurface"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="16"
      IsVisible="{Binding HasStatus}"
      Padding="10"
      Background="{DynamicResource ShellSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
    <StackPanel Spacing="{DynamicResource Space8}">
      <!--
        Two grammars in one badge, because these six lines are not the same kind of thing. Which path
        the video took and whether the GPU is decoding are FACTS about a video that is playing
        perfectly, so they read as secondary caption text. Falling back to software and an unsupported
        HDR format are WARNINGS — what plays is not quite what was asked for — and they get the warning
        surface and the glyph. Neither is a failure; that surface belongs to PlayerView.

        §4 asks for the facts with NO BOX AT ALL, and they keep the badge's. That is a discrepancy on
        purpose: this badge floats over the video, so text with no surface under it is read against an
        arbitrary frame and there is no contrast anybody can guarantee. The hierarchy §4 wants is kept
        — a fact is quieter than a warning — without making a line that some films render unreadable.
      -->
      <StackPanel IsVisible="{Binding HasDecodeFacts}" Spacing="{DynamicResource Space4}">
        <TextBlock
            x:Name="HdrPassthroughText"
            IsVisible="{Binding IsHdrPassthrough}"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{DynamicResource VideoStatusHdrPassthrough}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="ToneMappedText"
            IsVisible="{Binding IsToneMapped}"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{DynamicResource VideoStatusToneMapped}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="StandardRangeText"
            IsVisible="{Binding IsStandardDynamicRange}"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{DynamicResource VideoStatusStandardRange}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="HardwareText"
            IsVisible="{Binding IsHardwareAccelerated}"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{DynamicResource VideoStatusHardware}"
            TextWrapping="Wrap" />
      </StackPanel>

      <Border
          x:Name="VideoStatusWarningSurface"
          Padding="8,4"
          Background="{DynamicResource WarningSurfaceBrush}"
          BorderBrush="{DynamicResource WarningBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusSmall}"
          IsVisible="{Binding HasDecodeWarnings}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
          <TextBlock VerticalAlignment="Top" Text="⚠" />
          <StackPanel Spacing="{DynamicResource Space4}">
            <TextBlock
                x:Name="SoftwareFallbackText"
                IsVisible="{Binding FellBackToSoftware}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{DynamicResource VideoStatusSoftwareFallback}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="UnsupportedFormatText"
                IsVisible="{Binding IsUnsupportedFormat}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{DynamicResource VideoStatusUnsupportedFormat}"
                TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

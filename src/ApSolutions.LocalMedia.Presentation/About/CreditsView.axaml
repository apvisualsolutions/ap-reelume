<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.About.CreditsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    automation:AutomationProperties.Name="{DynamicResource AboutCreditsAccessibleName}">
  <StackPanel Spacing="8">
    <TextBlock
        Text="{DynamicResource AboutCreditsHeading}"
        FontSize="20"
        FontWeight="SemiBold"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock Text="TMDB" FontWeight="SemiBold" />
    <TextBlock Text="{DynamicResource AboutTmdbAttribution}" TextWrapping="Wrap" />
    <TextBlock Text="{DynamicResource AboutLicenseNotice}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

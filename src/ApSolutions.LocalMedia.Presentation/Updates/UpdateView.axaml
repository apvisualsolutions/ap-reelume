<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Updates.UpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:updates="clr-namespace:ApSolutions.LocalMedia.Presentation.Updates"
    x:DataType="updates:UpdateViewModel"
    automation:AutomationProperties.Name="{DynamicResource UpdateAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="UpdateResourceKey" />
  </UserControl.Resources>
  <!-- §4's skeleton for a settings section: the padded surface and the 620 reading column every
       section of that page shares. Without it this one started 158 px left of the others. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
  <StackPanel x:Name="UpdateSurface" MaxWidth="620" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource UpdateTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource UpdateDescription}"
        TextWrapping="Wrap" />

    <CheckBox
        x:Name="UpdateAutomaticCheckBox"
        Content="{DynamicResource UpdateAutomaticCheckLabel}"
        IsChecked="{Binding AutomaticCheckEnabled}"
        automation:AutomationProperties.Name="{DynamicResource UpdateAutomaticCheckLabel}" />

    <!--
      §4's four grammars on ONE living Border - the LiveSetting stays on a single surface because a
      screen reader subscribed to one region must not have that region swapped out from under it.
      What changes is the dress: neutral process on the card surface, up to date on Positive, a
      guardian's refusal on Warning with the reason as the headline, and a failure of the world on
      Danger. The classification lives on the model, so the styles here and the tests read one map.
    -->
    <Border
        x:Name="UpdateStatusSurface"
        Padding="16"
        Background="{DynamicResource CardSurfaceBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        Classes.status-positive="{Binding IsStatusPositive}"
        Classes.status-rejection="{Binding IsStatusRejection}"
        Classes.status-failure="{Binding IsStatusFailure}"
        automation:AutomationProperties.Name="{DynamicResource UpdateStatusAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <Border.Styles>
        <Style Selector="Border.status-positive">
          <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource PositiveBorderBrush}" />
        </Style>
        <Style Selector="Border.status-rejection">
          <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        </Style>
        <Style Selector="Border.status-failure">
          <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        </Style>
      </Border.Styles>
      <StackPanel Spacing="{DynamicResource Space8}">
        <!--
          On a refusal the reason is the news and the status is the context, so the reason stands
          first, as the block's heading, under its small label. Both live inside the one region.
        -->
        <StackPanel IsVisible="{Binding HasRejectionReason}" Spacing="{DynamicResource Space4}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="!" />
            <TextBlock
                FontSize="{DynamicResource FontSizeCaption}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource UpdateRejectionReasonLabel}" />
          </StackPanel>
          <TextBlock
              x:Name="UpdateRejectionReasonText"
              MaxWidth="600"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{Binding DetailKey, Converter={StaticResource UpdateResourceKey}}"
              TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock
            x:Name="UpdateStatusText"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding StatusKey, Converter={StaticResource UpdateResourceKey}}"
            TextWrapping="Wrap" />
        <TextBlock
            MaxWidth="600"
            IsVisible="{Binding IsStatusRejection}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource UpdateNothingInstalledNotice}"
            TextWrapping="Wrap" />
        <!--
          The technical detail folds away because its audience is a bug report, not the decision:
          the rule's own identifier, monospaced, for whoever needs the word verbatim.
        -->
        <ToggleButton
            x:Name="UpdateRejectionDetail"
            IsVisible="{Binding HasRejectionReason}"
            Content="{DynamicResource UpdateRejectionDetailAction}"
            automation:AutomationProperties.Name="{DynamicResource UpdateRejectionDetailAction}" />
        <TextBlock
            x:Name="UpdateRejectionCodeText"
            FontFamily="{DynamicResource FontFamilyMono}"
            Foreground="{DynamicResource TextPrimaryBrush}"
            IsVisible="{Binding #UpdateRejectionDetail.IsChecked}"
            Text="{Binding RejectionCode}" />
        <ProgressBar
            x:Name="UpdateProgressBar"
            Maximum="{Binding Total}"
            Minimum="0"
            IsVisible="{Binding IsBusy}"
            Value="{Binding Completed}"
            automation:AutomationProperties.Name="{DynamicResource UpdateProgressAccessibleName}" />
      </StackPanel>
    </Border>

    <!--
      What changed, in both languages. The one the interface speaks is what somebody reads before
      confirming; the other stays on the surface because a release note is worth being able to quote.
    -->
    <Border
        x:Name="UpdateOfferSurface"
        Padding="16"
        Background="{DynamicResource CardSurfaceBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        IsVisible="{Binding HasOffer}"
        automation:AutomationProperties.Name="{DynamicResource UpdateOfferAccessibleName}">
      <StackPanel Spacing="{DynamicResource Space8}">
        <TextBlock
            x:Name="UpdateOfferedVersion"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding OfferedVersion}"
            automation:AutomationProperties.HeadingLevel="3" />
        <TextBlock
            x:Name="UpdateSummarySpanish"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding SummarySpanish}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="UpdateSummaryEnglish"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding SummaryEnglish}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="UpdatePackageName"
            Foreground="{DynamicResource TextPrimaryBrush}"
            IsVisible="{Binding IsReadyToInstall}"
            Text="{Binding PackageName}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <!--
        The one action this screen is for. Download and install appear by state and cancel is never
        what a screen is for, so there is no second candidate.
      -->
      <Button
          x:Name="UpdateCheckButton"
          Classes="primary-action"
          Command="{Binding CheckCommand}"
          Content="{DynamicResource UpdateCheckLabel}"
          IsEnabled="{Binding IsIdle}"
          automation:AutomationProperties.Name="{DynamicResource UpdateCheckLabel}" />
      <Button
          x:Name="UpdateDownloadButton"
          Command="{Binding DownloadCommand}"
          Content="{DynamicResource UpdateDownloadLabel}"
          IsVisible="{Binding HasOffer}"
          automation:AutomationProperties.Name="{DynamicResource UpdateDownloadLabel}" />
      <Button
          x:Name="UpdateInstallButton"
          Command="{Binding InstallCommand}"
          Content="{DynamicResource UpdateInstallLabel}"
          IsVisible="{Binding IsReadyToInstall}"
          automation:AutomationProperties.Name="{DynamicResource UpdateInstallLabel}" />
      <Button
          x:Name="UpdateCancelButton"
          Command="{Binding CancelCommand}"
          Content="{DynamicResource UpdateCancelLabel}"
          IsEnabled="{Binding IsBusy}"
          automation:AutomationProperties.Name="{DynamicResource UpdateCancelLabel}" />
    </WrapPanel>

    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource UpdateConfirmationNotice}"
        TextWrapping="Wrap" />
  </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Review.ReviewInboxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:review="clr-namespace:ApSolutions.LocalMedia.Presentation.Review"
    x:DataType="review:ReviewInboxViewModel"
    automation:AutomationProperties.Name="{DynamicResource ReviewInboxAccessibleName}">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space12}">
    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock
          FontSize="{DynamicResource FontSizeDisplay}"
          FontWeight="SemiBold"
          Text="{DynamicResource ReviewInboxTitle}"
          automation:AutomationProperties.HeadingLevel="1" />
      <!--
        What this tray is and what it has not done, which the prototype says before showing a single
        card: nothing here has been applied to the library. A surface that asks for decisions without
        saying what a decision costs is asking somebody to guess.
      -->
      <TextBlock
          MaxWidth="760"
          HorizontalAlignment="Left"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource ReviewInboxIntro}"
          TextWrapping="Wrap" />
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          IsVisible="{Binding !IsEmpty}"
          Text="{Binding CountText}" />
    </StackPanel>
    <StackPanel
        Grid.Row="1"
        Spacing="{DynamicResource Space8}"
        IsVisible="{Binding HasReassignments}"
        automation:AutomationProperties.Name="{DynamicResource ReassignmentSectionAccessibleName}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource ReassignmentSectionTitle}"
          automation:AutomationProperties.HeadingLevel="2" />
      <TextBlock
          MaxWidth="720"
          Text="{DynamicResource ReassignmentSectionDescription}"
          TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Reassignments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="review:PendingReassignmentViewModel">
            <Border
                Margin="0,4"
                Padding="12"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource ShellHairlineBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusMedium}">
              <StackPanel Spacing="{DynamicResource Space8}">
                <TextBlock FontWeight="SemiBold" Text="{Binding NewPath}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="review:ReassignmentCandidateViewModel">
                      <!--
                      A grid rather than a horizontal StackPanel, which offers its children infinite
                      width: the path never wrapped there, so it took as much room as it wanted and
                      pushed the button off the side. Measured on 2026-08-16 at x=2234 in a 1600 px
                      window — a real library path is long enough to make the only control that
                      confirms a reassignment unreachable, with nothing to scroll sideways.
                      -->
                      <Grid Margin="0,2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
                        <TextBlock VerticalAlignment="Center" Text="{Binding Path}" TextWrapping="Wrap" />
                        <!--
                        One offer lists every candidate it could be, so this button repeats once per
                        row and the action alone does not say which. The help text is the candidate's
                        path, the way EpisodeRowView names its Play by the episode: without it two
                        identical buttons decide two different entities, and neither a screen reader
                        nor the walk can tell them apart.
                        -->
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.HelpText="{Binding Path}"
                            automation:AutomationProperties.Name="{DynamicResource ReassignmentConfirmAction}"
                            Command="{Binding ConfirmCommand}"
                            Content="{DynamicResource ReassignmentConfirmAction}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    HorizontalAlignment="Left"
                    automation:AutomationProperties.Name="{DynamicResource ReassignmentKeepAction}"
                    Command="{Binding KeepAsNewCommand}"
                    Content="{DynamicResource ReassignmentKeepAction}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
      <TextBox
          x:Name="ManualSearchBox"
          automation:AutomationProperties.Name="{DynamicResource ReviewManualSearchLabel}"
          Text="{Binding ManualSearch}"
          PlaceholderText="{DynamicResource ReviewManualSearchPlaceholder}" />
      <Button
          x:Name="ManualSearchAction"
          Grid.Column="1"
          automation:AutomationProperties.Name="{DynamicResource ReviewManualSearchAction}"
          Command="{Binding SearchManuallyCommand}"
          Content="{DynamicResource ReviewManualSearchAction}" />
    </Grid>
    <!--
      An empty tray is the good outcome and it is painted like one: everything was identified without
      anybody being asked. §4 asks for PositiveSurfaceBrush and a glyph rather than a blank panel,
      which reads like something failed to load - and the two positive brushes were declared in all
      four themes and spent by nobody until this.

      IsEmpty had been on the model since it was written, with no view reading it. The list hides in
      the same breath: an empty list under an empty state says nothing twice.

      A Grid and not a horizontal StackPanel, for the reason measured nine times here: a stack offers
      infinite width, so wrapping text beside a glyph never wraps.
    -->
    <Border
        x:Name="ReviewInboxEmptySurface"
        Grid.Row="3"
        VerticalAlignment="Top"
        Padding="16"
        Background="{DynamicResource PositiveSurfaceBrush}"
        BorderBrush="{DynamicResource PositiveBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        IsVisible="{Binding IsEmpty}"
        automation:AutomationProperties.Name="{DynamicResource ReviewInboxEmptyTitle}"
        automation:AutomationProperties.LiveSetting="Polite">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="Top"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="&#x2713;" />
        <StackPanel Grid.Column="1" Spacing="{DynamicResource Space4}">
          <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource ReviewInboxEmptyTitle}"
              TextWrapping="Wrap" />
          <TextBlock
              MaxWidth="600"
              FontSize="{DynamicResource FontSizeCaption}"
              Foreground="{DynamicResource TextSecondaryBrush}"
              Text="{DynamicResource ReviewInboxEmptyDescription}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <!--
      A list of cards rather than a list with a selection, since the decisions moved into the cards.
      What the ListBox bought was "the row Accept acts on", and nothing acts on a row any more —
      while what it cost was measured on 2026-08-25: its items are command controls, so a full-width
      card in a stack of them leaves no point beside a button that is not inside another control,
      and the walk's own proof (click beside, and nothing must change) had nowhere to land. The
      duplicates destination draws its rows the same way and never had the problem.
    -->
    <ItemsControl
        x:Name="ReviewCandidates"
        Grid.Row="3"
        IsVisible="{Binding !IsEmpty}"
        automation:AutomationProperties.Name="{DynamicResource ReviewCandidateListName}"
        ItemsSource="{Binding Items}">
      <!--
        Enter used to accept whatever was selected. With the three decisions inside the card that is
        a shortcut nobody can predict: measured on 2026-08-25, pressing Enter on the focused Reject
        button accepted the candidate instead, because the binding on the list answered first. A card
        holds three actions, so Enter belongs to whichever of them has focus — which is the ordinary
        keyboard grammar, and one Tab away.
      -->
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="review:CandidateCardViewModel">
          <review:CandidateCardView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!--
      What is left under the list once the decisions moved into the cards: the next page, and the
      sentence that says a decision was overtaken by another one. Accept and Reject used to live here
      and act on the selection, which made a tray of five files one decision wide — and put the
      surface's only accent on a button that could be pressed while nothing was selected.
    -->
    <WrapPanel Grid.Row="4" ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          x:Name="LoadMoreReviewAction"
          automation:AutomationProperties.Name="{DynamicResource ReviewLoadMoreAction}"
          Command="{Binding LoadMoreCommand}"
          Content="{DynamicResource ReviewLoadMoreAction}"
          IsVisible="{Binding HasMore}" />
      <TextBlock
          VerticalAlignment="Center"
          IsVisible="{Binding HasConflict}"
          Text="{DynamicResource ReviewConflictMessage}"
          TextWrapping="Wrap" />
    </WrapPanel>
  </Grid>
</UserControl>

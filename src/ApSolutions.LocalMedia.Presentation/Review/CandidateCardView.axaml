<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Review.CandidateCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:review="clr-namespace:ApSolutions.LocalMedia.Presentation.Review"
    x:DataType="review:CandidateCardViewModel">
  <!--
    The explanation is the answer to "why do you think this file is this film", and until 2026-08-21 it
    answered with a namespace: the codes are dotted paths the domain writes, and both the visible list
    and the help text carried them raw. The converter that translates recommendation reasons one view
    away does the same job here, for the list and for the sentence a screen reader hears.
  -->
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="ExplanationText" />
  </UserControl.Resources>
  <Border
      Margin="0,4"
      Padding="12"
      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}"
      automation:AutomationProperties.Name="{Binding StableKey}"
      automation:AutomationProperties.HelpText="{Binding ExplanationCodes, Converter={StaticResource ExplanationText}}">
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{DynamicResource Space8}">
      <TextBlock FontWeight="SemiBold" Text="{Binding StableKey}" />
      <TextBlock Grid.Column="1" Text="{Binding ScorePercent}" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{DynamicResource Space8}">
        <TextBlock IsVisible="{Binding IsPending}" Text="{DynamicResource ReviewStatusPending}" />
        <TextBlock IsVisible="{Binding IsSuggested}" Text="{DynamicResource ReviewStatusSuggested}" />
        <TextBlock Text="{DynamicResource ReviewExplanationHeading}" />
      </StackPanel>
      <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding ExplanationCodes}">
        <ItemsControl.ItemTemplate>
          <!-- x:DataType, because this control declares one and a template without its own inherits
               it: the binding would resolve against the card's model instead of against the code. -->
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding ., Converter={StaticResource ExplanationText}}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>

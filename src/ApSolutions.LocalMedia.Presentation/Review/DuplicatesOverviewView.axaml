<!--
The rail's duplicates destination, which the prototype gives a door of its own: every title that
resolves to more than one file, each row leading to the comparison the review has always drawn.
The empty state is the desirable one and is painted as such — the approved pair of sentences on the
positive surface, because "no duplicates" is the healthy answer, not a sad blank.
-->
<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Review.DuplicatesOverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:review="clr-namespace:ApSolutions.LocalMedia.Presentation.Review"
    x:DataType="review:DuplicatesOverviewViewModel"
    automation:AutomationProperties.Name="{DynamicResource DuplicatesOverviewAccessibleName}">
  <StackPanel Spacing="{DynamicResource Space16}">
    <StackPanel Spacing="{DynamicResource Space4}">
      <TextBlock
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource NavigationDuplicates}"
          automation:AutomationProperties.HeadingLevel="1" />
      <!--
        What a duplicate is and what choosing one does — nothing is deleted, hidden or moved. The
        prototype says it before the first table, and a destination that offers a decision without
        saying what it costs is asking somebody to guess.
      -->
      <TextBlock
          MaxWidth="900"
          HorizontalAlignment="Left"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource DuplicatesIntro}"
          TextWrapping="Wrap" />
    </StackPanel>
    <Border
        IsVisible="{Binding IsEmpty}"
        Padding="16"
        Background="{DynamicResource PositiveSurfaceBrush}"
        BorderBrush="{DynamicResource PositiveBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}">
      <StackPanel Spacing="{DynamicResource Space4}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
          <TextBlock Classes="state-glyph" Text="✓" automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextPrimaryBrush}"
              Text="{DynamicResource DuplicatesEmptyTitle}" />
        </StackPanel>
        <TextBlock
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource DuplicatesEmptyDescription}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ItemsControl IsVisible="{Binding HasGroups}" ItemsSource="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="{DynamicResource Space24}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="review:DuplicateGroupRowViewModel">
          <!--
            The prototype's group: the cover, the title, how many files answer to it, and then the
            table itself. The destination used to list the titles and put the comparison a click
            away, which meant the page that exists to compare copies showed none of what they are.

            The title stays a way in — the comparison view has more room per file and is where a
            person lands from the film card — and it is a link rather than a button wrapping the
            whole row, because a row full of radios cannot also be one big button.
          -->
          <StackPanel Spacing="{DynamicResource Space8}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space12}">
              <Border
                  Width="36"
                  Height="54"
                  ClipToBounds="True"
                  BorderBrush="{DynamicResource ShellHairlineBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusSmall}">
                <library:PosterArtView Title="{Binding Title}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button
                    Classes="link-action plain"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Command="{Binding $parent[ItemsControl].((review:DuplicatesOverviewViewModel)DataContext).OpenGroupCommand}"
                    CommandParameter="{Binding}"
                    Content="{Binding Title}"
                    FontSize="{DynamicResource FontSizeSubtitle}"
                    FontWeight="SemiBold"
                    automation:AutomationProperties.Name="{Binding Title}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                  <TextBlock
                      FontSize="{DynamicResource FontSizeCaption}"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Text="{Binding VersionCount}" />
                  <TextBlock
                      FontSize="{DynamicResource FontSizeCaption}"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Text="{DynamicResource DuplicateFilesLabel}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!--
              The header of the table, written once per group like the prototype's. The same eight
              widths as the rows below it, because a header that drifts from its column is worse than
              no header.
            -->
            <Grid
                Margin="0,4,0,0"
                ColumnDefinitions="Auto,*,110,110,110,90,90,140,Auto"
                ColumnSpacing="{DynamicResource Space8}">
              <TextBlock Grid.Column="1" Classes="column-overline" Text="{DynamicResource DuplicateColumnFile}" />
              <TextBlock Grid.Column="2" Classes="column-overline" Text="{DynamicResource DuplicateColumnResolution}" />
              <TextBlock Grid.Column="3" Classes="column-overline" Text="{DynamicResource DuplicateColumnCodec}" />
              <TextBlock Grid.Column="4" Classes="column-overline" Text="{DynamicResource DuplicateColumnAudio}" />
              <TextBlock Grid.Column="5" Classes="column-overline" Text="{DynamicResource DuplicateColumnSize}" />
              <TextBlock Grid.Column="6" Classes="column-overline" Text="{DynamicResource DuplicateColumnDuration}" />
              <TextBlock Grid.Column="7" Classes="column-overline" Text="{DynamicResource DuplicateColumnLocation}" />
              <TextBlock Grid.Column="8" Classes="column-overline" Text="{DynamicResource DuplicateColumnAvailability}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{DynamicResource Space4}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="review:DuplicateFileRowViewModel">
                  <Border
                      Classes="duplicate-row"
                      Classes.chosen="{Binding IsPreferred}"
                      Padding="12,10"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource CornerRadiusMedium}">
                    <Grid
                        ColumnDefinitions="Auto,*,110,110,110,90,90,140,Auto"
                        ColumnSpacing="{DynamicResource Space8}">
                      <!--
                        The radio is the decision: which copy plays when somebody presses Play. It is
                        named by the file it stands for, because a group of three has three of them
                        and «Preferida» three times tells a reader user nothing.
                      -->
                      <RadioButton
                          VerticalAlignment="Center"
                          Command="{Binding SetPreferredCommand}"
                          CommandParameter="{Binding}"
                          GroupName="{Binding $parent[ItemsControl].((review:DuplicateGroupRowViewModel)DataContext).Title}"
                          IsChecked="{Binding IsPreferred, Mode=OneWay}"
                          automation:AutomationProperties.Name="{Binding ShortPath}"
                          automation:AutomationProperties.HelpText="{Binding Location}" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontFamily="{DynamicResource FontFamilyMono}"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding ShortPath}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                      <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding Resolution}" />
                      <TextBlock
                          Grid.Column="3"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding VideoCodec}" />
                      <TextBlock
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding AudioCodec}" />
                      <TextBlock
                          Grid.Column="5"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding Size}" />
                      <TextBlock
                          Grid.Column="6"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Text="{Binding Duration}" />
                      <TextBlock
                          Grid.Column="7"
                          VerticalAlignment="Center"
                          FontFamily="{DynamicResource FontFamilyMono}"
                          FontSize="{DynamicResource FontSizeCaption}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Text="{Binding Location}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                      <!--
                        The availability column, and it is the one badge rather than a second one:
                        the prototype draws a red chip here, this application says "not reachable
                        right now" in one place and one shape, which UnavailableBadgeTests enforces.
                        The green half is a chip because there is no shared control for "it is there"
                        and nothing else in the tree says it.
                      -->
                      <Border Grid.Column="8" Classes="state-chip ok" IsVisible="{Binding IsAvailable}">
                        <TextBlock Text="{DynamicResource MediaVersionAvailable}" />
                      </Border>
                      <library:UnavailableBadge Grid.Column="8" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

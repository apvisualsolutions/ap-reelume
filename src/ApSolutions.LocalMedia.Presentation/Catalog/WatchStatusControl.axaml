<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Catalog.WatchStatusControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:catalog="clr-namespace:ApSolutions.LocalMedia.Presentation.Catalog"
    x:DataType="catalog:WatchStatusViewModel"
    automation:AutomationProperties.Name="{DynamicResource WatchStatusAccessibleName}">
  <StackPanel x:Name="WatchStatusSurface" Spacing="{DynamicResource Space8}">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
      <TextBlock
          x:Name="NotStartedGlyph"
          Classes="state-glyph"
          IsVisible="{Binding IsNotStarted}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="○" />
      <TextBlock
          x:Name="NotStartedText"
          IsVisible="{Binding IsNotStarted}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource WatchStatusNotStarted}" />

      <TextBlock
          x:Name="InProgressGlyph"
          Classes="state-glyph"
          IsVisible="{Binding IsInProgress}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="◐" />
      <TextBlock
          x:Name="InProgressText"
          IsVisible="{Binding IsInProgress}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource WatchStatusInProgress}" />

      <TextBlock
          x:Name="WatchedGlyph"
          Classes="state-glyph"
          IsVisible="{Binding IsWatched}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="●" />
      <TextBlock
          x:Name="WatchedText"
          IsVisible="{Binding IsWatched}"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource WatchStatusWatched}" />
    </StackPanel>

    <TextBlock
        x:Name="ManualOverrideText"
        IsVisible="{Binding IsManualOverride}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource WatchStatusManualOverride}"
        TextWrapping="Wrap" />

    <!--
      The three decisions, in the shape the column beside them already uses: a full-width row with an
      icon and the name. They were pills in a WrapPanel, so «Marcar como visto» and «Marcar como no
      visto» were two short controls of different widths above two full-width rows — a column with
      two grammars in it. Same names, same commands, same order; only the shape moved.
    -->
    <StackPanel Spacing="{DynamicResource Space4}">
      <Button
          x:Name="MarkWatchedButton"
          Classes="action-row"
          Command="{Binding MarkWatchedCommand}"
          automation:AutomationProperties.Name="{DynamicResource WatchStatusMarkWatched}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space8}">
          <Path Classes="icon size-16" Data="{DynamicResource IconCheck}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource WatchStatusMarkWatched}" />
        </Grid>
      </Button>
      <Button
          x:Name="MarkNotStartedButton"
          Classes="action-row"
          Command="{Binding MarkNotStartedCommand}"
          automation:AutomationProperties.Name="{DynamicResource WatchStatusMarkNotStarted}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space8}">
          <Path Classes="icon size-16" Data="{DynamicResource IconClose}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource WatchStatusMarkNotStarted}" />
        </Grid>
      </Button>
      <Button
          x:Name="ClearOverrideButton"
          Classes="action-row"
          Command="{Binding ClearOverrideCommand}"
          automation:AutomationProperties.Name="{DynamicResource WatchStatusClearOverride}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space8}">
          <Path Classes="icon size-16" Data="{DynamicResource IconReset}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource WatchStatusClearOverride}" />
        </Grid>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>

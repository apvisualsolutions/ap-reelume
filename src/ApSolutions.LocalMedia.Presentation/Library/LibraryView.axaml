<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Library.LibraryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:catalog="clr-namespace:ApSolutions.LocalMedia.Application.Catalog;assembly=ApSolutions.LocalMedia.Application"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:movie="clr-namespace:ApSolutions.LocalMedia.Presentation.Movie"
    xmlns:show="clr-namespace:ApSolutions.LocalMedia.Presentation.Show"
    x:DataType="library:LibraryViewModel"
    automation:AutomationProperties.Name="{DynamicResource LibraryAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="CatalogResourceKey" />
  </UserControl.Resources>
  <Grid>
    <Grid IsVisible="{Binding IsBrowsing}" RowDefinitions="Auto,Auto,Auto,*">
      <!--
        The prototype's header is one line: the name, how many are under it, and the search box against
        the right edge. The count sits in the elastic column and not the title, so what gives when the
        window is at its 900 px minimum is the number rather than the word Biblioteca - and nothing is
        ever drawn past the edge, because a star column cannot push anything out.

        The search box keeps a width because a TextBox asks for almost nothing and would otherwise
        arrive as a slot two characters wide; 280 is the prototype's 282 on this scale.
      -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space12}">
        <StackPanel
            Orientation="Horizontal"
            Spacing="{DynamicResource Space12}"
            VerticalAlignment="Center">
          <TextBlock
              FontSize="{DynamicResource FontSizeTitle}"
              FontWeight="SemiBold"
              Text="{DynamicResource LibraryTitle}"
              VerticalAlignment="Center"
              automation:AutomationProperties.HeadingLevel="1" />
          <StackPanel
              Orientation="Horizontal"
              Spacing="{DynamicResource Space4}"
              VerticalAlignment="Center">
            <TextBlock
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding ItemCount}" />
            <TextBlock
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource LibraryItemCountLabel}" />
          </StackPanel>
        </StackPanel>
        <!--
          The right half wraps rather than clips: at 200 % text scaling the search box and the
          primary action together outgrow the row — measured, the button ended at 834 px in a 683 px
          viewport — and a WrapPanel drops the button under the box instead of past the edge. Right
          aligned, which is where the prototype keeps both. The box is 220 rather than the
          prototype's 282, and that is the same measurement twice: at 200 % the title column takes
          434 of 683 — DPI rounding moves it a few pixels between passes — and a fixed 280
          overflowed its column by 23 px, a 240 by 3. The 220 leaves the rounding room to wobble.

          The magnifier inside the field is a decoration rather than a control: the box already
          carries the accessible name, and the glyph does not take a click. A Panel because the two
          overlap on purpose - the field's left padding is what makes room for it.
        -->
        <WrapPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            ItemSpacing="{DynamicResource Space12}"
            LineSpacing="{DynamicResource Space8}">
          <Panel>
            <TextBox
                Classes="search-field"
                Width="220"
                automation:AutomationProperties.Name="{DynamicResource LibrarySearchLabel}"
                Text="{Binding Search}"
                PlaceholderText="{DynamicResource LibrarySearchPlaceholder}" />
            <Path Classes="icon size-16 search-adornment" Data="{DynamicResource IconSearch}" />
          </Panel>
          <!--
            The header's primary action, which opens the add-root dialog. Its key is its own — the
            rail's plus keeps «Añadir medios» untouched — because in this tree the label IS the
            control's identity, and the ellipsis is the convention for "opens a dialog".
          -->
          <Button
              Classes="primary-action"
              automation:AutomationProperties.Name="{DynamicResource LibraryAddMediaAction}"
              Command="{Binding AddMediaCommand}"
              Content="{DynamicResource LibraryAddMediaAction}" />
        </WrapPanel>
      </Grid>
      <!--
        Only while a scan runs, which is the prototype's grammar: a row that said "no scan is
        running" was a sentence about nothing, permanently parked between the header and the
        filters. The live setting still announces the row when it appears, which is the moment the
        sentence starts being news.
      -->
      <StackPanel
          x:Name="ScanProgressSurface"
          Grid.Row="1"
          Margin="0,12,0,0"
          DataContext="{Binding ScanProgress}"
          IsVisible="{Binding IsRunning}"
          Orientation="Horizontal"
          Spacing="{DynamicResource Space8}"
          automation:AutomationProperties.Name="{DynamicResource ScanProgressAccessibleName}"
          automation:AutomationProperties.LiveSetting="Polite">
        <!--
          The dot is the only thing on this row that says a scan is still going: the count beside it
          moves in steps, and between two steps a scan that is working and one that has stopped look
          identical. It is a symbol and not a word, so it stays literal like the other five; the
          sentence beside it is what a reader hears.
        -->
        <TextBlock
            x:Name="ScanProgressPulse"
            Classes="state-glyph scan-pulse"
            IsVisible="{Binding IsRunning}"
            Text="●"
            automation:AutomationProperties.AccessibilityView="Raw" />
        <TextBlock
            x:Name="ScanProgressRunningText"
            IsVisible="{Binding IsRunning}"
            Text="{DynamicResource ScanProgressRunning}" />
        <TextBlock
            x:Name="ScanProgressIdleText"
            IsVisible="{Binding !IsRunning}"
            Text="{DynamicResource ScanProgressIdle}" />
        <TextBlock IsVisible="{Binding IsRunning}" Text="{Binding EnumeratedCount}" />
        <TextBlock IsVisible="{Binding IsRunning}" Text="{DynamicResource ScanProgressFilesLabel}" />
      </StackPanel>
      <!--
        Search, two filters and the apply button all carry translated words, and a Grid of fixed
        columns pushes the last one out of the window rather than moving it down. The search box gets
        a width because a WrapPanel gives its children what they ask for, and a TextBox asks for
        almost nothing.
      -->
      <WrapPanel
          x:Name="LibraryFilterSurface"
          Grid.Row="2"
          Margin="0,16,0,12"
          ItemSpacing="{DynamicResource Space12}"
          LineSpacing="{DynamicResource Space8}">
        <!--
          The three kind pills, which the prototype leads the filter row with and which this tree had
          folded into the drop-down beside them. Folding them in was what made kind and status
          exclusive: one ComboBox bound to the whole flags value can only ever hold one of the nine,
          so choosing Películas dropped En curso. CatalogRepository never required that - it reads the
          Movie and Show bits for its kind predicate and ANDs the rest in separately - so "films I
          have not started" was expressible in the query the whole time and unreachable from the
          screen. Registered and never fed, in its filter-shaped form.

          Each pill says which one is on twice: the accent fill from theme-option.selected, and the
          glyph beside the label. In either high contrast dictionary the two fills are the same
          colour, so the glyph is not decoration there - it is the whole signal.
        -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            automation:AutomationProperties.Name="{DynamicResource LibraryTypeFilterAccessibleName}">
          <Button
              Classes="theme-option"
              Classes.selected="{Binding IsEveryKind}"
              automation:AutomationProperties.Name="{DynamicResource LibraryFilterAll}"
              Command="{Binding SelectTypeCommand}"
              CommandParameter="{x:Static catalog:CatalogFilter.None}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
              <TextBlock Classes="state-glyph" Text="{Binding EveryKindStateCue}" />
              <TextBlock Text="{DynamicResource LibraryFilterAll}" />
            </StackPanel>
          </Button>
          <Button
              Classes="theme-option"
              Classes.selected="{Binding IsMoviesOnly}"
              automation:AutomationProperties.Name="{DynamicResource LibraryFilterMovies}"
              Command="{Binding SelectTypeCommand}"
              CommandParameter="{x:Static catalog:CatalogFilter.Movie}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
              <TextBlock Classes="state-glyph" Text="{Binding MoviesOnlyStateCue}" />
              <TextBlock Text="{DynamicResource LibraryFilterMovies}" />
            </StackPanel>
          </Button>
          <Button
              Classes="theme-option"
              Classes.selected="{Binding IsShowsOnly}"
              automation:AutomationProperties.Name="{DynamicResource LibraryFilterShows}"
              Command="{Binding SelectTypeCommand}"
              CommandParameter="{x:Static catalog:CatalogFilter.Show}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
              <TextBlock Classes="state-glyph" Text="{Binding ShowsOnlyStateCue}" />
              <TextBlock Text="{DynamicResource LibraryFilterShows}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!--
          What is left after the pills took the two kind bits: availability, progress, and the four
          personal marks. Binding to StatusFilter rather than Filters is what keeps the two controls
          from undoing each other - this one writes its own bits and leaves the pills' alone.
        -->
        <!--
          Both drop-downs apply as a choice is made — the model reloads when StatusFilter or Sort
          actually changes — because that is the prototype's grammar and the reason Apply could go:
          a button whose whole job was repeating what the control beside it had already said. Its
          removal is a deliberate deviation from the control inventory, which never listed it among
          the eliminated; the walk now proves the query runs by pressing the pills instead.
        -->
        <ComboBox
            Classes="filter-pill"
            Tag="{DynamicResource LibraryFilterLabel}"
            automation:AutomationProperties.Name="{DynamicResource LibraryFilterLabel}"
            SelectedValue="{Binding StatusFilter}"
            SelectedValueBinding="{ReflectionBinding Tag}">
          <ComboBoxItem Content="{DynamicResource LibraryFilterAll}" Tag="{x:Static catalog:CatalogFilter.None}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterAvailable}" Tag="{x:Static catalog:CatalogFilter.Available}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterProgress}" Tag="{x:Static catalog:CatalogFilter.Progress}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterPersonal}" Tag="{x:Static catalog:CatalogFilter.Personal}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterFavorite}" Tag="{x:Static catalog:CatalogFilter.Favorite}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterWatchLater}" Tag="{x:Static catalog:CatalogFilter.WatchLater}" />
          <ComboBoxItem Content="{DynamicResource LibraryFilterRated}" Tag="{x:Static catalog:CatalogFilter.Rated}" />
        </ComboBox>
        <ComboBox
            Classes="filter-pill"
            Tag="{DynamicResource LibrarySortLabel}"
            automation:AutomationProperties.Name="{DynamicResource LibrarySortLabel}"
            SelectedValue="{Binding Sort}"
            SelectedValueBinding="{ReflectionBinding Tag}">
          <ComboBoxItem Content="{DynamicResource LibrarySortTitle}" Tag="{x:Static catalog:CatalogSort.Title}" />
          <ComboBoxItem Content="{DynamicResource LibrarySortYear}" Tag="{x:Static catalog:CatalogSort.Year}" />
          <ComboBoxItem Content="{DynamicResource LibrarySortAdded}" Tag="{x:Static catalog:CatalogSort.Added}" />
          <ComboBoxItem Content="{DynamicResource LibrarySortLastPlayed}" Tag="{x:Static catalog:CatalogSort.LastPlayed}" />
        </ComboBox>
        <!--
          Present only while something narrows the grid, which is the prototype's grammar for this
          one: a reset permanently on offer is a control whose job would be nothing. Its coming and
          going does not shove the row about — it is the last control on it.
        -->
        <Button
            IsVisible="{Binding IsFiltersDirty}"
            automation:AutomationProperties.Name="{DynamicResource LibraryClearFiltersAction}"
            Command="{Binding ClearFiltersCommand}"
            Content="{DynamicResource LibraryClearFiltersAction}" />
      </WrapPanel>
      <!--
        Searching and finding nothing is its own answer. The empty library is painted by ShellView and
        would say something false here: the library is not empty, the search is what found nothing.
        With no search and no filter this stays away and the shell speaks instead.
      -->
      <StackPanel
          Grid.Row="3"
          VerticalAlignment="Top"
          IsVisible="{Binding IsSearchWithoutResults}"
          Spacing="{DynamicResource Space8}">
        <TextBlock
            FontSize="{DynamicResource FontSizeSubtitle}"
            FontWeight="SemiBold"
            Text="{DynamicResource LibrarySearchNoResultsTitle}" />
        <TextBlock Text="{DynamicResource LibrarySearchNoResultsDescription}" TextWrapping="Wrap" />
        <!--
          The exit the inventory added this control for: out of "no results" without deleting by
          hand. It lives in the state it answers, disabled rather than absent when the narrowing was
          a filter and not a search — the row's reset right above covers that one.
        -->
        <Button
            HorizontalAlignment="Left"
            automation:AutomationProperties.Name="{DynamicResource LibrarySearchClearAction}"
            Command="{Binding ClearSearchCommand}"
            Content="{DynamicResource LibrarySearchClearAction}" />
      </StackPanel>

      <!--
        The fourth of §4's four states: nothing in the library and nothing narrowing it. Distinct
        from the search that found nothing — that state is an answer about the search, this one is an
        answer about the library — and painted here rather than left to the shell, so the grid is
        never silently blank. The dashed rectangle is the prototype's empty-box border, built the way
        §7 prescribes because a Border has no dashed stroke. The button that adds the first folder
        arrives with the add-root dialog; text first, so the state exists before its action does.
      -->
      <!--
        The skeleton of the first visit: six card-shaped placeholders breathing at the motion
        token's pace while the first query runs. Only while the grid holds nothing - see the model.
      -->
      <WrapPanel
          Grid.Row="3"
          IsVisible="{Binding ShowsSkeleton}"
          ItemSpacing="{DynamicResource Space16}"
          LineSpacing="{DynamicResource Space16}">
        <Border Classes="apr-shim" Width="158" Height="237" />
        <Border Classes="apr-shim" Width="158" Height="237" />
        <Border Classes="apr-shim" Width="158" Height="237" />
        <Border Classes="apr-shim" Width="158" Height="237" />
        <Border Classes="apr-shim" Width="158" Height="237" />
        <Border Classes="apr-shim" Width="158" Height="237" />
      </WrapPanel>
      <Panel
          x:Name="LibraryEmptySurface"
          Grid.Row="3"
          VerticalAlignment="Top"
          IsVisible="{Binding IsLibraryEmpty}">
        <Rectangle
            RadiusX="8"
            RadiusY="8"
            Stroke="{DynamicResource ShellBorderBrush}"
            StrokeDashArray="4,4"
            StrokeThickness="1" />
        <StackPanel
            Margin="24,48"
            HorizontalAlignment="Center"
            Spacing="{DynamicResource Space8}">
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="{DynamicResource FontSizeSubtitle}"
              FontWeight="SemiBold"
              Text="{DynamicResource LibraryEmptyTitle}" />
          <TextBlock
              HorizontalAlignment="Center"
              MaxWidth="480"
              Foreground="{DynamicResource TextSecondaryBrush}"
              Text="{DynamicResource LibraryEmptyDescription}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Panel>

      <!--
        The fluid grid §4 asks for, and the decision not to build one is reversed here with its
        number. It was taken because "nothing in Avalonia 12.1.1 reflows and virtualises at once",
        which is true of the panels and false of the problem: a WrapPanel over ten thousand cards
        costs 4559 ms and keeps all ten thousand alive, and the same cards grouped into rows inside a
        VirtualizingStackPanel cost 6 ms and keep 36. ItemsRepeater and WrapLayout were the shape
        looked for and neither exists here — the ItemsRepeater package stops at Avalonia 12.0.0 and
        WrapLayout is not Avalonia's at all — and neither is needed.

        LibraryView.axaml.cs measures this surface and tells the model how many fit. An ItemsControl
        rather than a ListBox because a row is not something to select: the card inside it is a
        button, which is what the keyboard reaches and what the walk presses.
      -->
      <ScrollViewer
          x:Name="LibraryGridSurface"
          Grid.Row="3"
          HorizontalScrollBarVisibility="Disabled"
          IsVisible="{Binding !IsSearchWithoutResults}"
          SizeChanged="OnGridSurfaceSizeChanged">
        <ItemsControl
            ItemsSource="{Binding Rows}"
            automation:AutomationProperties.Name="{DynamicResource LibraryResultsListName}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!--
                No spacing here and no margin under the row: the card button's own 8 px padding is the
                whole gap, 8 from one card and 8 from the next, horizontally and vertically alike.
                One source for it is what lets the column count be arithmetic - a second gap on top
                of the padding is a number the counting would have to know about, and the first
                measurement of this grid got it wrong exactly there: eight columns were counted into
                1352 px and the eighth was drawn 72 px past the edge.
              -->
              <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="library:CatalogItemViewModel">
                    <Button
                        Classes="poster-card"
                        Click="OnCatalogItemClick"
                        automation:AutomationProperties.Name="{Binding Title}"
                        automation:AutomationProperties.HelpText="{Binding AvailabilityKey, Converter={StaticResource CatalogResourceKey}}">
                      <StackPanel Spacing="{DynamicResource Space8}">
                        <library:PosterCardView />
                        <library:UnavailableBadge HorizontalAlignment="Left" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <Grid IsVisible="{Binding IsMovieDetails}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space12}">
      <Button
          HorizontalAlignment="Left"
          Command="{Binding BackCommand}"
          Content="{DynamicResource LibraryBackAction}"
          automation:AutomationProperties.Name="{DynamicResource LibraryBackAction}" />
      <movie:MovieDetailsView Grid.Row="1" DataContext="{Binding MovieDetails}" />
    </Grid>

    <Grid IsVisible="{Binding IsShowDetails}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space12}">
      <Button
          HorizontalAlignment="Left"
          Command="{Binding BackCommand}"
          Content="{DynamicResource LibraryBackAction}"
          automation:AutomationProperties.Name="{DynamicResource LibraryBackAction}" />
      <show:ShowDetailsView Grid.Row="1" DataContext="{Binding ShowDetails}" />
    </Grid>
  </Grid>
</UserControl>

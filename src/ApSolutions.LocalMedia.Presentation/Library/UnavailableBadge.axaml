<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Library.UnavailableBadge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    x:DataType="library:CatalogItemViewModel"
    IsVisible="{Binding !IsAvailable}"
    automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
  <Border Padding="8,4" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4">
    <TextBlock Text="{DynamicResource MediaUnavailable}" />
  </Border>
</UserControl>

<!--
A medium that is not reachable right now is a warning, not an error: an unplugged drive or a network
share that is down is not something that went wrong, it is something that is not here, and its titles
stay in the catalogue on purpose. The border and the glyph are why it is never colour alone.

It carries no x:DataType because six view models mount it — the catalogue item, the two rails' cards,
both detail cards and the episode row — and a compiled binding is bound to one of them. Avalonia
refuses a compiled binding without one, so the visibility is a ReflectionBinding, the same escape
LibraryView already uses for its filter tags. What the compiler stops checking is asserted in
UnavailableBadgeTests, on the effect rather than on the type.

IT HAS TWO FORMS SINCE 2026-09-12, and the second is the reason the first is still one control. On a
cover the prototype does not hang a pill in a corner: it veils the whole picture and writes across
its foot (:311), because what is out of reach there is the title the cover stands for. In a row of
versions or a settings list it stays the pill it has always been. Two sentences would have been two
controls drifting apart; this is one control saying the same thing in the two places it is said.

The glyph is a geometry rather than the ⚠ character since the same day: this tree carried twenty-seven
Segoe glyphs into line drawings on 2026-08-24 and this one was left behind, a solid pictogram from
another alphabet beside thirty-five stroked ones.
-->
<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Library.UnavailableBadge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    IsVisible="{ReflectionBinding !IsAvailable}"
    automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
  <UserControl.Styles>
    <!--
      The pill, which is what five of the six places that mount this still draw. It is a style and
      not a row of attributes on the Border because an attribute is a local value and beats every
      setter: with the numbers written below, the veil's own setters were read, applied and lost, and
      what it painted was this pill stretched across a cover.
    -->
    <Style Selector="library|UnavailableBadge Border#BadgeSurface">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    </Style>

    <Style Selector="library|UnavailableBadge TextBlock#BadgeWord">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!--
      The veil: the cover's own dimming, the prototype's rgba(9,12,16,.55) at the .57 the token
      carries and says why, with the word at its foot in white. The surface loses its border and its
      corner because it is no longer a badge on something - it IS the something, dimmed.
    -->
    <Style Selector="library|UnavailableBadge.cover-veil Border#BadgeSurface">
      <!-- The prototype's padding:8, written as a thickness: Space8 is a double and a Padding is not. -->
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource PosterVeilBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource PosterChipInkBrush}" />
    </Style>

    <Style Selector="library|UnavailableBadge.cover-veil Grid#BadgeWords">
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ColumnSpacing" Value="5" />
    </Style>

    <Style Selector="library|UnavailableBadge.cover-veil Path#BadgeGlyph">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StrokeThickness" Value="0.93" />
    </Style>

    <!--
      Eleven px in 600, and it wraps: at the text scale a reader can ask for, «No disponible» is
      wider than a cover and a line that cannot break would be a line that leaves the picture.
    -->
    <Style Selector="library|UnavailableBadge.cover-veil TextBlock#BadgeWord">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeFootnote}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="BadgeSurface">
    <!--
      A Grid and not a horizontal StackPanel: a stack measures its children with all the width in
      the world, so the word inside one can never wrap, and on a cover it has to.
    -->
    <Grid x:Name="BadgeWords" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
      <Path
          x:Name="BadgeGlyph"
          Classes="icon size-12"
          VerticalAlignment="Center"
          Data="{DynamicResource IconWarning}" />
      <TextBlock
          x:Name="BadgeWord"
          Grid.Column="1"
          VerticalAlignment="Center"
          Text="{DynamicResource MediaUnavailable}" />
    </Grid>
  </Border>
</UserControl>

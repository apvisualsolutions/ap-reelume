<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.InProgressRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeInProgressAccessibleName}">
  <Grid RowDefinitions="Auto,*">
    <TextBlock
        FontSize="18"
        FontWeight="SemiBold"
        Text="{DynamicResource HomeInProgressHeading}" />
    <TextBlock
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasInProgress}"
        Text="{DynamicResource HomeInProgressEmpty}"
        TextWrapping="Wrap" />
    <ListBox
        x:Name="InProgressRail"
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding HasInProgress}"
        ItemsSource="{Binding InProgress}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource HomeInProgressHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:InProgressItemViewModel">
          <Border Width="220" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="{Binding Title}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  FontSize="12"
                  IsVisible="{Binding HasSubtitle}"
                  Text="{Binding Subtitle}"
                  TextTrimming="CharacterEllipsis" />
              <ProgressBar
                  Maximum="1"
                  Value="{Binding CompletedFraction}"
                  automation:AutomationProperties.Name="{DynamicResource HomeResumeProgressLabel}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock FontSize="12" Text="{Binding CompletedText}" />
                <TextBlock FontSize="12" Text="{DynamicResource HomePercentSuffix}" />
              </StackPanel>
              <Border
                  Padding="8,4"
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="4"
                  IsVisible="{Binding !IsAvailable}"
                  automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
                <TextBlock FontSize="12" Text="{DynamicResource MediaUnavailable}" />
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.InProgressRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeInProgressAccessibleName}">
  <Grid RowDefinitions="Auto,*">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Text="{DynamicResource HomeInProgressHeading}" />
    <TextBlock
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasInProgress}"
        Text="{DynamicResource HomeInProgressEmpty}"
        TextWrapping="Wrap" />
    <ListBox
        x:Name="InProgressRail"
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding HasInProgress}"
        ItemsSource="{Binding InProgress}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource HomeInProgressHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:InProgressItemViewModel">
          <Border Width="220" Padding="12">
            <StackPanel Spacing="{DynamicResource Space4}">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="{Binding Title}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  IsVisible="{Binding HasSubtitle}"
                  Text="{Binding Subtitle}"
                  TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding CompletedText}" />
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{DynamicResource HomePercentSuffix}" />
              </StackPanel>
              <Border
                  Padding="8,4"
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding !IsAvailable}"
                  automation:AutomationProperties.Name="{DynamicResource MediaUnavailable}">
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{DynamicResource MediaUnavailable}" />
              </Border>
              <!--
              The progress bar sits at the foot of the card rather than inside it, and is 3 px rather
              than the theme's 4: it is a rule under the card, not a control to read. MinHeight goes
              with Height because the base ControlTheme sets a minimum of its own, and Height alone
              measures 4. The percentage above it says the same thing in words, so the bar is never
              the only carrier.
              -->
              <ProgressBar
                  Height="3"
                  MinHeight="3"
                  Background="{DynamicResource ControlFillBrush}"
                  Foreground="{DynamicResource AccentBrush}"
                  Maximum="1"
                  Value="{Binding CompletedFraction}"
                  automation:AutomationProperties.Name="{DynamicResource HomeResumeProgressLabel}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

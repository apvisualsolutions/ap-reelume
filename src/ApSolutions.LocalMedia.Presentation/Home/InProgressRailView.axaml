<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.InProgressRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeInProgressAccessibleName}">
  <Grid RowDefinitions="Auto,*">
    <!--
      The rail header carries the way into the library — the prototype keeps this link on a rail
      header, and this is the rail the gate can hold to the first viewport at 1366x768. It absorbs
      LibraryEntryView whole: same command, same words, same control name, so the walk and the
      focus fallback find it where they always did. No glyph beside it: a label that says where it
      goes needs no arrow, and home's strings all come from resources.
    -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource HomeInProgressHeading}"
          automation:AutomationProperties.HeadingLevel="2" />
      <Button
          x:Name="LibraryEntryAction"
          Grid.Column="1"
          VerticalAlignment="Center"
          automation:AutomationProperties.Name="{DynamicResource HomeLibraryAction}"
          Command="{Binding OpenLibraryCommand}"
          Content="{DynamicResource HomeLibraryAction}" />
    </Grid>
    <TextBlock
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasInProgress}"
        Text="{DynamicResource HomeInProgressEmpty}"
        TextWrapping="Wrap" />
    <ListBox
        x:Name="InProgressRail"
        Grid.Row="1"
        Classes="poster-rail"
        Margin="0,8,0,0"
        IsVisible="{Binding HasInProgress}"
        ItemsSource="{Binding InProgress}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource HomeInProgressHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:InProgressItemViewModel">
          <!--
          PosterCardView draws the bar at the foot of the artwork, which is where §4 asks for it. The
          percentage stays here in words, so the bar is never the only carrier of how far this got.
          -->
          <StackPanel Spacing="{DynamicResource Space8}">
            <library:PosterCardView />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
              <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding CompletedText}" />
              <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{DynamicResource HomePercentSuffix}" />
            </StackPanel>
            <library:UnavailableBadge HorizontalAlignment="Left" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

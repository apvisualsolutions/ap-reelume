<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.InProgressRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeInProgressAccessibleName}">
  <Grid RowDefinitions="Auto,*">
    <!--
      A heading and the line the prototype writes beside it. The way into the library used to be
      here; it moved to the rail below on 2026-08-25, which is where the prototype keeps it — «Ver
      toda la biblioteca ›» at the right of "Añadido recientemente". The focus fallback moved with
      it rather than being left pointing at a control that is no longer on this rail.
    -->
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource HomeInProgressHeading}"
          automation:AutomationProperties.HeadingLevel="2" />
      <!--
        The prototype's second line on a rail heading: what the rail is for, in the quiet colour,
        beside the heading rather than under it.
      -->
      <TextBlock
          VerticalAlignment="Bottom"
          Margin="0,0,0,3"
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource HomeInProgressSubheading}" />
    </StackPanel>
    <TextBlock
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasInProgress}"
        Text="{DynamicResource HomeInProgressEmpty}"
        TextWrapping="Wrap" />
    <ListBox
        x:Name="InProgressRail"
        Grid.Row="1"
        Classes="poster-rail"
        Margin="0,8,0,0"
        IsVisible="{Binding HasInProgress}"
        ItemsSource="{Binding InProgress}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource HomeInProgressHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:InProgressItemViewModel">
          <home:ContinueCardView />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

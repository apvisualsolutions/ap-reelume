<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeAccessibleName}">
  <!--
  One column, and the rows are separated by the largest step in the scale: Home is a stack of
  independent blocks — hero, library, rails — and at Space12 the rails read as part of whatever is
  above them. The hero is the only accented action on the screen, so nothing else competes with it.

  Every row is Auto and the page scrolls, which it did not until the cards became 2:3. The in-progress
  rail used to take the star and everything under it was drawn past the bottom of the window:
  measured on 2026-08-22 at 1600x1000, "Añadido recientemente" and the suggestions rail were not on
  the screen at all, and the rail that did have the space showed half of each card. A star row
  distributes what is left over, which is the wrong question for a stack that is taller than its
  window — there is nothing left over, and the rows that follow it need somewhere to go.
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource Space24}">
      <TextBlock
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource HomeTitle}"
          automation:AutomationProperties.HeadingLevel="1" />
      <home:ResumeHeroView x:Name="ResumeHero" Grid.Row="1" />
      <home:InProgressRailView x:Name="InProgress" Grid.Row="2" />
      <home:RecentlyAddedRailView Grid.Row="3" />
      <ContentControl Grid.Row="4" IsVisible="{Binding HasRecommendationsRail}">
        <home:RecommendationsRailView DataContext="{Binding Recommendations}" />
      </ContentControl>
    </Grid>
  </ScrollViewer>
</UserControl>

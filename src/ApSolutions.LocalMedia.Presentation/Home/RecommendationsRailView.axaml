<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.RecommendationsRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    x:DataType="home:RecommendationsViewModel"
    automation:AutomationProperties.Name="{DynamicResource RecommendationsAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="ReasonTextConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space8}">
    <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space8}">
      <TextBlock
          VerticalAlignment="Center"
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource RecommendationsHeading}"
          automation:AutomationProperties.HeadingLevel="2" />
      <Button
          VerticalAlignment="Center"
          Command="{Binding ToggleCommand}"
          Content="{DynamicResource RecommendationsToggleAction}"
          automation:AutomationProperties.Name="{DynamicResource RecommendationsToggleAction}" />
      <TextBlock
          VerticalAlignment="Center"
          IsVisible="{Binding IsEnabled}"
          Text="{DynamicResource RecommendationsOn}" />
      <TextBlock
          VerticalAlignment="Center"
          IsVisible="{Binding IsDisabled}"
          Text="{DynamicResource RecommendationsOff}" />
    </WrapPanel>

    <!--
    Three states, and the two quiet ones are not the same sentence. Empty means the formula ran over
    the catalogue and ranked nothing; switched off means GetRecommendations returned before reading
    anything, so "there is nothing to suggest" would be a claim about a catalogue nobody looked at.
    -->
    <TextBlock
        Grid.Row="1"
        IsVisible="{Binding IsEmpty}"
        Text="{DynamicResource RecommendationsEmpty}"
        TextWrapping="Wrap" />

    <TextBlock
        Grid.Row="1"
        IsVisible="{Binding IsDisabled}"
        Text="{DynamicResource RecommendationsOffDescription}"
        TextWrapping="Wrap" />

    <ListBox
        Grid.Row="1"
        IsVisible="{Binding HasRecommendations}"
        ItemsSource="{Binding Items}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource RecommendationsHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:RecommendationItemViewModel">
          <Border Width="220" Padding="12">
            <StackPanel Spacing="{DynamicResource Space4}">
              <TextBlock
                  FontWeight="SemiBold"
                  Text="{Binding Title}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  FontSize="{DynamicResource FontSizeCaption}"
                  IsVisible="{Binding HasReasons}"
                  Text="{DynamicResource RecommendationsWhyLabel}" />
              <ItemsControl ItemsSource="{Binding ReasonKeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Text="{Binding Converter={StaticResource ReasonTextConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

<!--
The hero, and it is not painted at all when there is nothing to continue - IsVisible on the root, not
a placeholder saying so, because "nothing to resume" is the state of somebody who has finished
everything and it does not need a sentence.

It bleeds now, the way the prototype's does. The reason it did not — "there is no artwork in this
application" — expired the day PosterArt shipped: the prototype's own hero is the same synthetic
gradient, not a picture, so the wall of colour behind this text is exactly what the reference draws.
The ground under everything is PlayerSurfaceBrush, the one surface that is #0B0D10 in all four
themes: the hero is a frame of film in the prototype's grammar, the player's text brushes already
carry measured contrast on it (19,46:1), and in the two high contrasts the art layer switches off
through PosterArtOpacity and the text stands on the plain dark ground — no new brush anywhere.

One thing the prototype's hero has and this one still does not: the second action. §4 offers
"Details" beside Continue, and it is blocked on data rather than on effort: opening a title's card
needs a CatalogItem, ResumeItem carries neither the year nor the availability one holds, and no read
model in this tree answers "give me the item with this id". Building one out of what the hero knows
would be inventing two fields. It is a vertical through three layers for a secondary button.
-->
<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.ResumeHeroView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    x:DataType="home:HomeViewModel"
    IsVisible="{Binding HasResume}"
    automation:AutomationProperties.Name="{DynamicResource HomeResumeAccessibleName}">
  <UserControl.Resources>
    <library:PosterArtConverter x:Key="HeroArt" />
  </UserControl.Resources>
  <Border ClipToBounds="True" CornerRadius="{DynamicResource CornerRadiusMedium}">
    <Panel Background="{DynamicResource PlayerSurfaceBrush}">
      <!--
        The bleed: the title's own art wall, and over it the prototype's directional veil so the
        text's left edge always sits on something dark whatever hue the hash dealt. Both live under
        the opacity token that is 0 in the two high contrasts — a hue picked by a hash is a contrast
        ratio nobody decided, and there the plain dark ground is the whole picture.
      -->
      <Panel Opacity="{DynamicResource PosterArtOpacity}">
        <Border Background="{Binding ResumeTitle, Converter={StaticResource HeroArt}}" />
        <Border Background="{Binding ResumeTitle, Converter={StaticResource HeroArt}, ConverterParameter=glow}" />
        <Border Background="{DynamicResource PosterHatchBrush}" />
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#F2090C10" />
              <GradientStop Offset="0.55" Color="#B8090C10" />
              <GradientStop Offset="1" Color="#30090C10" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Panel>
      <StackPanel Margin="32" Spacing="{DynamicResource Space16}">
      <!--
        The overline: caption size and the secondary colour, which is how the prototype labels a
        section without spending a heading level on it. Its letter-spacing is left out on purpose -
        it would be a scalar with exactly one reader, which is this repository's characteristic
        defect wearing a tidy name, and ScalarTokenTests reads LetterSpacing as a spacing anyway. It
        arrives with the second overline. The words are the ones that were already written: rewriting
        a label is renaming a control in this tree.
      -->
      <TextBlock
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource PlayerTextSecondaryBrush}"
          Text="{DynamicResource HomeResumeHeading}" />
      <!--
        Display size and Light weight: the prototype writes this at 52 px and weight 300, and the
        scale tops out at 32. A FontSizeHero read by this one TextBlock is the shape FontSizeMono was
        refused for, so what carries the difference is the weight and the space around it, both of
        which are free.
      -->
      <TextBlock
          FontSize="{DynamicResource FontSizeDisplay}"
          FontWeight="Light"
          Foreground="{DynamicResource PlayerTextBrush}"
          Text="{Binding ResumeTitle}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          Foreground="{DynamicResource PlayerTextSecondaryBrush}"
          IsVisible="{Binding HasResumeSubtitle}"
          Text="{Binding ResumeSubtitle}"
          TextTrimming="CharacterEllipsis" />
      <!--
        One bar, 3 px like every other progress rule in this application, and the percentage in words
        beside it so the bar is never the only carrier. MinHeight and MinWidth both go with their
        setter: the base ControlTheme has a minimum of each, and Height alone measures 4.
      -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
        <ProgressBar
            Width="300"
            Height="3"
            MinHeight="3"
            MinWidth="0"
            VerticalAlignment="Center"
            Background="{DynamicResource PlayerHairlineBrush}"
            Foreground="{DynamicResource AccentBrush}"
            Maximum="1"
            Value="{Binding ResumeCompletedFraction}"
            automation:AutomationProperties.Name="{DynamicResource HomeResumeProgressLabel}" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource PlayerTextSecondaryBrush}"
            Text="{Binding ResumeCompletedText}" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource PlayerTextSecondaryBrush}"
            Text="{DynamicResource HomePercentSuffix}" />
      </StackPanel>
      <!--
        A WrapPanel with one child, because the row of actions is what this repository has measured
        eight times: a horizontal StackPanel offers its children infinite width, and the second action
        arrives here the day the read model can answer for it.
      -->
      <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space8}">
        <Button
            x:Name="ResumeHeroAction"
            Classes="primary-action"
            Command="{Binding ResumeCommand}"
            Content="{DynamicResource HomeResumeAction}"
            automation:AutomationProperties.Name="{DynamicResource HomeResumeAction}" />
      </WrapPanel>
      </StackPanel>
    </Panel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Home.RecentlyAddedRailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    x:DataType="home:HomeViewModel"
    automation:AutomationProperties.Name="{DynamicResource HomeRecentlyAddedAccessibleName}">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Text="{DynamicResource HomeRecentlyAddedHeading}"
          automation:AutomationProperties.HeadingLevel="2" />
      <!--
        The way into the library, which the prototype writes at the right of THIS heading rather
        than the one above: «Ver toda la biblioteca ›», as a link with a chevron and no fill. It
        keeps the control name it had on the other rail, so the walk and the focus fallback find the
        same control they always did — only the rail it belongs to changed.
      -->
      <Button
          x:Name="LibraryEntryAction"
          Grid.Column="1"
          Classes="link-action"
          VerticalAlignment="Center"
          automation:AutomationProperties.Name="{DynamicResource HomeLibraryAction}"
          Command="{Binding OpenLibraryCommand}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource HomeLibraryAction}" />
          <Path Classes="icon size-14" VerticalAlignment="Center" Data="{DynamicResource IconChevronRight}" />
        </StackPanel>
      </Button>
    </Grid>
    <TextBlock
        Grid.Row="1"
        Margin="0,8,0,0"
        IsVisible="{Binding !HasRecentlyAdded}"
        Text="{DynamicResource HomeRecentlyAddedEmpty}"
        TextWrapping="Wrap" />
    <ListBox
        x:Name="RecentlyAddedRail"
        Grid.Row="1"
        Classes="poster-rail"
        Margin="0,8,0,0"
        IsVisible="{Binding HasRecentlyAdded}"
        ItemsSource="{Binding RecentlyAdded}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        automation:AutomationProperties.Name="{DynamicResource HomeRecentlyAddedHeading}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="home:RecentlyAddedItemViewModel">
          <!--
          The card is PosterCardView and the badge stays outside it: whether a medium is reachable is
          something this rail knows and the suggestions rail does not, so the card never claims it.
          -->
          <StackPanel Spacing="{DynamicResource Space8}">
            <library:PosterCardView Classes="glyph-chip" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

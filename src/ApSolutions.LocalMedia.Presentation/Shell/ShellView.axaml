<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Shell.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:about="clr-namespace:ApSolutions.LocalMedia.Presentation.About"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:backup="clr-namespace:ApSolutions.LocalMedia.Presentation.Backup"
    xmlns:navigation="clr-namespace:ApSolutions.LocalMedia.Presentation.Navigation"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:library="clr-namespace:ApSolutions.LocalMedia.Presentation.Library"
    xmlns:metadata="clr-namespace:ApSolutions.LocalMedia.Presentation.Metadata"
    xmlns:onboarding="clr-namespace:ApSolutions.LocalMedia.Presentation.Onboarding"
    xmlns:player="clr-namespace:ApSolutions.LocalMedia.Presentation.Player"
    xmlns:review="clr-namespace:ApSolutions.LocalMedia.Presentation.Review"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    xmlns:shell="clr-namespace:ApSolutions.LocalMedia.Presentation.Shell"
    xmlns:updates="clr-namespace:ApSolutions.LocalMedia.Presentation.Updates"
    x:DataType="shell:ShellViewModel"
    automation:AutomationProperties.Name="{DynamicResource ShellAccessibleName}">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelAddMediaCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Resources>
    <navigation:RouteStateConverter x:Key="RouteStatus" Kind="Status" />
    <navigation:RouteStateConverter x:Key="RouteIsCurrent" Kind="IsCurrent" />
  </UserControl.Resources>
  <Grid Background="{DynamicResource ShellSurfaceBrush}" RowDefinitions="44,*" ColumnDefinitions="64,*">
    <!--
      The prototype's accent tint: a 260 px halo breathing from the top-left of the content, so the
      ground is never a flat sheet. No new brush pays for it — it is AccentBrush itself at the
      prototype's strength under a radial opacity mask, inside the same opacity token that switches
      the poster art off in both high contrasts, where a decorative glow is exactly the kind of
      colour the theme exists to remove. Hit-test invisible: a glow is not something to press.
    -->
    <Panel
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        VerticalAlignment="Top"
        Height="260"
        IsHitTestVisible="False"
        Opacity="{DynamicResource PosterArtOpacity}">
      <Border Background="{DynamicResource AccentBrush}" Opacity="0.156">
        <Border.OpacityMask>
          <RadialGradientBrush Center="10%,0%" GradientOrigin="10%,0%" RadiusX="120%" RadiusY="100%">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="0.7" Color="#00FFFFFF" />
          </RadialGradientBrush>
        </Border.OpacityMask>
      </Border>
    </Panel>
    <!--
      The application's own title bar, 44 px, which is what the prototype puts above everything: one
      unbroken surface from the top of the window down, instead of a system caption sitting on top of
      a different colour. Windows keeps drawing minimise, maximise, close and the window's title over
      it, so this adds no control anybody has to press and the walk's inventory is untouched.

      It holds nothing of its own, and that is the point. Windows draws the product's name and the
      three window buttons over it, so anything the shell painted here would be a second copy of one
      or sit underneath the other. The brand and the publisher's signature, which used to be at the
      foot of a 248 px rail, moved to Credits — the screen that is about the application, and the one
      that carries TMDB's logo, whose terms want it less prominent than the product's own name.

      The name also stopped being a level-one heading with that move: the shell declared it while
      every screen inside declared its own, which is the two-H1 shape the settings page was fixed for.
      The heading of a screen is the name of the screen.
    -->
    <Border
        x:Name="TitleBarSurface"
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Background="{DynamicResource NavigationSurfaceBrush}"
        BorderBrush="{DynamicResource ShellHairlineBrush}"
        BorderThickness="0,0,0,1" />
    <!--
      The rail: 64 px of glyphs where there were 248 px of words. It is the composition the prototype
      was approved at, and the trade it makes is written down - a word tells somebody what a
      destination is without them having to know a pictogram, so the words stay in
      AutomationProperties.Name and in the tooltip, and the glyph is what the eye lands on.
    -->
    <Border
        Grid.Row="1"
        Padding="9,8"
        Background="{DynamicResource NavigationSurfaceBrush}"
        BorderBrush="{DynamicResource ShellHairlineBrush}"
        BorderThickness="0,0,1,0">
      <DockPanel automation:AutomationProperties.Name="{DynamicResource MainNavigationAccessibleName}">
        <!--
          "Add media" at the foot, which is where the prototype puts it and what somebody opening this
          application with an empty library needs first. It is declared before the destinations
          because a DockPanel gives its bands away in declaration order and the last child takes what
          is left; written after them it would be handed the whole rail and the five would have
          nowhere to go.

          It is an action and not a sixth destination, and that is a decision rather than a shortcut:
          AppRoute is asserted to hold exactly five names, and the surface where a folder is added
          lives inside the library rather than on a route of its own. So this presses through
          AddMediaCommand, which goes to that surface AND clears the form - the path, the refusal and
          any half-finished removal - because "add media" means start adding, not go to the library.
          Without the clearing it would be a second button doing what Biblioteca already does, and
          this tree has a name for that.
        -->
        <Button
            x:Name="AddMediaAction"
            Classes="navigation-action"
            DockPanel.Dock="Bottom"
            ToolTip.Tip="{DynamicResource NavigationAddMedia}"
            automation:AutomationProperties.Name="{DynamicResource NavigationAddMedia}"
            Command="{Binding AddMediaCommand}">
          <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconAdd}" />
        </Button>
        <StackPanel
            VerticalAlignment="Top"
            Spacing="{DynamicResource Space8}">
          <Button
              Classes="navigation-destination"
              ToolTip.Tip="{DynamicResource NavigationHome}"
              automation:AutomationProperties.Name="{DynamicResource NavigationHome}"
              automation:AutomationProperties.ItemStatus="{Binding CurrentRoute, Converter={StaticResource RouteStatus}, ConverterParameter={x:Static navigation:AppRoute.Home}}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Static navigation:AppRoute.Home}">
            <Panel>
              <!--
                Two signals for the open destination, and one of them is not colour: the fill, and a
                3 px bar that is present or absent rather than tinted. Absent is not dimmed.
              -->
              <Border
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Home}}" />
              <Border
                  Classes="navigation-current-bar"
                  Width="3"
                  Margin="0,7"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Home}}" />
              <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconHome}" />
            </Panel>
          </Button>
          <Button
              Classes="navigation-destination"
              ToolTip.Tip="{DynamicResource NavigationLibrary}"
              automation:AutomationProperties.Name="{DynamicResource NavigationLibrary}"
              automation:AutomationProperties.ItemStatus="{Binding CurrentRoute, Converter={StaticResource RouteStatus}, ConverterParameter={x:Static navigation:AppRoute.Library}}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Static navigation:AppRoute.Library}">
            <Panel>
              <!--
                Two signals for the open destination, and one of them is not colour: the fill, and a
                3 px bar that is present or absent rather than tinted. Absent is not dimmed.
              -->
              <Border
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Library}}" />
              <Border
                  Classes="navigation-current-bar"
                  Width="3"
                  Margin="0,7"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Library}}" />
              <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconLibrary}" />
            </Panel>
          </Button>
          <Button
              Classes="navigation-destination"
              ToolTip.Tip="{DynamicResource NavigationReview}"
              automation:AutomationProperties.Name="{DynamicResource NavigationReview}"
              automation:AutomationProperties.ItemStatus="{Binding CurrentRoute, Converter={StaticResource RouteStatus}, ConverterParameter={x:Static navigation:AppRoute.Review}}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Static navigation:AppRoute.Review}">
            <Panel>
              <!--
                Two signals for the open destination, and one of them is not colour: the fill, and a
                3 px bar that is present or absent rather than tinted. Absent is not dimmed.
              -->
              <Border
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Review}}" />
              <Border
                  Classes="navigation-current-bar"
                  Width="3"
                  Margin="0,7"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Review}}" />
              <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconReview}" />
            </Panel>
          </Button>
          <!--
            Duplicados, which the prototype gives the rail's fourth slot. Copias left the rail for
            Settings on 2026-08-23: a destination is for a place somebody visits, and a backup is a
            decision somebody configures.
          -->
          <Button
              Classes="navigation-destination"
              ToolTip.Tip="{DynamicResource NavigationDuplicates}"
              automation:AutomationProperties.Name="{DynamicResource NavigationDuplicates}"
              automation:AutomationProperties.ItemStatus="{Binding CurrentRoute, Converter={StaticResource RouteStatus}, ConverterParameter={x:Static navigation:AppRoute.Duplicates}}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Static navigation:AppRoute.Duplicates}">
            <Panel>
              <!--
                Two signals for the open destination, and one of them is not colour: the fill, and a
                3 px bar that is present or absent rather than tinted. Absent is not dimmed.
              -->
              <Border
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Duplicates}}" />
              <Border
                  Classes="navigation-current-bar"
                  Width="3"
                  Margin="0,7"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Duplicates}}" />
              <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconDuplicates}" />
            </Panel>
          </Button>
          <Button
              Classes="navigation-destination"
              ToolTip.Tip="{DynamicResource NavigationSettings}"
              automation:AutomationProperties.Name="{DynamicResource NavigationSettings}"
              automation:AutomationProperties.ItemStatus="{Binding CurrentRoute, Converter={StaticResource RouteStatus}, ConverterParameter={x:Static navigation:AppRoute.Settings}}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Static navigation:AppRoute.Settings}">
            <Panel>
              <!--
                Two signals for the open destination, and one of them is not colour: the fill, and a
                3 px bar that is present or absent rather than tinted. Absent is not dimmed.
              -->
              <Border
                  Background="{DynamicResource AccentSubtleBrush}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Settings}}" />
              <Border
                  Classes="navigation-current-bar"
                  Width="3"
                  Margin="0,7"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="{DynamicResource CornerRadiusSmall}"
                  IsVisible="{Binding CurrentRoute, Converter={StaticResource RouteIsCurrent}, ConverterParameter={x:Static navigation:AppRoute.Settings}}" />
              <Path Classes="icon size-20 navigation-glyph" Data="{DynamicResource IconSettings}" />
            </Panel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid
        Grid.Row="1"
        Grid.Column="1"
        Margin="48"
        IsVisible="{Binding IsPrimaryContentVisible}"
        RowDefinitions="Auto,Auto,*">
      <TextBlock
          FontSize="{DynamicResource FontSizeDisplay}"
          FontWeight="SemiBold"
          Text="{DynamicResource WelcomeTitle}" />
      <TextBlock
          Grid.Row="1"
          MaxWidth="680"
          Margin="0,14,0,0"
          FontSize="{DynamicResource FontSizeBody}"
          Text="{DynamicResource WelcomeDescription}"
          TextWrapping="Wrap" />
      <Border
          Grid.Row="2"
          Margin="0,36,0,0"
          Padding="28"
          Background="{DynamicResource CardSurfaceBrush}"
          CornerRadius="{DynamicResource CornerRadiusMedium}"
          automation:AutomationProperties.Name="{DynamicResource CurrentAreaAccessibleName}">
        <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Space12}">
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="{DynamicResource FontSizeSubtitle}"
              FontWeight="SemiBold"
              Text="{DynamicResource EmptyLibraryTitle}" />
          <TextBlock
              MaxWidth="520"
              HorizontalAlignment="Center"
              Text="{DynamicResource EmptyLibraryDescription}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <ContentControl
        Grid.Row="1"
        Grid.Column="1"
        IsVisible="{Binding IsHomeVisible}">
      <home:HomeView DataContext="{Binding Home}" />
    </ContentControl>
    <!--
      Settings, as the prototype's page: the heading, a fixed side index, and one section at a time
      on the right. §7's construction to the letter — no sticky, a Grid whose ScrollViewer lives
      only in the right column — and the side-list styles that were declared in the theme with no
      consumer finally get their consumer, which is the house defect run backwards.

      One section at a time is a visibility decision with a measured trap behind it: a section that
      is not open is NOT in the visual tree, so every walk scene that presses inside one opens it
      through the index first — the same press a person makes, and the press that proves the index.
    -->
    <Grid
        x:Name="SettingsPage"
        Grid.Row="1"
        Grid.Column="1"
        RowDefinitions="Auto,Auto,*"
        IsVisible="{Binding IsSettingsVisible}">
      <TextBlock
          Margin="48,32,48,0"
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource NavigationSettings}"
          automation:AutomationProperties.HeadingLevel="1" />
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <ListBox
            x:Name="SettingsIndex"
            Classes="side-list"
            MinWidth="200"
            Margin="48,24,0,24"
            VerticalAlignment="Top"
            SelectedValue="{Binding CurrentSettingsSection}"
            SelectedValueBinding="{ReflectionBinding Tag}"
            automation:AutomationProperties.Name="{DynamicResource SettingsIndexAccessibleName}">
          <ListBoxItem
              Content="{DynamicResource AppearanceTitle}"
              Tag="{x:Static shell:SettingsSection.Appearance}"
              automation:AutomationProperties.Name="{DynamicResource AppearanceTitle}" />
          <ListBoxItem
              Content="{DynamicResource SettingsSectionLibrary}"
              IsVisible="{Binding HasLibrarySection}"
              Tag="{x:Static shell:SettingsSection.Library}"
              automation:AutomationProperties.Name="{DynamicResource SettingsSectionLibrary}" />
          <ListBoxItem
              Content="{DynamicResource RecommendationSettingsTitle}"
              IsVisible="{Binding HasRecommendationSettings}"
              Tag="{x:Static shell:SettingsSection.Recommendations}"
              automation:AutomationProperties.Name="{DynamicResource RecommendationSettingsTitle}" />
          <ListBoxItem
              Content="{DynamicResource SubtitleStyleAccessibleName}"
              IsVisible="{Binding HasSubtitleStyle}"
              Tag="{x:Static shell:SettingsSection.Subtitles}"
              automation:AutomationProperties.Name="{DynamicResource SubtitleStyleAccessibleName}" />
          <ListBoxItem
              Content="{DynamicResource SegmentDetectionSettingsTitle}"
              IsVisible="{Binding HasSegmentDetection}"
              Tag="{x:Static shell:SettingsSection.SegmentDetection}"
              automation:AutomationProperties.Name="{DynamicResource SegmentDetectionSettingsTitle}" />
          <ListBoxItem
              Content="{DynamicResource ShortcutSettingsAccessibleName}"
              IsVisible="{Binding HasShortcuts}"
              Tag="{x:Static shell:SettingsSection.Shortcuts}"
              automation:AutomationProperties.Name="{DynamicResource ShortcutSettingsAccessibleName}" />
          <ListBoxItem
              Content="{DynamicResource LifecycleSettingsTitle}"
              IsVisible="{Binding HasLifecycleSettings}"
              Tag="{x:Static shell:SettingsSection.Lifecycle}"
              automation:AutomationProperties.Name="{DynamicResource LifecycleSettingsTitle}" />
          <ListBoxItem
              Content="{DynamicResource PrivacyTitle}"
              IsVisible="{Binding HasPrivacySettings}"
              Tag="{x:Static shell:SettingsSection.Privacy}"
              automation:AutomationProperties.Name="{DynamicResource PrivacyTitle}" />
          <ListBoxItem
              Content="{DynamicResource NavigationBackups}"
              Tag="{x:Static shell:SettingsSection.Backups}"
              automation:AutomationProperties.Name="{DynamicResource NavigationBackups}" />
          <ListBoxItem
              Content="{DynamicResource UpdateTitle}"
              IsVisible="{Binding HasUpdates}"
              Tag="{x:Static shell:SettingsSection.Updates}"
              automation:AutomationProperties.Name="{DynamicResource UpdateTitle}" />
          <ListBoxItem
              Content="{DynamicResource AboutCreditsHeading}"
              Tag="{x:Static shell:SettingsSection.Credits}"
              automation:AutomationProperties.Name="{DynamicResource AboutCreditsHeading}" />
        </ListBox>
        <ScrollViewer Grid.Column="1">
          <StackPanel x:Name="SettingsSections" Margin="0,24,0,24" Spacing="{DynamicResource Space24}">
            <ContentControl Margin="48,0" IsVisible="{Binding IsAppearanceSection}">
              <settings:AppearanceSettingsView DataContext="{Binding AppearanceSettings}" />
            </ContentControl>
            <!--
              The folders ahead of the switches that govern scanning them, which is the prototype's
              «Biblioteca y escaneo» order. The list shares the onboarding's model — one list, two
              surfaces, never both on screen: this one lives on the Settings route.
            -->
            <ContentControl IsVisible="{Binding IsLibrarySection}">
              <StackPanel Spacing="{DynamicResource Space24}">
                <ContentControl Margin="48,0" IsVisible="{Binding HasOnboarding}">
                  <settings:RootManagementView DataContext="{Binding Onboarding}" />
                </ContentControl>
                <ContentControl Margin="48,0" IsVisible="{Binding HasScanSettings}">
                  <settings:ScanSettingsView DataContext="{Binding ScanSettings}" />
                </ContentControl>
              </StackPanel>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsRecommendationsSection}">
              <ContentControl IsVisible="{Binding HasRecommendationSettings}">
                <settings:RecommendationSettingsView DataContext="{Binding RecommendationSettings}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsSubtitlesSection}">
              <ContentControl IsVisible="{Binding HasSubtitleStyle}">
                <player:SubtitleStyleView DataContext="{Binding SubtitleStyle}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsSegmentDetectionSection}">
              <ContentControl IsVisible="{Binding HasSegmentDetection}">
                <settings:SegmentDetectionSettingsView DataContext="{Binding SegmentDetection}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsShortcutsSection}">
              <ContentControl IsVisible="{Binding HasShortcuts}">
                <player:ShortcutSettingsView DataContext="{Binding Shortcuts}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsLifecycleSection}">
              <ContentControl IsVisible="{Binding HasLifecycleSettings}">
                <settings:LifecycleSettingsView DataContext="{Binding LifecycleSettings}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsPrivacySection}">
              <ContentControl IsVisible="{Binding HasPrivacySettings}">
                <settings:PrivacySettingsView DataContext="{Binding PrivacySettings}" />
              </ContentControl>
            </ContentControl>
            <ContentControl IsVisible="{Binding IsBackupsSection}">
              <!--
                The section skeleton its peers share — Padding 32, the 620 column — so the Copias
                title starts where every section title starts. The two views keep their own inner
                shapes; the frame is the page's.
              -->
              <Border Padding="32">
                <StackPanel MaxWidth="620" Spacing="{DynamicResource Space24}">
                  <backup:BackupView DataContext="{Binding Backups}" />
                  <ContentControl IsVisible="{Binding HasRestore}">
                    <backup:RestoreWizardView DataContext="{Binding Restore}" />
                  </ContentControl>
                </StackPanel>
              </Border>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsUpdatesSection}">
              <ContentControl IsVisible="{Binding HasUpdates}">
                <updates:UpdateView DataContext="{Binding Updates}" />
              </ContentControl>
            </ContentControl>
            <ContentControl Margin="48,0" IsVisible="{Binding IsCreditsSection}">
              <about:CreditsView x:Name="CreditsSurface" />
            </ContentControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <ScrollViewer
        Grid.Row="1"
        Grid.Column="1"
        Margin="48"
        IsVisible="{Binding IsLibraryVisible}">
      <!--
        The bottom margin is a control's right to be pressed. Measured on 2026-08-22 in the walk's
        1600x1000 window: the scrolled content ran to 927 px inside a 904 px viewport, and Review
        versions - the last button on the route - sat at y=939 with a height of 36. Thirteen of its
        pixels were inside the viewport and its middle was not, so a person could see the button and
        a click on it reached the shell behind. The scroll had 23 px of travel for a control that
        needed 23, and BringIntoView left it exactly where it started.

        A stack whose last child ends flush with the viewport edge is one layout change away from
        this every time; the folder panel above it grew by 25 px and that was the whole distance.
      -->
      <StackPanel Margin="0,0,0,24" Spacing="{DynamicResource Space24}">
        <ContentControl IsVisible="{Binding ShowsOnboarding}">
          <onboarding:RootOnboardingView DataContext="{Binding Onboarding}" />
        </ContentControl>
        <library:LibraryView DataContext="{Binding Library}" />
        <!--
          A WrapPanel and not a horizontal StackPanel: three buttons carrying translated words is the
          shape that has drawn a control off the side seven times in this repository, and §4 asks for
          this one by name.
        -->
        <WrapPanel
            x:Name="TitleActionsSurface"
            ItemSpacing="{DynamicResource Space8}"
            LineSpacing="{DynamicResource Space8}"
            automation:AutomationProperties.Name="{DynamicResource TitleActionsAccessibleName}">
          <Button
              automation:AutomationProperties.Name="{DynamicResource TitleEditMetadataAction}"
              Command="{Binding EditMetadataCommand}"
              Content="{DynamicResource TitleEditMetadataAction}" />
          <Button
              automation:AutomationProperties.Name="{DynamicResource TitlePreviewRenameAction}"
              Command="{Binding PreviewRenameCommand}"
              Content="{DynamicResource TitlePreviewRenameAction}" />
          <Button
              automation:AutomationProperties.Name="{DynamicResource TitleReviewDuplicatesAction}"
              Command="{Binding ReviewDuplicatesCommand}"
              Content="{DynamicResource TitleReviewDuplicatesAction}" />
        </WrapPanel>
        <!--
          The owner's fifth point: the two title tools share one panel behind real tabs, the way the
          player's side column holds its four lists. Each door selects its own tab as it opens; a
          tab whose surface is not open hides its header rather than offering a blank page.
        -->
        <ContentControl IsVisible="{Binding HasEditorPanel}">
          <TabControl SelectedIndex="{Binding EditorTab}">
            <TabItem
                Header="{DynamicResource MetadataEditorTabLabel}"
                IsVisible="{Binding HasMetadataEditor}">
              <metadata:MetadataEditorView DataContext="{Binding MetadataEditor}" Margin="0,12,0,0" />
            </TabItem>
            <TabItem
                Header="{DynamicResource RenamePreviewTabLabel}"
                IsVisible="{Binding HasRename}">
              <metadata:RenamePreviewView DataContext="{Binding Rename}" Margin="0,12,0,0" />
            </TabItem>
          </TabControl>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer
        Grid.Row="1"
        Grid.Column="1"
        Margin="48"
        IsVisible="{Binding IsReviewVisible}">
      <StackPanel Spacing="{DynamicResource Space24}">
        <review:ReviewInboxView DataContext="{Binding ReviewInbox}" />
      </StackPanel>
    </ScrollViewer>
    <!--
      The duplicates destination: the overview always, and under it the comparison the review has
      always drawn, opened by a row the way the film card's own action opens it. The library's
      pattern — list above, detail below — on the rail's fourth slot.
    -->
    <ScrollViewer
        Grid.Row="1"
        Grid.Column="1"
        Margin="48"
        IsVisible="{Binding IsDuplicatesVisible}">
      <StackPanel Margin="0,0,0,24" Spacing="{DynamicResource Space24}">
        <review:DuplicatesOverviewView DataContext="{Binding DuplicatesOverview}" />
        <ContentControl IsVisible="{Binding HasDuplicates}">
          <review:DuplicateReviewView DataContext="{Binding Duplicates}" />
        </ContentControl>
      </StackPanel>
    </ScrollViewer>

    <!--
      The add-root dialog, over everything but a running session: the scrim covers the rail and the
      title row too, because while a modal question is open the rest of the application is not an
      offer. Both dimensions of the panel inside are bounded — the overlay that declared neither
      was measured at 1280x1400, opaque over the transport.
    -->
    <Panel
        x:Name="AddRootDialogSurface"
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        IsVisible="{Binding IsAddingRoot}">
      <Border Background="{DynamicResource ScrimBrush}" />
      <onboarding:AddRootDialogView />
    </Panel>

    <Grid
        x:Name="PlayerSurface"
        Grid.Row="1"
        Grid.Column="1"
        Background="{DynamicResource PlayerSurfaceBrush}"
        ColumnDefinitions="*,Auto"
        RowDefinitions="Auto,*"
        IsVisible="{Binding IsPlayerVisible}"
        automation:AutomationProperties.Name="{DynamicResource PlayerSessionAccessibleName}">
      <!--
        The session leaves the rail alone, which is what the prototype draws: its player surface is
        `left: 64`, not `left: 0`. It used to span both columns and cover the rail, so opening a film
        took the whole application away and the five destinations with it. Nothing about a session
        means somebody has stopped being able to reach Settings.

        And the session's own header, which the prototype puts above the picture and this had
        nowhere: closing, the mini window and fullscreen were three buttons carrying words, stacked
        inside a 320 px column of panels, where the prototype puts three glyphs across the top.

        Only Content changed - the accessible names are the same resource keys, so a screen reader
        still hears "Cerrar el reproductor" and the walk still presses the same three identities. That
        is the move the navigation rail already made.

        What the prototype puts in the middle of this band and this cannot: the title of what is
        playing, its subtitle and the session badge. PlayerSurfaces does not carry a title and
        PlayerViewModel holds only MediaPath, and painting somebody's file path as a heading is the
        opposite of what this application is for. Declared rather than invented, which is what the
        recommendation card already does with the year it does not know.
      -->
      <!--
        Foreground on the container and not on each block: Avalonia inherits it, so this is what
        reaches the text that carries no brush of its own - and in Light that text was
        TextPrimaryBrush on a surface it reads 1.10:1 against, which is text nobody can see.
      -->
      <Border
          x:Name="PlayerHeaderSurface"
          Grid.Row="0"
          Grid.ColumnSpan="2"
          Padding="14,10"
          Background="{DynamicResource PlayerChromeBrush}"
          BorderBrush="{DynamicResource PlayerHairlineBrush}"
          BorderThickness="0,0,0,1"
          TextElement.Foreground="{DynamicResource PlayerTextBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button
              Grid.Column="0"
              Classes="player-chrome"
              automation:AutomationProperties.Name="{DynamicResource PlayerCloseAction}"
              ToolTip.Tip="{DynamicResource PlayerCloseAction}"
              Command="{Binding ClosePlayerCommand}">
            <Path Classes="icon size-20" Data="{DynamicResource IconClose}" />
          </Button>
          <!--
            A WrapPanel for two buttons, which is not about these two wrapping: it is the container
            this tree reaches for whenever a row of controls can grow, and the 44 px target area these
            take is exactly that kind of growth. The measurement behind the habit is on the column
            below.
          -->
          <WrapPanel
              Grid.Column="2"
              ItemSpacing="{DynamicResource Space8}"
              LineSpacing="{DynamicResource Space8}">
            <Button
                Classes="player-chrome"
                automation:AutomationProperties.Name="{DynamicResource PlayerMiniModeAction}"
                ToolTip.Tip="{DynamicResource PlayerMiniModeAction}"
                Command="{Binding ToggleMiniPlayerCommand}">
              <Path Classes="icon size-20" Data="{DynamicResource IconExitFullscreen}" />
            </Button>
            <Button
                Classes="player-chrome"
                automation:AutomationProperties.Name="{DynamicResource PlayerFullscreenAction}"
                ToolTip.Tip="{DynamicResource PlayerFullscreenAction}"
                Command="{Binding ToggleFullscreenCommand}">
              <Path Classes="icon size-20" Data="{DynamicResource IconFullscreen}" />
            </Button>
          </WrapPanel>
        </Grid>
      </Border>
      <!--
      Two rows and not one panel, and the banner is in the first of them. §4 asks that it not be drawn
      over the video, and there is a second reason the document could not see: PlayerStage is the
      control the shell hands to the mini player window and takes back, so anything inside it travels
      - and this banner asks for 336 px of height at the mini player's 480, in a window 270 tall.

      It sits beside PlayerHost rather than inside it, which is the trap: coming back from mini mode
      ShellView.axaml.cs runs host.Content = stage, so anything declared next to the stage inside that
      host is replaced by the stage on the first return and never comes back.
      -->
      <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
      <ContentControl Grid.Row="0" IsVisible="{Binding HasLooseFile}">
        <player:LooseFileBanner DataContext="{Binding Player.LooseFile}" />
      </ContentControl>
      <ContentControl Grid.Row="1" x:Name="PlayerHost">
        <Panel x:Name="PlayerStage">
        <player:PlayerView DataContext="{Binding Player.Player}" />
        <ContentControl IsVisible="{Binding HasVideoStatus}">
          <player:VideoStatusOverlay DataContext="{Binding Player.VideoStatus}" />
        </ContentControl>
        <ContentControl IsVisible="{Binding HasSkipMarker}">
          <player:SkipMarkerButton DataContext="{Binding Player.Skip}" />
        </ContentControl>
        <ContentControl IsVisible="{Binding HasNextEpisode}">
          <player:NextEpisodeOverlay DataContext="{Binding Player.NextEpisode}" />
        </ContentControl>
        <ContentControl IsVisible="{Binding HasResumePrompt}">
          <player:ResumePromptView DataContext="{Binding Player.Resume}" />
        </ContentControl>
        <ContentControl IsVisible="{Binding HasVersionSwitch}">
          <player:VersionSwitchDialog DataContext="{Binding Player.VersionSwitch}" />
        </ContentControl>
        </Panel>
      </ContentControl>
      </Grid>
      <!--
        The panel column: 320 px when it has something in it, and nothing at all when it does not. It
        used to take those 320 px whether or not one of its five panels existed, so a file with a
        single audio track, no markers and no other version left an empty rectangle holding a fifth of
        the picture's width. The grid's column is Auto and the width is the viewer's, which is what
        makes an invisible column measure zero rather than reserve its place.

        The three session buttons that used to head it moved to the header above, which is where the
        prototype draws them.

        And the column is switched now instead of stacked, which is what the prototype does: one panel
        at a time, chosen at the head of the column. Five tabs and not the prototype's four, because
        the four are its names for what this application keeps in five panels, and a tab that grouped
        two of them would need either a word nobody has approved or a sixth boolean on the shell. Each
        tab carries the name its own panel already declares.

        <b>No view model decides which one opens, and that is measured.</b> Avalonia 12.1.1 skips an
        invisible TabItem when it auto-selects — checked on 2026-08-22 with the first of three hidden,
        which opened on the second — so a session with no tracks opens on whatever it does have.

        The measurement that put the header's buttons in a WrapPanel is what the tab strip inherits:
        this column is 320 px by definition, these five names are a translator's, and a horizontal
        strip offers its children infinite width — Mini player sat at x=1737 in a 1600 px window on
        2026-08-16 and Fullscreen was further out still.
      -->
      <TabControl
          x:Name="PlayerPanelColumn"
          Classes="player-panels"
          Grid.Row="1"
          Grid.Column="1"
          Width="320"
          Background="{DynamicResource PlayerPanelBrush}"
          Foreground="{DynamicResource PlayerTextBrush}"
          IsVisible="{Binding HasPlayerPanels}">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem Header="{DynamicResource TrackSelectorAccessibleName}" IsVisible="{Binding HasTracks}">
          <ScrollViewer Padding="16">
            <player:TrackSelectorView DataContext="{Binding Player.Tracks}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource AudioOutputAccessibleName}" IsVisible="{Binding HasAudioOutput}">
          <ScrollViewer Padding="16">
            <player:AudioOutputView DataContext="{Binding Player.AudioOutput}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource MarkerEditorAccessibleName}" IsVisible="{Binding HasMarkers}">
          <ScrollViewer Padding="16">
            <player:MarkerEditorView DataContext="{Binding Player.Markers}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource DetectedMarkerReviewTitle}" IsVisible="{Binding HasDetectedReview}">
          <ScrollViewer Padding="16">
            <player:DetectedMarkerReviewView DataContext="{Binding Player.DetectedReview}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource PlayerVersionsTitle}" IsVisible="{Binding HasPlayerVersions}">
          <ScrollViewer Padding="16">
            <player:PlayerVersionsView DataContext="{Binding Player.Versions}" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Shell.StartupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    automation:AutomationProperties.Name="{DynamicResource StartupAccessibleName}">
  <!--
    No progress bar, on purpose: this screen stands for under a second on the disk this application
    targets, and a bar that appears and dies unread is motion without information - what takes long
    (the first scan) reports inside the shell, where its numbers mean something. The surface is the
    shell's own token, whose dark value is #08090C, and MSIX's static splash is set to the same
    colour so the seam between the two screens does not flash. The title bar stays the system's:
    the one window chrome decision of this application, taken once in App.axaml.cs, holds here too.
  -->
  <Border Padding="48" Background="{DynamicResource ShellSurfaceBrush}">
    <StackPanel
        MaxWidth="720"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource ProductDisplayName}" />
      <!--
        A status line and no progress bar. Nothing here knows how much is left, and a bar that
        moves without meaning anything is a picture of progress rather than progress.
      -->
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource StartupStatus}"
          TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>

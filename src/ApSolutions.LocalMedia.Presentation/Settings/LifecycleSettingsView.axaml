<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.LifecycleSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    x:DataType="settings:LifecycleSettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource LifecycleSettingsAccessibleName}">
  <!-- §4's skeleton for a settings section: the padded surface and the 620 reading column that every
       section on this page shares. Without it this one started 158 px to the left of the others. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
  <StackPanel x:Name="LifecycleSettingsSurface" MaxWidth="620" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource LifecycleSettingsTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource LifecycleSettingsDescription}"
        TextWrapping="Wrap" />

    <!--
      The prototype's row-card, and the three sentences this page already had are what goes in it. They
      were painted as loose lines under their checkbox - a switch, then a sentence about the switch,
      then the next switch - which reads as six things where there are three. Underneath the name is
      where the prototype puts the sentence, and it is the same string either way.
    -->
    <Border Classes="setting-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
          <TextBlock Classes="setting-name" Text="{DynamicResource LifecycleTrayLabel}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding TrayEnabled}"
              Text="{DynamicResource LifecycleTrayOn}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding TrayIsDisabled}"
              Text="{DynamicResource LifecycleTrayOff}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            VerticalAlignment="Center">
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding TrayEnabled}"
              Text="{DynamicResource SettingStateOn}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding TrayIsDisabled}"
              Text="{DynamicResource SettingStateOff}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <CheckBox
              x:Name="TrayEnabledCheckBox"
              IsChecked="{Binding TrayEnabled}"
              VerticalAlignment="Center"
              automation:AutomationProperties.Name="{DynamicResource LifecycleTrayLabel}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="setting-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
        <TextBlock
            Grid.Column="0"
            Classes="setting-name"
            Text="{DynamicResource LifecycleCloseToTrayLabel}"
            VerticalAlignment="Center" />
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            VerticalAlignment="Center">
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding MinimizeToTrayOnClose}"
              Text="{DynamicResource SettingStateOn}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding !MinimizeToTrayOnClose}"
              Text="{DynamicResource SettingStateOff}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <CheckBox
              x:Name="MinimizeToTrayCheckBox"
              IsChecked="{Binding MinimizeToTrayOnClose}"
              IsEnabled="{Binding CanMinimizeToTray}"
              VerticalAlignment="Center"
              automation:AutomationProperties.Name="{DynamicResource LifecycleCloseToTrayLabel}" />
        </StackPanel>
      </Grid>
    </Border>
    <!--
      A tray this system does not have is not a fact about the machine, it is a choice that could not
      be honoured - the same thing the three audio notices say - so it takes the same surface, border
      and glyph. The glyph is what keeps the signal off colour alone.

      A Grid and not a horizontal StackPanel: a stack offers its children infinite width, so wrapping
      text beside a glyph never wraps and runs off the side. Nine measurements of that shape here.
    -->
    <Border
        x:Name="TrayUnavailableNotice"
        Padding="12"
        Background="{DynamicResource WarningSurfaceBrush}"
        BorderBrush="{DynamicResource WarningBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        IsVisible="{Binding !CanMinimizeToTray}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Top"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="⚠" />
        <TextBlock
            Grid.Column="1"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource LifecycleCloseToTrayUnavailable}"
            TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Classes="setting-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
          <TextBlock Classes="setting-name" Text="{DynamicResource LifecycleStartupLabel}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding StartWithWindows}"
              Text="{DynamicResource LifecycleStartupOn}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding StartupIsDisabled}"
              Text="{DynamicResource LifecycleStartupOff}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            VerticalAlignment="Center">
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding StartWithWindows}"
              Text="{DynamicResource SettingStateOn}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding StartupIsDisabled}"
              Text="{DynamicResource SettingStateOff}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <CheckBox
              x:Name="StartWithWindowsCheckBox"
              IsChecked="{Binding StartWithWindows}"
              VerticalAlignment="Center"
              automation:AutomationProperties.Name="{DynamicResource LifecycleStartupLabel}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        x:Name="StartupConsentSurface"
        Padding="16"
        Background="{DynamicResource AccentSubtleBrush}"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        IsVisible="{Binding IsStartupConsentPending}"
        automation:AutomationProperties.Name="{DynamicResource LifecycleStartupConsentAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <StackPanel Spacing="{DynamicResource Space12}">
        <TextBlock
            MaxWidth="600"
            Text="{DynamicResource LifecycleStartupConsentDescription}"
            TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
          <Button
              x:Name="GrantStartupConsentButton"
              Command="{Binding GrantStartupConsentCommand}"
              Content="{DynamicResource LifecycleStartupConsentGrant}"
              automation:AutomationProperties.Name="{DynamicResource LifecycleStartupConsentGrant}" />
          <Button
              x:Name="DeclineStartupConsentButton"
              Command="{Binding DeclineStartupConsentCommand}"
              Content="{DynamicResource LifecycleStartupConsentDecline}"
              automation:AutomationProperties.Name="{DynamicResource LifecycleStartupConsentDecline}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <TextBlock
        MaxWidth="640"
        Text="{DynamicResource LifecycleSettingsPrivacyNotice}"
        TextWrapping="Wrap" />
  </StackPanel>
  </Border>
</UserControl>

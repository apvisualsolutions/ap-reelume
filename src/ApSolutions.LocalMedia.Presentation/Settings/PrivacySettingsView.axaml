<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.PrivacySettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:privacy="clr-namespace:ApSolutions.LocalMedia.Application.Privacy;assembly=ApSolutions.LocalMedia.Application"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    x:DataType="settings:PrivacySettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource PrivacyAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="PrivacyResourceKey" />
  </UserControl.Resources>
  <!-- §4's skeleton for a settings section: the padded surface and the 620 reading column that every
       section on this page shares. Without it this one started 158 px to the left of the others. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
  <StackPanel x:Name="PrivacySurface" MaxWidth="620" Spacing="{DynamicResource Space12}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource PrivacyTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource PrivacyDescription}"
        TextWrapping="Wrap" />

    <Border Classes="row-box">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
        <TextBlock
            Grid.Column="0"
            Classes="setting-name"
            Text="{DynamicResource PrivacyDiagnosticsLabel}"
            VerticalAlignment="Center" />
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            VerticalAlignment="Center">
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding DiagnosticsEnabled}"
              Text="{DynamicResource SettingStateOn}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding !DiagnosticsEnabled}"
              Text="{DynamicResource SettingStateOff}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <CheckBox
              x:Name="DiagnosticsCheckBox"
              IsChecked="{Binding DiagnosticsEnabled}"
              VerticalAlignment="Center"
              automation:AutomationProperties.Name="{DynamicResource PrivacyDiagnosticsLabel}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
    LIB-016. The switch only exists where a connection is possible at all: with no consented
    connection the automatic refresh has nothing it could do, and offering it would be offering
    something that cannot happen.

    The sentence under the name is the one this page already wrote, moved from beneath the checkbox
    into the card's own left column - which is where the prototype puts a setting's description, and
    what stops the 640-wide paragraph reaching further right than the switch it describes.
    -->
    <StackPanel
        x:Name="PrivacyAutoRefreshSurface"
        IsVisible="{Binding CanRefreshAutomatically}"
        Spacing="{DynamicResource Space4}">
      <Border Classes="row-box">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
            <TextBlock Classes="setting-name" Text="{DynamicResource PrivacyAutoRefreshLabel}" />
            <TextBlock
                x:Name="AutoRefreshDescription"
                Classes="setting-description"
                Text="{DynamicResource PrivacyAutoRefreshDescription}" />
          </StackPanel>
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="{DynamicResource Space8}"
              VerticalAlignment="Center">
            <TextBlock
                Classes="setting-state"
                IsVisible="{Binding AutomaticRefreshEnabled}"
                Text="{DynamicResource SettingStateOn}"
                automation:AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Classes="setting-state"
                IsVisible="{Binding !AutomaticRefreshEnabled}"
                Text="{DynamicResource SettingStateOff}"
                automation:AutomationProperties.AccessibilityView="Raw" />
            <CheckBox
                x:Name="AutoRefreshCheckBox"
                IsChecked="{Binding AutomaticRefreshEnabled}"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{DynamicResource PrivacyAutoRefreshLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Border
        x:Name="PrivacyStatusSurface"
        Padding="16"
        Background="{DynamicResource AccentSubtleBrush}"
        BorderBrush="{DynamicResource ShellHairlineBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource CornerRadiusMedium}"
        automation:AutomationProperties.Name="{DynamicResource PrivacyStatusAccessibleName}"
        automation:AutomationProperties.LiveSetting="Polite">
      <StackPanel Spacing="{DynamicResource Space8}">
        <TextBlock
            x:Name="PrivacyStatusText"
            MaxWidth="600"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding StatusKey, Converter={StaticResource PrivacyResourceKey}}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
      <Button
          x:Name="PrivacyPreviewButton"
          Command="{Binding PreviewCommand}"
          Content="{DynamicResource PrivacyPreviewLabel}"
          automation:AutomationProperties.Name="{DynamicResource PrivacyPreviewLabel}" />
      <!--
        Export greys where the auto-refresh switch is absent, and the difference is the grammar:
        absent means "cannot occur in this composition" (no consented connection - nothing the
        switch could ever do), greyed means "possible, but not now" (turn diagnostics on and this
        button wakes). Grey is a promise; absence is the truth that there is nothing to promise.
      -->
      <Button
          x:Name="PrivacyExportButton"
          Command="{Binding ExportCommand}"
          Content="{DynamicResource PrivacyExportLabel}"
          IsEnabled="{Binding DiagnosticsEnabled}"
          automation:AutomationProperties.Name="{DynamicResource PrivacyExportLabel}" />
    </WrapPanel>

    <settings:DiagnosticsPreviewView x:Name="PrivacyPreviewSurface" IsVisible="{Binding HasPreview}" />
    <!-- Why the preview lists empty fields at all: seen-empty is proof, omitted is a claim. -->
    <TextBlock
        MaxWidth="640"
        FontSize="{DynamicResource FontSizeCaption}"
        Foreground="{DynamicResource TextSecondaryBrush}"
        IsVisible="{Binding HasPreview}"
        Text="{DynamicResource DiagnosticsEmptyFieldsNotice}"
        TextWrapping="Wrap" />

    <TextBlock
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource PrivacyNetworkTitle}"
        automation:AutomationProperties.HeadingLevel="3" />
    <!-- The empty host list is the best possible answer and says so, not a gap. -->
    <StackPanel IsVisible="{Binding HasNoDeclaredHosts}" Spacing="{DynamicResource Space4}">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource PrivacyNoHostsTitle}" />
      <TextBlock
          MaxWidth="640"
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource PrivacyNoHostsDescription}"
          TextWrapping="Wrap" />
    </StackPanel>
    <ItemsControl
        x:Name="PrivacyNetworkList"
        ItemsSource="{Binding NetworkPurposes}"
        automation:AutomationProperties.Name="{DynamicResource PrivacyNetworkTitle}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="privacy:NetworkPurpose">
          <StackPanel Margin="0,0,0,8" Spacing="{DynamicResource Space4}">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding Host}" />
            <TextBlock
                MaxWidth="600"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding Reason}"
                TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock
        MaxWidth="640"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource PrivacyOfflineNotice}"
        TextWrapping="Wrap" />
  </StackPanel>
  </Border>
</UserControl>

<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.DiagnosticsPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    x:DataType="settings:PrivacySettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource DiagnosticsPreviewAccessibleName}">
  <Border
      x:Name="DiagnosticsPreviewSurface"
      Padding="16"
      Background="{DynamicResource CardSurfaceBrush}"
      BorderBrush="{DynamicResource ShellBorderBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource CornerRadiusMedium}">
    <StackPanel Spacing="{DynamicResource Space8}">
      <TextBlock
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource DiagnosticsPreviewTitle}"
          automation:AutomationProperties.HeadingLevel="3" />
      <TextBlock
          MaxWidth="600"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource DiagnosticsPreviewDescription}"
          TextWrapping="Wrap" />
      <!--
        It wraps. This is the one piece of text in the application that exists to be read before a
        decision - what would leave the machine if somebody pressed export - and text like that does
        not get to hide its right-hand half behind a sideways scroll. The ceiling stays, so a long dump
        scrolls downwards inside its own box instead of pushing the page.

        §4 asks for 13 px and it is refused with this tree's own rule: the scale is 28/20/14/12 and has
        no 13, and a scalar declared for one consumer is the defect already named twice here -
        FontSizeMono was considered on exactly that ground and left undeclared. FontSizeBody is a token
        the markup does not have to write as a number.

        The family is the shared token now that three views spend it; it lived here as a literal
        while this was its only reader.
      -->
      <TextBox
          x:Name="DiagnosticsPreviewText"
          MaxHeight="320"
          AcceptsReturn="True"
          FontFamily="{DynamicResource FontFamilyMono}"
          FontSize="{DynamicResource FontSizeBody}"
          IsReadOnly="True"
          Text="{Binding PreviewJson, Mode=OneWay}"
          TextWrapping="Wrap"
          automation:AutomationProperties.Name="{DynamicResource DiagnosticsPreviewTitle}" />
    </StackPanel>
  </Border>
</UserControl>

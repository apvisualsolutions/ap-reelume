<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.SegmentDetectionSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    x:DataType="settings:SegmentDetectionSettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource SegmentDetectionSettingsAccessibleName}">
  <!-- §4's skeleton for a settings page: the padded surface, the 620 column, and a title at the size
       the appearance page already used. The name stays on the panel it was on. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
    <StackPanel x:Name="SegmentDetectionSurface" MaxWidth="620" Spacing="{DynamicResource Space12}">
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SegmentDetectionSettingsTitle}"
          automation:AutomationProperties.HeadingLevel="2" />
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource SegmentDetectionSettingsDescription}"
          TextWrapping="Wrap" />
      <!--
        The prototype's unit for one setting: the name on the left, the control against the right
        edge, both inside a card. The checkbox loses the Content it carried and keeps the accessible
        name it already declared, so a reader hears the same words and only the paint moved - the
        same trade the navigation rail made when its destinations became glyphs.
      -->
      <Border Classes="row-box">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
          <TextBlock
              Grid.Column="0"
              Classes="setting-name"
              Text="{DynamicResource SegmentDetectionSettingsEnable}"
              VerticalAlignment="Center" />
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="{DynamicResource Space8}"
              VerticalAlignment="Center">
            <TextBlock
                Classes="setting-state"
                IsVisible="{Binding IsEnabled}"
                Text="{DynamicResource SettingStateOn}"
                automation:AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Classes="setting-state"
                IsVisible="{Binding !IsEnabled}"
                Text="{DynamicResource SettingStateOff}"
                automation:AutomationProperties.AccessibilityView="Raw" />
            <CheckBox
                x:Name="SegmentDetectionSwitch"
                automation:AutomationProperties.Name="{DynamicResource SegmentDetectionSettingsEnable}"
                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

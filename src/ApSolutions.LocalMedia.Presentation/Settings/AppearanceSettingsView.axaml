<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.AppearanceSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:home="clr-namespace:ApSolutions.LocalMedia.Presentation.Home"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    xmlns:theme="clr-namespace:ApSolutions.LocalMedia.Presentation.Theme"
    x:DataType="settings:AppearanceSettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource AppearanceAccessibleName}">
  <UserControl.Resources>
    <home:ResourceKeyConverter x:Key="AppearanceResourceKey" />
  </UserControl.Resources>
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
    <StackPanel MaxWidth="620" Spacing="{DynamicResource Space16}">
      <TextBlock
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource AppearanceTitle}"
          automation:AutomationProperties.HeadingLevel="1" />
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource AppearanceDescription}"
          TextWrapping="Wrap" />
      <!--
        A WrapPanel and not a horizontal StackPanel. §4 gives the reason as "five will not fit in 620",
        and that reason is void: there are three, and measured on 2026-08-21 they total 263 px in
        Spanish and 241 in English inside a 620-wide column. What earns the change is the shape - a
        horizontal StackPanel offers its children infinite width and draws them where they fall, which
        is how a control has ended up outside the window eight times here - and the fact that the
        length of these labels belongs to a translator rather than to this file.

        Three and not five, and that is decided rather than pending: ThemePreference.cs says the two
        high-contrast variants are a state read from Windows, not a fourth and fifth choice to pick.
      -->
      <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space12}">
        <Button
            Classes="theme-option"
            automation:AutomationProperties.Name="{DynamicResource ThemeSystem}"
            Command="{Binding ApplyThemeCommand}"
            CommandParameter="{x:Static theme:ThemePreference.System}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Text="{Binding SystemStateCue}" />
            <TextBlock Text="{DynamicResource ThemeSystem}" />
          </StackPanel>
        </Button>
        <Button
            Classes="theme-option"
            automation:AutomationProperties.Name="{DynamicResource ThemeLight}"
            Command="{Binding ApplyThemeCommand}"
            CommandParameter="{x:Static theme:ThemePreference.Light}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Text="{Binding LightStateCue}" />
            <TextBlock Text="{DynamicResource ThemeLight}" />
          </StackPanel>
        </Button>
        <Button
            Classes="theme-option"
            automation:AutomationProperties.Name="{DynamicResource ThemeDark}"
            Command="{Binding ApplyThemeCommand}"
            CommandParameter="{x:Static theme:ThemePreference.Dark}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Text="{Binding DarkStateCue}" />
            <TextBlock Text="{DynamicResource ThemeDark}" />
          </StackPanel>
        </Button>
      </WrapPanel>
      <TextBlock
          FontSize="{DynamicResource FontSizeSubtitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LanguageTitle}"
          automation:AutomationProperties.HeadingLevel="2" />
      <TextBlock
          Foreground="{DynamicResource TextPrimaryBrush}"
          Text="{DynamicResource LanguageDescription}"
          TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space12}">
        <Button
            Classes="theme-option"
            automation:AutomationProperties.Name="{DynamicResource LanguageSpanish}"
            Command="{Binding ApplyLanguageCommand}"
            CommandParameter="es">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Text="{Binding SpanishStateCue}" />
            <TextBlock Text="{DynamicResource LanguageSpanish}" />
          </StackPanel>
        </Button>
        <Button
            Classes="theme-option"
            automation:AutomationProperties.Name="{DynamicResource LanguageEnglish}"
            Command="{Binding ApplyLanguageCommand}"
            CommandParameter="en">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
            <TextBlock Text="{Binding EnglishStateCue}" />
            <TextBlock Text="{DynamicResource LanguageEnglish}" />
          </StackPanel>
        </Button>
      </WrapPanel>
      <!--
        Which of the two sentences this shows is a key the view model picks, the way the recommendation
        reasons travel, so the words follow the chosen language. It said the same thing either way
        until 2026-08-21, while holding the service that knew: AnimationsEnabled is the negation of the
        reduced-motion preference.
      -->
      <Border
          x:Name="ReducedMotionSurface"
          Padding="16"
          Background="{DynamicResource AccentSubtleBrush}"
          BorderBrush="{DynamicResource ShellBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusMedium}">
        <TextBlock
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding ReducedMotionNoticeKey, Converter={StaticResource AppearanceResourceKey}}"
            TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>

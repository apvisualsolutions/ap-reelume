<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Settings.RecommendationSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:settings="clr-namespace:ApSolutions.LocalMedia.Presentation.Settings"
    x:DataType="settings:RecommendationSettingsViewModel"
    automation:AutomationProperties.Name="{DynamicResource RecommendationSettingsAccessibleName}">
  <!-- §4's skeleton for a settings page. The MaxWidth of 640 that three of these text blocks carried
       went with it: a cap wider than the column it sits in is a number nobody can ever spend. -->
  <Border Padding="32" Background="{DynamicResource ShellSurfaceBrush}">
    <StackPanel MaxWidth="620" Spacing="{DynamicResource Space8}">
    <TextBlock
        FontSize="{DynamicResource FontSizeSubtitle}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="{DynamicResource RecommendationSettingsTitle}"
        automation:AutomationProperties.HeadingLevel="2" />
    <TextBlock
        Text="{DynamicResource RecommendationSettingsDescription}"
        TextWrapping="Wrap" />
    <Border Classes="row-box">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
          <TextBlock Classes="setting-name" Text="{DynamicResource RecommendationSettingsEnableLabel}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding IsEnabled}"
              Text="{DynamicResource RecommendationsOn}" />
          <TextBlock
              Classes="setting-description"
              IsVisible="{Binding IsDisabled}"
              Text="{DynamicResource RecommendationsOff}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource Space8}"
            VerticalAlignment="Center">
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding IsEnabled}"
              Text="{DynamicResource SettingStateOn}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
              Classes="setting-state"
              IsVisible="{Binding IsDisabled}"
              Text="{DynamicResource SettingStateOff}"
              automation:AutomationProperties.AccessibilityView="Raw" />
          <CheckBox
              IsChecked="{Binding IsEnabled}"
              VerticalAlignment="Center"
              automation:AutomationProperties.Name="{DynamicResource RecommendationSettingsEnableLabel}" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock
        Text="{DynamicResource RecommendationSettingsPrivacyNotice}"
        TextWrapping="Wrap" />
    <StackPanel Spacing="{DynamicResource Space8}" IsVisible="{Binding HasWatchedThreshold}">
      <!--
        The prototype's slider row: the name, the sentence underneath it, and the slider with its
        value against the right edge - "the value to the right of the slider" is its own half of the
        rule, and the number was already here. The heading level stays on the name, which is what it
        was before it moved into the card.
      -->
      <Border Classes="row-box">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space16}">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
            <TextBlock
                Classes="setting-name"
                FontSize="{DynamicResource FontSizeBody}"
                Text="{DynamicResource RecommendationSettingsThresholdLabel}"
                automation:AutomationProperties.HeadingLevel="3" />
            <TextBlock
                Classes="setting-description"
                Text="{DynamicResource RecommendationSettingsThresholdDescription}" />
          </StackPanel>
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="{DynamicResource Space12}"
              VerticalAlignment="Center">
            <Slider
                Width="170"
                Minimum="{x:Static settings:RecommendationSettingsViewModel.MinimumWatchedThresholdPercent}"
                Maximum="{x:Static settings:RecommendationSettingsViewModel.MaximumWatchedThresholdPercent}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Value="{Binding WatchedThresholdPercent}"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="{DynamicResource RecommendationSettingsThresholdLabel}" />
            <TextBlock
                Classes="setting-state"
                Text="{Binding WatchedThresholdPercent, StringFormat={}{0:0} %}" />
          </StackPanel>
        </Grid>
      </Border>
      <Button
          Content="{DynamicResource RecommendationSettingsThresholdApply}"
          Command="{Binding ApplyWatchedThresholdCommand}"
          automation:AutomationProperties.Name="{DynamicResource RecommendationSettingsThresholdApply}" />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}" IsVisible="{Binding HasThresholdResult}">
        <TextBlock Text="{DynamicResource RecommendationSettingsThresholdRecalculated}" />
        <TextBlock Text="{Binding RecalculatedCount}" />
      </StackPanel>
    </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

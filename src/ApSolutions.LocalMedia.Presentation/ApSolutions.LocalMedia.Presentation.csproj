<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApSolutions.LocalMedia.Application\ApSolutions.LocalMedia.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tray icon travels with the presentation assembly so the host loads it by avares URI. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\tmdb-logo.svg" />
    <!--
      TMDB's logo is versioned as the file they publish, which is how its authenticity can be
      checked, but Avalonia draws no SVG: the credits carry its geometry directly and TmdbLogoTests
      compares the two. Embedding it as well would ship two kilobytes nothing ever loads, which is
      the defect this repository keeps catching.
    -->
    <None Include="Assets\tmdb-logo.svg" />
  </ItemGroup>
</Project>

<!--
One lesson (CRS-005), the mirror of an episode row: the same three states, the same glyphs, the same
partial bar underneath, and a mark a person's hand wins with.

The state is a shape before it is a colour — ○ ◐ ● — so somebody who cannot tell the accent from the
secondary text still reads all three. The glyph is hidden from the automation tree because the row's
own name already says the state in words; announced twice it is read twice.

No leading action here on purpose: this is a row that repeats, and a hierarchy repeated N times is
not a hierarchy. The card above it is where the one accent goes.

THE ROW IS ONE LINE, which is what the prototype draws: the state, the number, the lesson with its
meta and its bar, and the two buttons at the right end of it. It stacked the buttons under the row
until 2026-09-03, which made every lesson twice as tall as the design's and turned a list of twenty
into a page of forms.
-->
<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Courses.LessonRowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:courses="clr-namespace:ApSolutions.LocalMedia.Presentation.Courses"
    x:DataType="courses:LessonRowViewModel">
  <Border
      Classes="row-box"
      Classes.current="{Binding IsNextInThread}"
      automation:AutomationProperties.Name="{Binding AccessibleName}">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource Space12}">
      <TextBlock
          Grid.Column="0"
          Classes="lesson-glyph"
          Classes.reached="{Binding IsReached}"
          VerticalAlignment="Center"
          Text="{Binding Glyph}"
          automation:AutomationProperties.AccessibilityView="Raw" />
      <TextBlock
          Grid.Column="1"
          Classes="lesson-number"
          VerticalAlignment="Center"
          Text="{Binding Number}" />
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
          <TextBlock
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Text="{Binding Title}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
          <!--
            «Siguiente en el hilo», present or absent rather than tinted: it is the one row of the
            card a person is looking for, and absence is not a dimmer version of it.
          -->
          <Border Classes="chip-accent" VerticalAlignment="Center" IsVisible="{Binding IsNextInThread}">
            <TextBlock Text="{DynamicResource CourseNextInThreadChip}" />
          </Border>
        </StackPanel>
        <TextBlock
            Margin="0,2,0,0"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{Binding Meta}" />
        <ProgressBar
            Classes="lesson-bar"
            Margin="0,6,0,0"
            IsVisible="{Binding HasBar}"
            Maximum="1"
            Value="{Binding Progress}"
            automation:AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
      <!--
        Marking first and playing second, which is the prototype's order. Both are the small
        secondary button that rides inside a row rather than under a heading.
      -->
      <WrapPanel
          Grid.Column="3"
          VerticalAlignment="Center"
          ItemSpacing="{DynamicResource Space8}"
          LineSpacing="{DynamicResource Space8}">
        <Button
            x:Name="LessonMarkAction"
            Classes="compact"
            Content="{Binding MarkActionText}"
            IsEnabled="{Binding CanPlay}"
            automation:AutomationProperties.Name="{Binding MarkAccessibleName}"
            Command="{Binding ToggleWatchedCommand}"
            CommandParameter="{Binding}" />
        <Button
            x:Name="LessonPlayAction"
            Classes="compact"
            IsEnabled="{Binding CanPlay}"
            automation:AutomationProperties.Name="{Binding AccessibleName}"
            Command="{Binding PlayCommand}"
            CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
            <Path Classes="icon size-14 filled" VerticalAlignment="Center" Data="{DynamicResource IconPlay}" />
            <!--
              «Reproducir», which is the word the prototype puts on this button, and the resource the
              player already carries rather than a second copy of one word.
            -->
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource PlayerPlayAction}" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Grid>
  </Border>
</UserControl>

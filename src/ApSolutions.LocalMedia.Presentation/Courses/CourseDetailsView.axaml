<!--
A course opened (CRS-002, CRS-003): the header, the modules with their lessons, and the thread panel
that answers «¿por dónde iba?» without making anybody re-watch anything.

The thread panel sits in the fixed column of a Grid rather than sticking to the viewport. The design
package says so explicitly and the reason is this framework: AXAML has no `position: sticky`, and the
settings column already solved the same shape by putting the scroller on one column and leaving the
other alone.

It stacks under the grid the way the duplicates comparison stacks under its list, so its title is a
level-2 heading: the destination's level 1 belongs to the grid, and two of them in one destination is
the defect the settings column already cost once.

The leading action is «Retomar el hilo», which is what this whole card is for. It changes to «Volver
a empezar» once nothing is left, and both come off one flag so the button and the finished chip can
never disagree.
-->
<UserControl
    x:Class="ApSolutions.LocalMedia.Presentation.Courses.CourseDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    xmlns:courses="clr-namespace:ApSolutions.LocalMedia.Presentation.Courses"
    x:DataType="courses:CourseDetailsViewModel"
    IsVisible="{Binding HasCourse}"
    automation:AutomationProperties.Name="{Binding Title}">
  <Grid ColumnDefinitions="*,320" ColumnSpacing="{DynamicResource Space24}">
    <StackPanel Grid.Column="0" Spacing="{DynamicResource Space16}">
      <StackPanel Spacing="{DynamicResource Space4}">
        <TextBlock
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{DynamicResource CourseKicker}" />
        <TextBlock
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="SemiBold"
            Text="{Binding Title}"
            TextWrapping="Wrap"
            automation:AutomationProperties.HeadingLevel="2" />
        <TextBlock
            FontFamily="{DynamicResource FontFamilyMono}"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{Binding RelativePath}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{Binding Meta}"
            TextWrapping="Wrap" />
      </StackPanel>

      <ProgressBar
          Height="3"
          MinHeight="3"
          MinWidth="0"
          Background="{DynamicResource ControlFillBrush}"
          Foreground="{DynamicResource AccentBrush}"
          Maximum="1"
          Value="{Binding Progress}"
          automation:AutomationProperties.AccessibilityView="Raw" />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
        <TextBlock
            VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeCaption}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{Binding ProgressText}" />
        <TextBlock
            Classes="state-glyph"
            VerticalAlignment="Center"
            Text="✓"
            IsVisible="{Binding IsFinished}"
            automation:AutomationProperties.AccessibilityView="Raw" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeCaption}"
            FontWeight="SemiBold"
            IsVisible="{Binding IsFinished}"
            Text="{DynamicResource CourseFinishedChip}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Modules}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{DynamicResource Space24}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="courses:CourseModuleViewModel">
            <StackPanel Spacing="{DynamicResource Space8}">
              <StackPanel
                  Orientation="Horizontal"
                  Spacing="{DynamicResource Space8}"
                  IsVisible="{Binding HasLabel}">
                <TextBlock
                    FontSize="{DynamicResource FontSizeSubtitle}"
                    FontWeight="SemiBold"
                    Text="{Binding Label}"
                    automation:AutomationProperties.HeadingLevel="2" />
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontFamily="{DynamicResource FontFamilyMono}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding Count}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Lessons}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{DynamicResource Space8}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="courses:LessonRowViewModel">
                    <courses:LessonRowView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!--
      The thread, 320 px of fixed column. Everything in it is one panel because it is one answer:
      where you left off, what you saw before that, and the button that carries on.

      THE NOTE SITS OUTSIDE THE CARD, ten pixels under it, which is where the prototype puts it: it
      explains that the thread keeps itself, so it is about the card rather than part of the answer.
      It was inside until 2026-09-03, in the accent's wash, reading as a fifth line of the thread.
    -->
    <StackPanel Grid.Column="1" Classes="thread-column" VerticalAlignment="Top">
      <Border Classes="thread-card">
        <StackPanel Spacing="{DynamicResource Space12}">
          <!--
            The overline the design draws here, and it is the accent's ink rather than a tone:
            notice-overline sets no foreground precisely because this is one of the four places it
            lands. It was a 20 px subtitle until 2026-09-03, which gave the card's weight to its own
            title instead of to the lesson underneath - the one line a person is here to read.
          -->
          <TextBlock
              Classes="notice-overline"
              Foreground="{DynamicResource AccentInkBrush}"
              Text="{DynamicResource CourseThreadTitle}"
              automation:AutomationProperties.HeadingLevel="2" />
          <StackPanel Classes="thread-head">
            <TextBlock Classes="thread-lesson" Text="{Binding ThreadLesson}" />
            <TextBlock
                Classes="thread-detail"
                IsVisible="{Binding HasThreadMinute}"
                Text="{Binding ThreadMinute}" />
          </StackPanel>
          <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
            <Button
                x:Name="CourseThreadAction"
                Classes="primary-action"
                automation:AutomationProperties.Name="{Binding ThreadActionText}"
                Command="{Binding ResumeThreadCommand}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
                <Path Classes="icon size-14 filled" VerticalAlignment="Center" Data="{DynamicResource IconPlay}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding ThreadActionText}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <!--
            What the last mark did, in ONE live region and announced politely: a mark is not an
            interruption, and splitting it in two would split the announcement.

            It carries the card's own surface now rather than the accent's wash, because the card
            behind it IS that wash since 2026-09-03: a notice painted in its background's colour is
            a notice nobody sees.
          -->
          <Border
              Classes="thread-notice"
              IsVisible="{Binding HasMarkNotice}"
              automation:AutomationProperties.LiveSetting="Polite">
            <TextBlock
                FontSize="{DynamicResource FontSizeCaption}"
                Text="{Binding MarkNotice}"
                TextWrapping="Wrap" />
          </Border>
          <Border Classes="thread-recap" IsVisible="{Binding HasRecap}">
            <StackPanel Classes="thread-recap-body">
              <TextBlock Classes="group-overline" Text="{DynamicResource CourseRecapTitle}" />
              <ItemsControl ItemsSource="{Binding Recap}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Classes="thread-recap-body" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
                      <!--
                        The prototype's bullet, in the accent and hidden from the automation tree:
                        the line beside it already says what it is, and a dot announced is a dot
                        read out loud.
                      -->
                      <TextBlock
                          Classes="thread-bullet"
                          VerticalAlignment="Top"
                          Text="●"
                          automation:AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock
                          Classes="thread-detail"
                          Text="{Binding}"
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock
          Padding="4,0"
          FontSize="{DynamicResource FontSizeCaption}"
          Foreground="{DynamicResource TextSecondaryBrush}"
          Text="{DynamicResource CourseThreadNote}"
          TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>

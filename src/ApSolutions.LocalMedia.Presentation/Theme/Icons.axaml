<!--
  The prototype's icons, which are not a font.

  Measured on 2026-08-24 by reading `design/AP Reelume.dc.html`: every pictogram in it is drawn by
  one function, `icon(n, s)`, as an SVG of 24 by 24 with `fill:none`, `stroke:currentColor`,
  `stroke-width:1.6` and round caps and joins. Thirty-five shapes, all of them line drawings. This
  application was painting Segoe Fluent glyphs instead — solid, filled pictograms from a different
  drawing tradition — in twenty-seven places, and that is the difference the owner named first when
  he said the player's icons are not the prototype's.

  So the shapes come from there, converted rather than redrawn: paths verbatim, and the prototype's
  `rect` and `circle` elements turned into the arcs that draw them. Two shapes are this
  application's own and say so: `Stop`, because its transport has a stop where the prototype's has a
  single toggle, and `ChevronUp`, which is `ChevronDown` the other way up.

  They are geometries and not a control: a geometry can be handed to a `Path` inside a
  `ControlTemplate`, which is where two of them live, and a control could not. The stroke, the caps
  and the four sizes belong to the `Path.icon` styles in DesignTokens.axaml, so the whole set can be
  re-weighted in one place — which is exactly what a font gave and what this had to keep giving.
-->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StreamGeometry x:Key="IconHome">M3 11 12 4l9 7 M5.5 9.5V20h13V9.5</StreamGeometry>
  <StreamGeometry x:Key="IconLibrary">M5,3.5 H9 A1.5,1.5 0 0 1 10.5,5 V9 A1.5,1.5 0 0 1 9,10.5 H5 A1.5,1.5 0 0 1 3.5,9 V5 A1.5,1.5 0 0 1 5,3.5 Z M15,3.5 H19 A1.5,1.5 0 0 1 20.5,5 V9 A1.5,1.5 0 0 1 19,10.5 H15 A1.5,1.5 0 0 1 13.5,9 V5 A1.5,1.5 0 0 1 15,3.5 Z M5,13.5 H9 A1.5,1.5 0 0 1 10.5,15 V19 A1.5,1.5 0 0 1 9,20.5 H5 A1.5,1.5 0 0 1 3.5,19 V15 A1.5,1.5 0 0 1 5,13.5 Z M15,13.5 H19 A1.5,1.5 0 0 1 20.5,15 V19 A1.5,1.5 0 0 1 19,20.5 H15 A1.5,1.5 0 0 1 13.5,19 V15 A1.5,1.5 0 0 1 15,13.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconReview">M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M12 7.8v5 M12 16.1v.1</StreamGeometry>
  <StreamGeometry x:Key="IconDuplicates">M5.5,3.5 H13.5 A2,2 0 0 1 15.5,5.5 V13.5 A2,2 0 0 1 13.5,15.5 H5.5 A2,2 0 0 1 3.5,13.5 V5.5 A2,2 0 0 1 5.5,3.5 Z M8 20.5h12.5V8</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M4 7h16 M4 12h16 M4 17h16 M6.8,7 A2.2,2.2 0 1 0 11.2,7 A2.2,2.2 0 1 0 6.8,7 Z M12.8,12 A2.2,2.2 0 1 0 17.2,12 A2.2,2.2 0 1 0 12.8,12 Z M4.8,17 A2.2,2.2 0 1 0 9.2,17 A2.2,2.2 0 1 0 4.8,17 Z</StreamGeometry>

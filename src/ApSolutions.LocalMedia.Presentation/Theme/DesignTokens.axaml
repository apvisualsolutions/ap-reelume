        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#08090C" />
          <!--
            The veil under the add-root dialog: the prototype's rgba(9,12,16,.62) over either
            ordinary theme, and opaque in the two high contrasts, where a half-seen page behind a
            dialog is clutter the theme exists to remove.
          -->
          <SolidColorBrush x:Key="ScrimBrush" Color="#9E090C10" />
          <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="PlayerChromeBrush" Color="#E60B0D10" />
          <SolidColorBrush x:Key="PlayerPanelBrush" Color="#111820" />
          <SolidColorBrush x:Key="PlayerHairlineBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="PlayerTextBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="PlayerTextSecondaryBrush" Color="#94A3B8" />
          <x:Double x:Key="PosterArtOpacity">1</x:Double>
          <SolidColorBrush x:Key="PosterInitialsBrush" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="PosterChipInkBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="PosterRingBrush" Color="#21FFFFFF" />
          <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#050608" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#12151B" />
          <SolidColorBrush x:Key="ControlFillBrush" Color="#171B22" />
          <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#1E232C" />
          <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#262C37" />
          <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#101318" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#5C6878" />
          <SolidColorBrush x:Key="ShellHairlineBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B97A8" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#6A7686" />
          <SolidColorBrush x:Key="FocusStrokeBrush" Color="#7CC4FF" />
          <SolidColorBrush x:Key="FocusInnerStrokeBrush" Color="#08090C" />
          <SolidColorBrush x:Key="AccentBrush" Color="#62AEE8" />
          <SolidColorBrush x:Key="AccentSubtleBrush" Color="#0B1E2F" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#9CC9EC" />
          <SolidColorBrush x:Key="ControlTextActiveBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#0A0C10" />
          <!--
            The prototype's primary is a LIGHT pill in the dark theme - #F3F6FA wearing near-black
            ink - not an accent-blue button. Its own family, so the accent stays the mark of state
            and the primary stays the mark of the one leading action.
          -->
          <SolidColorBrush x:Key="PrimaryActionBrush" Color="#F3F6FA" />
          <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#0A0C10" />
          <!-- The prototype's two elevations, verbatim: rgba(0,0,0,.5)/.42 and .66. -->
          <BoxShadows x:Key="ElevationShadow">0 1 2 0 #80000000, 0 12 32 0 #6B000000</BoxShadows>
          <BoxShadows x:Key="ElevationShadowStrong">0 28 70 0 #A8000000</BoxShadows>
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#2D281D" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#F2C879" />
          <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2E2226" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#F5A3AC" />
          <SolidColorBrush x:Key="PositiveSurfaceBrush" Color="#12251D" />
          <SolidColorBrush x:Key="PositiveBorderBrush" Color="#8FDBA6" />

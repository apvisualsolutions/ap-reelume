          <SolidColorBrush x:Key="ControlTextActiveBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#111827" />
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#3A2E0B" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8B84B" />
          <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#3B1A17" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#F2B8B5" />
          <SolidColorBrush x:Key="PositiveSurfaceBrush" Color="#12301F" />
          <SolidColorBrush x:Key="PositiveBorderBrush" Color="#7BD3A0" />

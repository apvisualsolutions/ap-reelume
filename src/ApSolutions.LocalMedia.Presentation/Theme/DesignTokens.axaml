          <SolidColorBrush x:Key="WarningBorderBrush" Color="#8A6100" />
          <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FDECEA" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#B3261E" />
          <SolidColorBrush x:Key="PositiveSurfaceBrush" Color="#E4F2E9" />
          <SolidColorBrush x:Key="PositiveBorderBrush" Color="#14653B" />
          <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />

          <SolidColorBrush x:Key="PlayerHairlineBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PlayerTextSecondaryBrush" Color="#FFFFFF" />
          <x:Double x:Key="PosterArtOpacity">0</x:Double>
          <SolidColorBrush x:Key="PosterInitialsBrush" Color="#101828" />
          <SolidColorBrush x:Key="PosterChipInkBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="PosterRingBrush" Color="#21FFFFFF" />
          <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#000000" />
          <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#000000" />
          <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#000000" />
          <SolidColorBrush x:Key="ShellHairlineBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#000000" />
          <SolidColorBrush x:Key="FocusStrokeBrush" Color="#000000" />
          <SolidColorBrush x:Key="FocusInnerStrokeBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFFFFF" />
          <!-- The same pair, in this dictionary's own colours. -->
          <SolidColorBrush x:Key="SelectionFillBrush" Color="#FFFFFF" />
          <StaticResource x:Key="SelectionStrokeBrush" ResourceKey="ShellBorderBrush" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="ControlTextActiveBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryActionBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFFFFF" />
          <!-- High contrast draws no shadows: elevation is a colour nobody chose. -->
          <BoxShadows x:Key="ElevationShadow">0 0 0 0 #00000000</BoxShadows>
          <BoxShadows x:Key="ElevationShadowStrong">0 0 0 0 #00000000</BoxShadows>
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#000000" />

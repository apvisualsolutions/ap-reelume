          <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="AccentSubtleBrush" />

          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B97A8" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#6A7686" />
          <SolidColorBrush x:Key="FocusStrokeBrush" Color="#7CC4FF" />
          <SolidColorBrush x:Key="FocusInnerStrokeBrush" Color="#08090C" />
          <SolidColorBrush x:Key="AccentBrush" Color="#62AEE8" />
          <SolidColorBrush x:Key="AccentSubtleBrush" Color="#0B1E2F" />
          <!-- The same pair, in this dictionary's own colours. -->
          <SolidColorBrush x:Key="SelectionFillBrush" Color="#297F91AA" />
          <StaticResource x:Key="SelectionStrokeBrush" ResourceKey="ShellBorderBrush" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#9CC9EC" />
          <SolidColorBrush x:Key="ControlTextActiveBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#0A0C10" />
          <!--
            The prototype's primary is a LIGHT pill in the dark theme - #F3F6FA wearing near-black
            ink - not an accent-blue button. Its own family, so the accent stays the mark of state
            and the primary stays the mark of the one leading action.
          -->
          <SolidColorBrush x:Key="PrimaryActionBrush" Color="#F3F6FA" />
          <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#0A0C10" />
          <!-- The prototype's two elevations, verbatim: rgba(0,0,0,.5)/.42 and .66. -->
          <BoxShadows x:Key="ElevationShadow">0 1 2 0 #80000000, 0 12 32 0 #6B000000</BoxShadows>
          <BoxShadows x:Key="ElevationShadowStrong">0 28 70 0 #A8000000</BoxShadows>

          <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#D6DFEA" />
          <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#C4D0DF" />
          <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#EEF3F7" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#64748B" />
          <SolidColorBrush x:Key="ShellHairlineBrush" Color="#170F172A" />

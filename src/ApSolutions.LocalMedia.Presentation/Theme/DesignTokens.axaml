          <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFFFFF" />
          <!--
            Focus keeps the yellow and the accent gives it up: they used to be the same #FFFF00, so
            the one theme where focus matters most was the one where focus and brand were the same
            colour. #00FFFF reads 16,75:1 on black.
          -->
          <SolidColorBrush x:Key="FocusStrokeBrush" Color="#FFFF00" />

          <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="RadioButtonCheckGlyphFillDisabled" ResourceKey="TextDisabledBrush" />

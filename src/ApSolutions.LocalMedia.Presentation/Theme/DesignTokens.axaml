        <!--
          Warning, danger and positive share the theme's own surface and border here, in both high
          contrast dictionaries. What tells them apart is the glyph and the heading, never the hue:
          a palette that says "amber means careful" says nothing to someone who cannot separate
          amber from red, and in these themes it also has no colour left to say it with.
        -->
        <ResourceDictionary x:Key="{x:Static theme:AppThemeVariants.HighContrastLight}">
          <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#FFFFFF" />
          <!--
            The veil under the add-root dialog: the prototype's rgba(9,12,16,.62) over either
            ordinary theme, and opaque in the two high contrasts, where a half-seen page behind a
            dialog is clutter the theme exists to remove.
          -->
          <SolidColorBrush x:Key="ScrimBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="PlayerChromeBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="PlayerPanelBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="PlayerHairlineBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PlayerTextSecondaryBrush" Color="#FFFFFF" />
          <x:Double x:Key="PosterArtOpacity">0</x:Double>
          <SolidColorBrush x:Key="PosterInitialsBrush" Color="#101828" />
          <SolidColorBrush x:Key="PosterChipInkBrush" Color="#EDF1F6" />
          <SolidColorBrush x:Key="PosterRingBrush" Color="#21FFFFFF" />
          <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#000000" />
          <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#000000" />
          <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ShellBorderBrush" Color="#000000" />
          <SolidColorBrush x:Key="ShellHairlineBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#000000" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#000000" />
          <SolidColorBrush x:Key="FocusStrokeBrush" Color="#000000" />
          <SolidColorBrush x:Key="FocusInnerStrokeBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="ControlTextActiveBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryActionBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionPressedBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFFFFF" />
          <!-- High contrast draws no shadows: elevation is a colour nobody chose. -->
          <BoxShadows x:Key="ElevationShadow">0 0 0 0 #00000000</BoxShadows>
          <BoxShadows x:Key="ElevationShadowStrong">0 0 0 0 #00000000</BoxShadows>
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#000000" />
          <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#000000" />
          <SolidColorBrush x:Key="PositiveSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PositiveBorderBrush" Color="#000000" />
          <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />

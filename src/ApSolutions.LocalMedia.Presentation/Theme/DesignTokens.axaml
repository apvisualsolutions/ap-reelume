          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FocusStrokeBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextDisabledBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#111827" />
          <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#0B0D10" />
          <SolidColorBrush x:Key="PlayerChromeBrush" Color="#E60B0D10" />

            The drop-down, in three families of its own: the closed frame, the panel that opens, and
            the rows inside it. Measured: 59 keys, and it inherits nothing from the text field
            because IsEditable appears nowhere in the tree.
          -->
          <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="AccentSubtleBrush" />
          <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="CardSurfaceBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentSubtleBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="TextDisabledBrush" />
          <!--
            Phase 2g: the slider, the toggle and the radio. Eight uses between them and one grammar
            of states, so they are aliases and not a fourth way of saying the same thing. Two
            families are left alone on purpose, because nothing in the tree can reach them: the
            toggle's Indeterminate* (IsThreeState appears nowhere) and the slider's tick bar (no
            view sets TickPlacement, so no tick is drawn).
          -->
          <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="SliderTrackFill" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="SliderThumbBackgroundDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="ToggleButtonBackground" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseStroke" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseStrokePointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseStrokePressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseStrokeDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseFill" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseFillPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseFillPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseFillDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="AccentBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="ControlFillPressedBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="AccentBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="AccentTextBrush" />
          <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="RadioButtonCheckGlyphFillDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="RadioButtonForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="RadioButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="RadioButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="RadioButtonForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="ComboBoxItemBorderBrushSelected" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPointerOver" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxItemBorderBrushSelectedDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlBackground" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillHoverBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="ControlFillDisabledBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FocusStrokeBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="ShellBorderBrush" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextDisabledBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="ControlTextActiveBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextSecondaryBrush" />
          <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextDisabledBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    Every button is a pill. The prototype draws one on every screen it has - btnPri and btnSec are
    both `border-radius: 999` - and this is the one place that decides it, so a view never writes a
    corner of its own. The three classes that are not pills say so themselves further down, and they
    win because a class selector declared later beats this one.

    ToggleButton is named too: a toggle is a button that stays pressed, and it stands in the same
    rows as the ordinary ones - "Favorito" beside "Marcar como visto". A ToggleButton does not match
    the Button selector, so without this it kept the base theme's shorter box, its square corner and
    its own asymmetric padding, and the row read as two kinds of control.
  -->
  <!--
    A button puts its content in the middle of itself, and until 2026-08-24 none of them did.
    `VerticalContentAlignment` starts at `Stretch`, this style set a height, a radius and a padding
    and never touched it, and a stretched TextBlock fills the whole button and draws its line at the
    TOP of that box: measured, a 36 px pill held a 34 px label box with the words riding about seven
    pixels above centre. Every button in the application, and the owner saw it before any gate did.

    The prototype writes the same rule as one line of CSS on every button it draws —
    `display:inline-flex; align-items:center; justify-content:center` — and this is that line. The
    two rail classes and the poster card declare their own alignment further down and keep it: they
    are later in this file, and in Avalonia the last style that matches wins.
  -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!--
    And the ink inside that box, which is a second question and was still wrong after the first was
    fixed: the box was centred and the words still looked low, which is what the owner reported
    twice. The answer lives in the style below, and what it is worth is one pixel on the button's
    content — measured by rasterising, not derived from the font's metrics.

    This block used to argue for five pixels on the label, from a 2.43 px asymmetry the metrics
    reported, and cited ButtonOpticalCentreTests. All of that is gone: the screen says the error is
    1 px, five moved the word by three, a margin on the label grows the panel and takes the icon
    with it, and that test is retired for computing the ink instead of looking at it.
    ButtonPixelCentreTests holds the result now. See docs/design/ELEMENTS.es.md, which carries the
    whole story and takes precedence over this file.
  -->
  <!--
    And taken back off the buttons whose content is a shape rather than a sentence. A glyph is
    centred by its own geometry and has no baseline to compensate for, so the same five pixels that
    put a word right would push an icon two and a half above the middle of its target. The presenter
    takes its padding from the button by template binding, so this is where it has to be said.
  -->
  <Style Selector="Button.player-chrome">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.accent-swatch">
    <Setter Property="Padding" Value="0" />
  </Style>
  <!--
    <b>Child selectors and not a descendant one</b>, which is the half of the old argument that
    survived. Stopping one level down is what keeps this off the captions under a poster card, which
    sit three levels deep inside <c>PosterCardView</c> and are a stacked block rather than a centred
    row. A descendant selector would also grow the rail's badge.

    <c>:is(TextBlock)</c> and not <c>TextBlock</c>, because the label a presenter makes for a plain
    string is an <c>AccessText</c> — measured, along with the fact that its logical parent is the
    button itself and not the presenter, which is what lets the first selector reach it at all.
  -->
  <!--
    <b>One pixel on the button's content, and it used to be five on the label.</b> Rewritten on
    2026-08-28 against the first measurement of this that read pixels rather than boxes.

    The five were derived from the font's metrics — a 2.43 px asymmetry between ascent and descent,
    doubled because a margin on one side moves a centred box by half of it. Rasterising a real button
    with <c>CaptureRenderedFrame</c> says the error on screen is <b>1 px</b>, not 2.43, and that the
    five moved the word by three: from 1 px low to 2 px high. It overcorrected past the middle.

    <b>And it moved the wrong thing.</b> A margin on the label grows the panel the label sits in, so
    a button carrying an icon beside its word had the icon shifted too — measured at <b>2 px between
    the icon and the word</b> across all 53 buttons of that shape. The icon is geometry and was
    already centred to the pixel; the compensation pushed it off and then pushed the word twice as
    far the other way.

    So it goes on the button's own content — the label when that is all there is, the panel when
    there is an icon beside it — where it moves everything the button draws by the same amount and
    cannot separate two things that belong together. Measured after the change, at 14 px in Inter,
    the icon, the word and the button's middle all land on the same pixel for «Guardar»,
    «Reproducir», «Añadir medios…» and «Save the report» — with a descender and without, in both
    languages.

    <b>Two is not the answer and was measured too</b>: 2 px of margin moves the pair 1 px past the
    middle, the same overshoot in miniature. What a margin corrects is half of itself.

    <c>Path</c> appears nowhere here, and that is unchanged: a shape is centred by its geometry and a
    button whose whole content is an icon needs no compensation at all.
  -->
  <!--
    <b><c>Panel</c> is deliberately absent, and it was measured.</b> The three buttons in this tree
    whose content is a bare <c>Panel</c> carry no word at all — <c>MuteButton</c> and
    <c>FullscreenButton</c> stack two icons that alternate by state — and a button whose content is
    only a picture needs no compensation, which is the rule three paragraphs up.

    It was in the old selector as <c>Button &gt; Panel &gt; :is(TextBlock)</c> and <b>never reached
    anything</b>: no <c>Panel</c> inside a button holds a <c>TextBlock</c>. Moving the setter onto
    the container is what would have woken it up to do the wrong thing. Every <c>Grid</c> inside a
    button does carry a word — measured across all 48 views — so the other four stay.
  -->
  <Style Selector="Button &gt; :is(TextBlock),
                   Button &gt; StackPanel,
                   Button &gt; WrapPanel,
                   Button &gt; Grid,
                   ToggleButton &gt; :is(TextBlock),
                   ToggleButton &gt; StackPanel,
                   ToggleButton &gt; WrapPanel,
                   ToggleButton &gt; Grid">
    <Setter Property="Margin" Value="0,0,0,1" />
  </Style>
  <!--
    The ring is drawn twice, in two colours, one inside the other. Borrowing the control's own border
    for it had two measured holes: a Slider has no border to paint on, and in high contrast light the
    border and the focus colour are both black, so focus changed one pixel of thickness and nothing
    else. Two concentric rings are a *geometry* cue, and geometry still reads in a theme whose whole
    palette is one colour. It is also what Windows 11 draws for its own focus rectangle.
  -->
  <Style Selector="Button, ToggleButton, ToggleSwitch, RadioButton, TextBox, ComboBox, CheckBox, Slider, NumericUpDown, ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border
            BorderBrush="{DynamicResource FocusStrokeBrush}"
            BorderThickness="{DynamicResource FocusStrokeThickness}"
            CornerRadius="{DynamicResource CornerRadiusSmall}">
          <Border
              BorderBrush="{DynamicResource FocusInnerStrokeBrush}"
              BorderThickness="{DynamicResource FocusInnerStrokeThickness}"
              CornerRadius="{DynamicResource CornerRadiusSmall}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!--
    The five states of a button, and they are set on the ContentPresenter rather than on the Button:
    measured, the presenter is what paints, and a Background setter on the Button itself loses to the
    base theme. What the base theme painted, before these: a 20 % black fill, a *transparent* border,
    and a pointer-over state whose fill went to solid black under black text — a contrast of 1:1 that
    no check covered, because none of it came from a token.

    In high contrast, hovering and pressing *invert*: the fill becomes the border's colour and the
    text becomes the surface's. That is why the text has a token of its own rather than staying at
    TextPrimaryBrush — in light and dark it is the same colour, and in the two high contrast themes it
    is the opposite one. Same for the pressed border: 1 px normally, 2 px where the border is the only
    shape a control has.
  -->
  <!--
    Which row you are on is a list's whole job, and it was being said with colour alone: the selected
    row was Windows 10's blue at 40 % opacity, which over the surface reads 1,73:1 in light and
    2,24:1 in high contrast dark. The fill now comes from the accent's subtle token, and the row
    carries a border that only changes colour — every row has the same thickness in every state, so
    selecting one does not shove its text sideways. In the two high contrast themes the subtle accent
    *is* the surface, and there the border is the entire cue, which is why it and not the fill is the
    part that has to clear the bar.

    Declared before the focus selectors on purpose: between styles that both match, the last one
    declared wins, and focus has to win over selection.
  -->
  <!--
    One pixel and not two, and the neutral pair rather than the accent. The two-pixel accent
    rectangle is what the owner was looking at on 2026-08-25 — «quiero cambiar los recuadros de
    selección de los menús en general, no quiero un borde coloreado con el acento» — and it was
    drawn around every selected row this application has, including a poster in a rail, where it
    reads as a box somebody dropped on a picture.

    What replaces it is what the prototype draws for a menu: a neutral wash, and the accent spent
    somewhere else. The border stays because ListRowStateTests measures one — see SelectionStrokeBrush
    for why it is ShellBorderBrush and not nothing — and it is a hairline in every state so selecting
    a row still never shoves its text sideways.
  -->
  <Style Selector="ListBoxItem">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SelectionStrokeBrush}" />
  </Style>
  <!--
    A drop-down row is the same idea as a list row and is read the same way: the fill is a tint, and
    the border is the part that has to clear the bar, because in the two high contrast themes the
    subtle accent *is* the surface. Measured before writing any of it: a ComboBoxItem's content
    presenter takes BorderThickness by template binding, so the thickness is given here — every row
    carries it in every state and only the colour changes, or selecting one would shove its text
    sideways.

    The colour is *not* given here, and that was measured the hard way. A style setting BorderBrush
    on the item reaches the item (measured: bd=#ff1769aa on it) and the presenter ignores it
    (bd=Transparent), because the control theme sets the presenter's brush per state from
    ComboBoxItemBorderBrush*. The template binding was verified in the resting state, which is the
    one state where nothing competes for it. What reaches a template is the resource it consumes,
    so the selected border is a redirect above and not a setter here.
  -->
  <Style Selector="ComboBoxItem">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!--
    The same five pixels the buttons carry, for the same reason and on the same thing: the label a
    presenter makes for a plain string is an AccessText whose logical parent is the row itself. A
    drop-down row is a centred line of words beside a mark, so its ink answers to a baseline exactly
    as a button's does — and the closed frame above has carried this since 2026-08-25 while the rows
    the panel opens never did.
  -->
  <Style Selector="ComboBoxItem &gt; :is(TextBlock),
                   ComboBoxItem &gt; StackPanel &gt; :is(TextBlock),
                   ComboBoxItem &gt; Grid &gt; :is(TextBlock)">
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <!--
    Every button says what it does when the pointer rests on it, and it says exactly what a screen
    reader is told.

    One style rather than an attribute on each button. The owner asked for tooltips «en todos los
    botones, en especial los que sólo llevan icono», and there are more than two hundred of them:
    written out one by one, that is two hundred chances for the tip and the accessible name to drift
    apart, and nothing would notice for a year. Bound to the control's own name they are the same
    string by construction, and ViewLiteralTests — which refuses a literal in ToolTip.Tip — keeps
    that string a resource key, so both follow the language in force.

    A button that declares no accessible name gets no tip, which is the honest answer: there is
    nothing to say about it that has been written down. A button that already carries a tip of its
    own keeps it, because a local value outranks a style setter.
  -->
  <Style Selector="Button">
    <Setter Property="ToolTip.Tip" Value="{Binding $self.(automation:AutomationProperties.Name)}" />
  </Style>
  <!--
    Every control type that can take keyboard focus is styled from the same token, so the focus ring
    the contrast matrix measured is the ring the person actually sees. A type left out here would fall
    back to whatever the base theme draws, which no check covers.

    :focus-visible and not :focus, and the difference is the whole complaint. :focus is raised by a
    mouse too, so every checkbox somebody clicked answered with a two-pixel ring that stayed until
    they clicked elsewhere — «al hacer clic en una casilla sale un reborde azul, y pasa en todas»,
    reported on 2026-08-25 by the owner. The ring says where the keyboard is; a pointer already says
    where it is by being there. Nothing is lost for a keyboard: Avalonia raises focus-visible for
    Tab, for the arrow keys, and for a focus moved in code.
  -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="ToggleButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="TextBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="CheckBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="Slider:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="NumericUpDown:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <Style Selector="RadioButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FocusStrokeThickness}" />
  </Style>
  <!--
    Disabled is drawn, not tinted — in the two high contrast themes, and only there.

    That last clause is the whole of what changed on 2026-08-25. The reason this outline exists has
    always been written down: in light and dark a disabled control reads off its fill, which is a
    third grey, while the two high contrast palettes have no third colour to spend — measured, the
    disabled fill, the resting fill and the surface are one colour, the border is the theme's single
    border in all four states, and the disabled text is the primary text. Geometry is what is left.

    Drawing it in all four themes made every command with nothing to act on wear a dotted rectangle
    in the ordinary ones too, on top of a grey that already said the same thing. The owner counted
    them on seven screens; the instrument counted 299 across the tree with no data loaded. So the
    cue is spent where it is the only one, and the fill carries it where the fill can.

    A DynamicResource and not a code test of the theme: the adorner outlives a theme change, and a
    resource is what re-resolves when one happens. It is the same mechanism the whole file rests on.
  -->
  <Style Selector="Button:disabled, ToggleButton:disabled, ToggleSwitch:disabled, RadioButton:disabled, TextBox:disabled, ComboBox:disabled, CheckBox:disabled, Slider:disabled, NumericUpDown:disabled, ListBoxItem:disabled">
    <Setter Property="theme:DisabledOutline.IsShown" Value="{DynamicResource DisabledOutlineShown}" />
  </Style>
  <!--
    The one button that is the point of its screen. It was a class on ResumeHeroView's button that no
    style declared and no test looked for, so "resume what you were watching" was painted exactly
    like every secondary button beside it.

    The hierarchy is carried entirely by the resting state, which is when a person looks and decides.
    Hover and press invert like every other control, deliberately: one grammar of states across the
    application beats a fourth way of saying "pressed", and an accent that stayed put through hover
    would be the only control in the two high contrast themes that stopped answering the mouse.

    The setters go on the presenter because that is what paints a button — measured in phase 2a, a
    Background setter on the Button itself loses to the base theme.
  -->
  <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
  </Style>
  <Style Selector="Button.primary-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryActionPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
  </Style>
  <!--
    A button whose whole content is a glyph, standing in a row of buttons that carry words.

    It is exactly as tall as they are — ControlHeight, the same one the base style gives every button
    — and exactly as wide, which with the pill radius makes it a circle. player-chrome would have
    been the obvious class and is the wrong one here: those are 44 px because they sit on the
    player's own band beside other 44 px targets, and a 44 px circle in a row of 36 px pills is the
    one control that does not line up. «Esos botones deberían ser del mismo tamaño menos el de
    reproducir», said on 2026-08-25, looking at exactly that row.

    Padding zero for the reason player-chrome has it: the five pixels that put a word right would
    push a shape above the middle of its own target.
  -->
  <Style Selector="Button.icon-action">
    <Setter Property="Width" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary-action">
    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryActionTextBrush}" />
    <!-- btnPri is the wider and heavier of the prototype's two: 0 20 against the secondary's 0 16. -->
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,0" />
  </Style>

  <!--
    The player's chrome, wherever it is: the mini player's five and the large transport's three. A
    minimum and not a fixed size, because the package asks for 36x36 and a fixed one cuts the label in
    whichever of the two languages runs longer, which is a defect waiting rather than a layout.

    It carries no Margin. It used to, because the mini player's five needed separating and this was
    the only place saying anything about them. But the large transport places its three in a panel
    that already spaces them, so the same four a side would land on top of that spacing and push them
    twenty apart. What is the control's is its target area and its corner; where it sits belongs to
    whoever puts it there, and both panels now say so themselves.
  -->
  <!--
    44 and not 36: §4 asks for it and the reason is not the design's, it is the pointer's. 36 px is the
    smallest target WCAG 2.2 accepts at AA; 44 is what it asks for at AAA and what every touch guideline
    converges on, and these five are the controls somebody presses in a hurry, in the dark, sometimes on
    a laptop trackpad. Raising it costs nothing here because the transport wraps.
  -->
  <!--
    How the prototype's icons are drawn, in one place.

    Its own `icon(n, s)` returns an SVG of 24 by 24 with `fill:none`, `stroke:currentColor`,
    `stroke-width:1.6`, and round caps and joins, at whatever size the call site asks for. Three of
    those four are the same for every icon in the application and live here; the fourth is the size,
    and it comes in the four the prototype actually spends — 14 for a caret, 16 for a menu row, 18
    for a banner or a volume, 20 for a rail destination and a skip, 22 for the play toggle.

    <b>The thickness is not one number.</b> Avalonia scales the geometry to the control's bounds and
    then strokes it with a pen of the thickness written here, in the control's own coordinates — so a
    single 1.6 would draw a 20 px icon at the weight of a 24 px one. Each size carries the weight the
    prototype's SVG would compute for it: 1.6 x size / 24.

    <b>The ink is inherited and not set.</b> Measured on 2026-08-24: a Path does take
    TextElement.Foreground from the button it sits in, so an icon follows its control through hover,
    pressed and disabled exactly as the glyph it replaces did. Binding it is what keeps a white icon
    from staying white on the light pill of a primary action.
  -->
  <!--
    The chip the prototype puts in the corner of every cover: one word, small, on a dark tint over
    the artwork. Its background is a tint and not a token colour because it lands on twelve different
    hues and has to stay legible on all of them - the prototype's own `rgba(9,12,16,.72)`.
  -->
  <!--
    The rail's badge, at the prototype's own measurements: a pill of at least 17 by 17 on the accent,
    in 10.5 px bold, tucked into the icon's top right corner. It is the one number the shell paints
    over another control, so it carries no border of its own - the accent against the rail's own
    surface is the boundary.
  -->
  <Style Selector="Border.rail-badge">
    <Setter Property="MinWidth" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Margin" Value="0,4,3,0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
  </Style>

  <!--
    THE OVERLINES, and there are six because the design draws six. Small, spaced, capitalised text
    over something else: a field, a group of fields, a hero, a notice, the video, a table column.

    What they share is the shape and nothing else. Colour is context — secondary over a page, the
    accent over a card, the warning or error ink over a notice — and over the video the same overline
    is dimmed rather than recoloured, so neither is set here.

    Every number below is the design's, read out of «design/AP Reelume.dc.html» by OverlineTests
    rather than restated: that gate pairs each class with the prototype control it draws and fails on
    the number, which is the arrangement ADR-0007 put over the buttons and this is the same decision
    reaching «todos los elementos».

    THE TRACKING IS PIXELS AND THE DESIGN'S IS EM, so each one is written as its em times the size on
    the line above it. Avalonia 12.1.1 documents TextElement.LetterSpacing as «specified in pixels»,
    and ScalarTokenTests does not watch LetterSpacing, so nothing else would catch a tracking left
    behind when its size moved.

    TWO SIZES HERE ARE LITERALS — 10 and 10.5 — and that is ADR-0007's first consequence rather than
    an oversight: the scale carries 11 at its smallest and the design draws below it. Rounding them
    up to the footnote would draw a size the design does not have. ScalarTokenTests still forbids a
    view writing a size that HAS a token, which is a different thing.
  -->

  <!--
    The kicker over the hero — «CONTINUAR VIENDO», «CURSO», «RECUPERACIÓN» — and the widest tracking
    the design uses.

    IT DREW 12 UNTIL 2026-09-03, and its own comment said the design's tracking was 0.16em. The
    design draws 10.5 at 0.18em. The tracking was right to two decimals by accident — 0.16 x 12 is
    1.92 and 0.18 x 10.5 is 1.89, and 1.9 was written — while the size was a size and a half out.
    Two numbers copied by hand, one of which agreed by coincidence, is why this file no longer gets
    to state them.
  -->
  <Style Selector="TextBlock.hero-overline">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1.89" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The label over a single field — «UBICACIÓN DEL ARCHIVO», «DISPOSITIVO DE SALIDA», «CANALES». The
    plainest of the six and the one the design uses most: nine sites.

    0.66 is 0.06 x 11, and the 11 is the token on the line above. If FontSizeFootnote ever moves,
    this moves with it.

    THE CAPITALS ARE IN THE STRING, not in a converter. An earlier version of this comment said they
    came from an «UpperCaseConverter» that «is what AXAML has instead of text-transform» and that
    they were NOT written into the resource. No such converter exists in this tree — searched on
    2026-09-03 — and sixteen resources are written in capitals. AudioOutputView says why, and it is
    the half that was true: AXAML has no text-transform and no way to compose a converter with a
    resource that follows the language, so a heading is its own string and a test asserts each one IS
    its label uppercased in both languages. A comment naming a mechanism nobody built is this
    repository's own defect pointed at its documentation.
  -->
  <Style Selector="TextBlock.section-overline">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeFootnote}" />
    <Setter Property="LetterSpacing" Value="0.66" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The label over a GROUP of fields rather than over one — «CARPETA», «CATÁLOGO», «ÚLTIMA COPIA»,
    «RAÍCES DE MEDIOS». Same size as the one above and bold, which is the whole difference and the
    reason it cannot be the same class: bold at 0.10em and regular at 0.06em are two jobs, and one
    class would have to pick one and be wrong in seven places.

    1.1 is 0.10 x 11.
  -->
  <Style Selector="TextBlock.group-overline">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The label over a notice — «CONFIRMAR EL BORRADO», «MOTIVO DEL RECHAZO», «DETALLE TÉCNICO»,
    «REANUDAR». The smallest and the most widely spaced of the bold pair, and the only one the design
    consistently draws in a tone rather than in the secondary ink: error over a confirmation, warning
    over a rejected update, the accent over a course's thread.

    SO IT SETS NO FOREGROUND, and that is deliberate rather than forgotten: a colour here would have
    to be one of four, and the view that draws the notice is the only place that knows which.

    1.4 is 0.14 x 10.
  -->
  <Style Selector="TextBlock.notice-overline">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>

  <!--
    The label over the video — «INICIO», «FIN» beside a marker's times. Half a pixel smaller than the
    field label and at the same tracking, which reads as the same overline drawn over moving picture
    rather than over a page.

    NO FOREGROUND AND NO OPACITY: the design dims it to .72 of whatever the chrome above the video is
    already using, and that is the player's business rather than this file's.

    0.63 is 0.06 x 10.5.
  -->
  <Style Selector="TextBlock.player-overline">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="0.63" />
  </Style>

  <!--
    The heading over a table column — «ARCHIVO», «RESOLUCIÓN», «CÓDEC». The smallest and the tightest
    of the six, which is what lets nine of them sit across one row without the row growing.

    THE TREE DREW THIS WITH card-eyebrow UNTIL 2026-09-03 — 12 and no tracking at all. It was the
    only place drawing capitals with no spacing between them, which is the one thing every overline
    in the design does.

    0.5 is 0.05 x 10.
  -->
  <Style Selector="TextBlock.column-overline">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    A link that happens to be a button: the prototype writes «Ver toda la biblioteca ›» in the accent
    colour with no fill and no border, because it goes somewhere rather than doing something. It
    keeps the 36 px height every other control has, so a row it sits in does not change height.
  -->
  <!--
    The prototype's link is drawn in the accent's INK, not in the accent: the difference is 9.03:1
    against 5.62:1 in light and 11.36:1 against 8.29:1 in dark, and it is the same decision the
    chosen pill already made. The pair is measured in ContrastTokenTests against the shell, because
    this is the one place the ink is asked to be readable over the page rather than over its wash.
  -->
  <Style Selector="Button.link-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!--
    The chosen copy, which the prototype marks on the whole row and not only in its radio: the wash
    of the accent behind it and the accent itself around it. Text over that wash measures 15.22:1 in
    light and 14.92:1 in dark; in either high contrast the wash equals the card, so the border and
    the radio carry it alone — which is the same decision the library's filter already made.
  -->
  <Style Selector="Border.duplicate-row">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
  </Style>

  <Style Selector="Border.duplicate-row.chosen">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    A way in that the prototype does not colour: the duplicates group heading is a title first and a
    door second, and painting it accent made the page read as a list of links rather than as the
    comparison it is. The reach stays, the accent goes.
  -->
  <Style Selector="Button.link-action.plain">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.poster-chip">
    <Setter Property="Padding" Value="7,2" />
    <!--
      The pill, and it read as the small 4 until 2026-09-03: kindBadge is a capsule over the cover in
      the prototype, not a rounded box. SurfaceCornerTests reads the number out of the design.
    -->
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="Background" Value="#B8090C10" />
    <Setter Property="TextElement.Foreground" Value="#EDF1F6" />
  </Style>

  <!--
    Each class is the size the prototype draws that glyph at: `size-20` is `icon(n, 20)`, and the
    stroke under it is the prototype's 1.6 in a box of 24 scaled to the same width.

    This carried a two pixel subtraction from 2026-08-25 to 2026-08-29, and the complaint behind it
    was real — «todos los iconos de la aplicación son muy grandes, bájales el tamaño un poco». The
    instrument was not. The icons were oversized because the conversion had dropped the prototype's
    24 unit viewBox, so `Stretch` `Uniform` stretched each stroke until it filled the box: measured,
    that made `IconHome` 1.20x too large and `IconClose` 1.86x, a different factor for every glyph.
    A fixed subtraction of two cannot correct a set of different factors, and it was also being read
    the wrong way round — the excess was in the geometry, not in the class. Icons.axaml restores the
    viewBox, so the class name is the size again and there is nothing left to compensate.
  -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{Binding $self.(TextElement.Foreground)}" />
    <Setter Property="StrokeThickness" Value="1.07" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <!-- A picture inside a control is not a second target inside it. -->
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Path.icon.size-12">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="StrokeThickness" Value="0.8" />
  </Style>

  <Style Selector="Path.icon.size-14">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="StrokeThickness" Value="0.93" />
  </Style>

  <Style Selector="Path.icon.size-15">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <Style Selector="Path.icon.size-16">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="1.07" />
  </Style>

  <Style Selector="Path.icon.size-18">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="StrokeThickness" Value="1.2" />
  </Style>

  <Style Selector="Path.icon.size-20">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="StrokeThickness" Value="1.33" />
  </Style>

  <Style Selector="Path.icon.size-22">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="StrokeThickness" Value="1.47" />
  </Style>

  <!--
    One of the thirty-five is filled rather than stroked, and it is the prototype's decision: a play
    triangle drawn as an outline reads as a hollow arrow at 22 px. `fill: currentColor, stroke: none`
    are its own words.
  -->
  <Style Selector="Path.icon.filled">
    <Setter Property="Fill" Value="{Binding $self.(TextElement.Foreground)}" />
    <Setter Property="Stroke" Value="{x:Null}" />
  </Style>

  <!--
    Round, and not a square with softened corners.

    <b>The medium radius again since 2026-09-01.</b> «Todos los botones o son redondos o son
    píldoras, pero nunca cuadrados» made this a circle on 2026-08-25, and the owner withdrew that
    rule the moment it was measured against the design: an element matches the prototype, and the
    prototype draws <c>pbtn</c> — the player's icon buttons — at <c>borderRadius: 8</c>, which is
    this scale's medium.

    <b>The 44 px target is a separate decision and it stays.</b> The prototype draws pbtn at 36 by
    36; 44 is the accessible target size, and shrinking it would trade a measurable accessibility
    floor for eight pixels of shape. The radius was never what made this differ from the design —
    the size was, deliberately, and it is written here rather than left to be rediscovered.
  -->
  <Style Selector="Button.player-chrome">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
    <!--
      The player's ink and not the theme's: these icons sit on the chrome band, which is dark in all
      four modes, and the base ControlTheme's foreground is dark in two of them. The icons take it by
      inheritance, exactly as the glyphs they replaced did.
    -->
    <Setter Property="Foreground" Value="{DynamicResource PlayerTextBrush}" />
  </Style>

  <!--
    The pills that head the player and decide what the side column shows. They are theme-option's
    grammar - plain fill unpressed, the subtle accent and the accent border when pressed - on the
    player's band, which is dark in all four modes: theme-option itself paints TextPrimaryBrush, and
    that is dark ink in two of them, over a surface that never is.

    44 and not the prototype's 30, which is the same trade player-chrome already made two styles up:
    these sit in a row with those, a band as tall as the taller of the two, and a 30 px target beside
    a 44 px one would be the only control on this header somebody has to aim at.
  -->
  <Style Selector="Button.player-pill">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <!--
      Back to the small radius on 2026-09-01. It drew one until 2026-08-25, when «a button is round
      or a pill, never a square with its corners taken off» made it a pill; the owner withdrew that
      rule the moment it was measured against the design, and the prototype draws pbtnAudio,
      pbtnSubs, pbtnVideo, pbtnMarks and pbtnLessons at borderRadius: 4. The name stays because five
      tests and the walk address it, and a rename buys nothing the comment does not.
    -->
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource PlayerHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource PlayerTextBrush}" />
  </Style>

  <!--
    The open one, said twice: the accent fill and border, and the state glyph its content carries.
    Both high contrast dictionaries resolve AccentSubtleBrush and Transparent to surfaces a person
    cannot tell apart, so the glyph is the whole signal there - the same reason theme-option.selected
    is never alone either.
  -->
  <Style Selector="Button.player-pill.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    One lesson in the player's «Lecciones» column (CRS-004). The whole row is the button, which is
    what the prototype draws: a name held as text with a play button on the end would put the target
    on the smallest thing in the row.

    34 and not the 44 the pills above take. These are not a row of controls on a band — they are a
    list somebody scrolls, and a course of forty lessons at 44 px is four hundred px of extra column
    to travel. It is the prototype's own minimum, and the row is full-width, so the target is 320 px
    wide even at that height.

    Transparent and borderless at rest so that a list of forty reads as a list rather than as forty
    buttons, which is the same reason the library's own rows carry no chrome until they are pointed
    at.
  -->
  <Style Selector="Button.lesson-row">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <!--
      7, which is the prototype's own and which none of the three radius tokens carries: the scale is
      4, 8 and the pill, and this sits between the first two. Written as the literal it is rather
      than rounded to a token it is not - the owner's rule of 2026-09-01 is that an element matches
      the design, and 4 or 8 here would be a shape the design does not draw.
    -->
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource PlayerTextBrush}" />
  </Style>

  <!--
    The lesson the session is on, said with a fill, a border and the ◐ its glyph already carries -
    three signals rather than one, for the reason player-pill.selected is written the same way: both
    high contrast dictionaries resolve AccentSubtleBrush and Transparent to surfaces a person cannot
    tell apart, and there the glyph is the whole signal.
  -->
  <Style Selector="Button.lesson-row.current">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    The two clocks either side of the scrubber. 58 is the prototype's own minimum and it is a minimum
    rather than a width because the same bar has to hold 2:00:00 and 49:06: fixed at the shorter one
    the hour would be clipped, and left to itself the bar would jump sideways every time the position
    crossed from 9:59 to 10:00. Neither number belongs to a scale this repository tokenises - the
    three are the type sizes, the five spaces and the two radii - so this is where it is written.
  -->
  <!--
    The magnifier inside the search box, which the prototype draws at `left: 9` over a field padded to
    34. It is a decoration and not a control: the box beside it already carries the accessible name, so
    a second name here would have a screen reader say "Buscar en la biblioteca" twice, and
    IsHitTestVisible="False" keeps a click on the glyph landing in the field where somebody aimed it.

    Both numbers live here rather than in the view for the same reason the rail's 46 x 42 does: they
    are a pair — the padding exists to leave room for the glyph — and a pair split across two files is
    a pair that stops agreeing.
  -->
  <Style Selector="TextBox.search-field">
    <Setter Property="Padding" Value="34,5,10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
  </Style>

  <Style Selector="Path.search-adornment">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>

  <!--
    The prototype's drop-down pill: the field's name in small type, the chosen value in bold, and a
    chevron, all inside one pill — «Estado  Todos ▼». A ComboBox restyled rather than a button with a
    flyout, which is what the control inventory prescribes ("en AXAML es una plantilla, no un control
    nuevo"): the walk keeps pressing the same ComboBox and asserting IsDropDownOpen, and the
    SelectedValue binding keeps carrying the choice.

    The template keeps the Fluent theme's part names — Border#Background, ContentControl#ContentPresenter —
    because that is what the five states hang from: the theme's own pseudo-class styles target those
    names and read ComboBoxBackgroundPointerOver and its siblings, which this file already redirects
    to the control-fill tokens. A template that renamed its parts would compile, render, and quietly
    have one state, which is exactly the kind of silence regla 6 exists to prevent.

    The label rides in Tag: it is presentation of a name the control already announces — each of
    these ComboBoxes carries the same resource as its AutomationProperties.Name — so painting it is
    the metadata editor's label-on-screen rule, not a second name.
  -->
  <Style Selector="ComboBox.filter-pill">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border
              x:Name="Background"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*,Auto">
              <!--
                One pixel of bottom margin on the words and none on the caret, which is the recipe
                the buttons already carry and the reason it is written twice. A font's ascent and
                descent are not symmetric, so a label centred to the pixel draws its ink below the
                middle; the owner reported the same list on 2026-08-25 — «los desplegables tienen el
                mismo problema de alineación vertical que tenían los botones». The chevron is left
                alone because a glyph is centred by its geometry and has no baseline to answer for.

                It was five until 2026-08-29 and that is the point of writing the number down: the
                buttons moved to one and these two copies did not, which left every dropdown's label
                and value 2 px above the middle — the overcorrection that had just been taken off
                the buttons, reintroduced by half. The number is the buttons' own and it now comes
                from a rasterised measurement rather than from the font's metrics; when it moves
                again, these two move with it.
              -->
              <TextBlock
                  Margin="0,0,8,1"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  Text="{TemplateBinding Tag}" />
              <!--
                The item's template travels with the item, or the presenter is handed a view model
                and no way to draw it and prints its type name: the season picker of a series read
                `ApSolutions.LocalMedia.Presentation.Show.SeasonViewModel` on screen until a capture
                caught it. The base theme's template binds both, and this one had only the first.
              -->
              <ContentControl
                  x:Name="ContentPresenter"
                  Grid.Column="1"
                  Margin="0,0,0,1"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding SelectionBoxItem}"
                  ContentTemplate="{TemplateBinding ItemTemplate}"
                  FontWeight="SemiBold" />
              <Path
                  x:Name="DropCaret"
                  Grid.Column="2"
                  Classes="icon size-14"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  Data="{DynamicResource IconChevronDown}" />
            </Grid>
          </Border>
          <Popup
              Name="PART_Popup"
              InheritsTransform="True"
              IsLightDismissEnabled="True"
              IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
              MaxHeight="{TemplateBinding MaxDropDownHeight}"
              MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
              PlacementTarget="Background"
              WindowManagerAddShadowHint="False">
            <!--
              Named because the speed pill opens upward and has to move these four pixels of air to
              the other side of the panel. A part a style has to reach needs a name, which is the
              same reason Border#Background and Path#DropCaret carry theirs.
            -->
            <Border
                x:Name="DropDownSurface"
                Margin="0,4,0,0"
                Padding="4"
                Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusMedium}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBox.filter-pill:dropdownopen /template/ Path#DropCaret">
    <Setter Property="Data" Value="{DynamicResource IconChevronUp}" />
  </Style>

  <!--
    And the frame under that caret, which said nothing at all while its panel was open. The prototype
    writes both halves — `border: 1px solid var(accent); background: var(accent-sub)` when open
    against `var(border-strong)` over `var(fill)` when closed — and only the caret had been
    carried across. «Lo mismo ocurre con los desplegables», 2026-08-25.

    On the named part of the template and not on the control: the frame is Border#Background, and a
    setter on the ComboBox itself loses to the control theme exactly as it does on a Button.
  -->
  <Style Selector="ComboBox.filter-pill:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ComboBox.filter-pill:disabled /template/ Path#DropCaret">
    <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!--
    The transport's speed pill, which is the one drop-down in this application that opens upward.
    It has to: the transport is the bottom edge of the player, and a panel dropping from it would
    open off the screen. The prototype writes exactly that — `position:absolute; bottom:38px` — and
    turns its caret the other way round, which the caret style above already does from the same
    pseudo-class.

    Three overrides and no second template. Placement is one of them because the pill's own template
    does not bind PlacementMode: five drop-downs share that template and four of them open downward,
    so the Popup takes its default and this one asks by class instead. The margin comes with it —
    four pixels of air belong on the side the panel is actually on.
  -->
  <Style Selector="ComboBox.speed-pill /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="Top" />
  </Style>

  <Style Selector="ComboBox.speed-pill /template/ Border#DropDownSurface">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!--
    And the closed face, which says the multiplier where the open row says the word for it: the
    prototype's pill reads «VELOCIDAD 1× ▲» and its row reads «● Normal · 1×». Both are drawn from
    the same step, so one of the two has to be told to draw it differently.

    Null rather than a second DataTemplate, and that is what SpeedOption.ToString is for: a presenter
    with no template asks the object what it is, and this object answers with the multiplier. Written
    down because painting a record's own ToString is normally the defect MarkerRowLabelConverter
    exists to fix — the difference is that this one is written, tested, and is the shorter of the two
    faces rather than a type name nobody meant to show.
  -->
  <Style Selector="ComboBox.speed-pill /template/ ContentControl#ContentPresenter">
    <Setter Property="ContentTemplate" Value="{x:Null}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    The mark on the step in force. It is the prototype's «●» and it is the third signal on that row,
    beside the wash and the border — and on the two high contrasts it is the only one, because both
    of those dictionaries resolve ComboBoxItemBackgroundSelected and the resting fill to the same
    colour. Same reasoning as the state glyph on the appearance pills and the bar on the rail.

    Hidden by a style and shown by a more specific one, never by a local IsVisible in the template: a
    local value outranks every setter in Avalonia, so a mark written as hidden in the markup would
    stay hidden on the selected row too. Measured the hard way elsewhere in this file.
  -->
  <Style Selector="TextBlock.speed-mark">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ComboBoxItem:selected TextBlock.speed-mark">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!--
    The prototype's «Otras acciones» row: full width, an icon at the left, the label beside it and
    what the mark currently is at the right. It is a ToggleButton because that is what it does, and
    the class is what stops it from looking like a pill in a column of rows.
  -->
  <!--
    The «Otras acciones» row, in both of the shapes that column holds: a mark you turn on and off
    is a ToggleButton, a decision you make once is a Button, and the prototype draws them the
    same — full width, icon, name, and whatever the current answer is at the right edge. Three of
    them were loose pills in a WrapPanel, which is a form dropped into a 320 px column.
  -->
  <!--
    5 and not the pill, which is the whole of what the withdrawn «round or pill» rule cost this row.
    The prototype writes the other two numbers of this style verbatim — min-height:36px and
    padding:0 12px — and its corner beside them is border-radius:5px. A pill was never the design's
    answer here; it was a grammar applied over it.
  -->
  <Style Selector="Button.action-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="ToggleButton.action-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <!-- Ten of these fit a 320 px column on one line, which is the whole reason for the width. -->
  <!--
    The rating: five stars where there were ten numbered squares. What says a star is given is its
    fill and not a mark beside it, because «three of five» is what a rating means and a dot on the
    third would say «this one». The outline is the same shape unfilled, so a row of five reads as
    five of one thing.

    Padding zero for the reason player-chrome has it: the content is a glyph, and the five pixels
    that put a word right would push a shape above the middle of its own target.
  -->
  <Style Selector="Button.rating-choice">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rating-choice /template/ ContentPresenter Path">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Button.rating-choice.given /template/ ContentPresenter Path">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    The prototype's small secondary button — btnSecSm — which is what rides inside a row rather than
    under a heading: 30 px tall against the ordinary 36, and the caption size. A row of full-height
    buttons makes every list in the application look like a form.
  -->
  <Style Selector="Button.compact">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  </Style>

  <!--
    The prototype's segmented pill, which it draws in three places: the seasons of a series, the two
    tabs of the editor, and the type filter of the library. One style rather than three, because the
    thing being chosen differs and the grammar does not.

    The chosen one is filled with the accent's own subtle wash and written in the accent's ink; the
    rest carry the control fill and the secondary ink, and their border is transparent so the row
    does not read as four boxes. The checked setters go on the presenter for the reason
    primary-action's do: measured, a Background setter on the ToggleButton itself loses to the base
    theme, and a pill that lost its fill would be a chooser with no answer showing.
  -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="15,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <Style Selector="ToggleButton.segment:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <Style Selector="TextBlock.transport-clock">
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource PlayerTextBrush}" />
  </Style>

  <!--
    The navigation rail of the redesign: 64 px of glyphs, where it used to be 248 px of words. The
    destinations keep their AutomationProperties.Name, so a reader still hears "Biblioteca" and the
    walk still presses the same five identities - only the Content changed, which is exactly the move
    the mini player's chrome already made.

    46 x 42 with a radius, and the radius is the 12 the prototype draws. This comment claimed
    CornerRadiusMedium until 2026-09-01 while the setter below wrote the pill — two numbers, neither
    of them the design's, and the reason given was that a third value for one consumer is the shape
    FontSizeMono was refused for. ADR-0007 retires that reasoning: a value with no token is written
    as a literal, because rounding 12 to a token draws a corner the design does not have.

    The open destination is told by a fill AND a 3 px bar, which is two signals with one of them not
    colour - the bar is present or absent rather than tinted. The hollow-and-filled circle that used
    to be the second signal is gone with the words: a 64 px rail has room for one mark, and it is the
    one that says which destination this is.
  -->
  <Style Selector="Button.navigation-destination">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    The one control at the foot of the rail, and it is not a destination: the prototype puts "Add
    media" there, below the flexible gap, and gives it the one thing it withholds from the five above
    - a hairline border. That border is the whole difference in the drawing and it carries the whole
    difference in meaning: the five say where you are, this one does something. Nothing about it is
    ever "current", so it has no fill and no 3 px bar to be given.

    Same 46 x 42 as a destination, because they share a 46 px column and a button narrower than its
    neighbours in a rail of six reads as an accident rather than as a distinction.
  -->
  <Style Selector="Button.navigation-action">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- railAdd's own corner, the same 12 as the five above it. -->
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    apr-tip, the first of the package's four animations: a tooltip arriving 6 px from the left rather
    than appearing whole. It belongs to the rail's six destinations, which is where the words went
    when the rail became pictograms - a tooltip is how somebody finds out what a glyph means, so the
    one animation that helps rather than decorates is the one on it.

    The duration comes from the MotionDuration token, and that is the whole reduced-motion contract:
    FluentThemeService writes TimeSpan.Zero into it when Windows asks for less motion, so this goes
    to 0 ms instead of getting shorter. ReducedMotionTests refuses a duration written any other way.
  -->
  <Style Selector="ToolTip">
    <Style.Animations>
      <Animation Duration="{DynamicResource MotionDuration}" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="-6" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    apr-pulse, the second: the dot beside "scanning" breathing while a scan is running. It is the one
    place in the application where something is happening that nobody started and nothing else says
    is still going - the count beside it changes in steps, and between two steps a still dot and a
    finished scan look the same.

    It loops, which is why it is the only one here with an iteration count, and it stops being drawn
    at all when the scan ends, because the dot's own IsVisible follows IsRunning. Under reduced
    motion the duration is zero and the dot simply sits there at full opacity.
  -->
  <Style Selector="TextBlock.scan-pulse">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Animations>
      <Animation Duration="{DynamicResource MotionDuration}" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    apr-shim, the third: the placeholder a grid wears while its query runs. The prototype sweeps a
    gloss rectangle across each card over 1.2 s; here the shimmer is the same breathing the scan dot
    uses, because this repository holds ONE motion token - MotionDurationStandardMilliseconds and
    its reduced twin were once a parallel copy that nothing spent, and the fix was one number the
    service writes zero into. A second, slower token would be that defect returning dressed as a
    sweep. Under reduced motion the placeholder simply stands still, which is what a skeleton is.
  -->
  <Style Selector="Border.apr-shim">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <!-- A cover's hole wears a cover's corner: skelStyle is the same 10 artBox is. -->
    <Setter Property="CornerRadius" Value="{DynamicResource PosterCornerRadius}" />
    <Style.Animations>
      <Animation Duration="{DynamicResource MotionDuration}" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.55" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    The rail's six pictures, centred in the 46 x 42 they share. It stopped being a font on
    2026-08-24 — the rail is one of the nine places that drew a Segoe glyph where the prototype
    draws a line icon — so what is left here is the placement, and the drawing belongs to Path.icon.
  -->
  <Style Selector="Path.navigation-glyph">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    The four lists of the player's 320 px column. §4 asks for rows of 36, never a sideways scroll, and
    text truncated into a tooltip; the height and the truncation live here because the four are one
    change, and repeating them per view is how three of them end up agreeing and the fourth does not.

    Height and not MinHeight: measured on 2026-08-21, a marker row came out at 44 with MinHeight 0,
    because the row's height is the container's padding plus a line of text. That is the same shape as
    the progress bar that read 4 where 3 was asked - the setter that names the number is not always the
    one that decides it - so the padding loses its vertical half in the same breath.

    A descendant selector and not a child one: the container is generated inside the items panel, so
    ListBox.side-list > ListBoxItem matches nothing at all and would fail silently.
  -->
  <Style Selector="ListBox.side-list">
    <!--
      The index is rows on the shell's own surface, not a list in a box: the base theme's fill,
      border and padding are the pale panel the poster rails already had to shed.
    -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.side-list ListBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!--
      7, written as a literal because the scale has no 7 and rounding to the 4 next to it would draw
      a shape the design does not have - ADR-0007's first consequence. The prototype's row is 32 px
      tall with 5px 9px of padding, and it read as 4 until 2026-09-03.
    -->
    <Setter Property="CornerRadius" Value="7" />
    <!--
      As wide as their own words, not the panel: the row of an index is a label, and the strip to
      its right is what gives the walk's beside-click somewhere that is inside no command — the
      items sit flush above and below each other, so the side is the only free direction.
    -->
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="ComboBox.side-list ComboBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    One row of an option list — what the prototype draws where this application had a drop-down. The
    three lists of the player's panel are audio track, output device and subtitle track, and all
    three are `<label>` rows carrying a radio, not a `<select>`: the choices are three or four, they
    fit, and hiding them behind a click costs a click to learn what the other two even are.

    A Border around the RadioButton and not the RadioButton alone, and that is a measurement rather
    than a preference. Measured 2026-09-02 on the base theme's own template: it builds three Ellipses
    and a ContentPresenter and <b>no Border at all</b>, so Background and CornerRadius set on the
    control are properties nothing in the template reads — the fill would simply not appear, and a
    style that sets a property nobody reads is the shape of green this repository keeps finding.

    The numbers are the design's, taken from the row's own style object rather than from a
    screenshot: min-height 34, padding '0 8px', border-radius 4, and the chosen row washed with the
    accent.
  -->
  <Style Selector="Border.option-row">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    The wash the design puts behind the row in force: rgba(98,174,232,.16) is the accent at 16%, and
    AccentSubtleBrush is that same wash as a token — so it follows the six accents a person can pick
    and it turns into the right thing in both high-contrast themes, which a literal could not.
  -->
  <Style Selector="Border.option-row.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!--
    The control inside it fills the row, so the whole row answers a click the way the prototype's
    label does — a radio a person has to hit exactly is a 15 px target in a 34 px row.
  -->
  <Style Selector="RadioButton.option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
    <!--
      4 and not the theme's 8, and it is derived rather than chosen. Measured 2026-09-02: the
      template keeps a 20 px column for the circle whatever size the circle is, and the content
      starts at 20 plus this padding. The ellipses below are pulled to the left of that column — so
      the circle begins at the row's own 8 px of padding, which is where the prototype puts it — and
      they end at 15, leaving 20 + 4 - 15 = 9, the gap the design writes.

      At the theme's 8, with the circle centred in its column, the gap came out 10.5, and no whole
      padding answers 9 from a centred 15 px ellipse: the layout rounds, so 6.5 measured 8.5 and 7
      would measure 9.5. What the gate measures is the GAP and not this setter, so the day the base
      theme changes that column, the measurement is what says 4 has stopped being the right answer.
    -->
    <Setter Property="Padding" Value="4,0,0,0" />
  </Style>

  <!--
    15 and not the theme's 20, measured the same day: OuterEllipse and CheckOuterEllipse both come
    out 20x20 with an 8x8 glyph inside. The design draws 15, which is a third smaller and the
    difference between a control that sits in a 34 px row and one that fills it.

    The glyph moves with them, at the ratio the theme itself uses — 8 of 20 is 6 of 15 — because
    leaving it at 8 inside a 15 px circle would draw a dot with almost no ring around it.
  -->
  <Style Selector="RadioButton.option /template/ Ellipse#OuterEllipse">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <Style Selector="RadioButton.option /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <Style Selector="RadioButton.option /template/ Ellipse#CheckGlyph">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="4.5,0,0,0" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <!--
    What the endpoint can carry, at the end of its own row. Eleven and dimmed, which is how the
    design separates a fact about the device from the name a person is choosing by — and it is the
    only one of the three lists that has a second string to draw at all.
  -->
  <Style Selector="TextBlock.option-capabilities">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeFootnote}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!--
    A rail of posters is a row of cards on the shell's own surface, not a list in a box. The base
    ListBox brings a fill, a border and a padding of its own, and all three drew a pale panel behind
    the three rails on Home the moment the cards became 2:3 - a container nobody asked for around
    content that is already separated by the cards' own shape.

    It is a class here rather than three copies of the same three setters, which is the shape the
    unavailable badge already had to be rescued from.
  -->
  <Style Selector="ListBox.poster-rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    A card in the library grid is a button whose whole face is the card, so it brings no chrome of its
    own at rest: a border and a fill around every poster would draw a grid of boxes over a grid of
    pictures. Only the resting state is given here. Hover, pressed, focus and disabled keep coming
    from the selectors above, which is the point of setting one state rather than restyling the
    control - the five states stay one decision, made once.
  -->
  <Style Selector="Button.poster-card">
    <!--
      12, which is the tile's own corner in the prototype and not the cover's: the button is the
      8 px of padding around the picture, and the picture's 10 belongs to the Border inside
      PosterCardView. Two radii for two rectangles, which is what the design draws.
    -->
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource PosterCardPadding}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <!--
      A card fills itself, which is what it did before the base style started centring: its content
      is a poster and a title that own the whole tile, not a label to be placed in the middle of one.
    -->
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    The label of such a row. It never wraps, because a row of fixed height that wrapped would hide the
    second line rather than shorten the first; what it does instead is end in an ellipsis and hand the
    whole string to a tooltip, which is the only reason truncating is acceptable at all.
  -->
  <Style Selector="TextBlock.row-label">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    The three circles this application uses for state. Measured on 2026-08-22 at FontSizeBody: a Fluent
    glyph renders 14 wide by 14 tall, because an icon font fills its em box, and ● renders 9 - the
    circle was reading at 64% of the icon and looking like a stray character instead of a state.

    FontSizeSubtitle brings it to 13, or 93%, and it is a step the scale already has. Nothing between
    the two exists in it, and a scalar declared for this alone would be the token-with-one-reader this
    repository refuses - so the nearest existing step is what it gets, and the missing 7% is a
    difference nobody can see between two screens.

    One class for all thirteen: three in the watch status, five in the navigation rail and five in the
    appearance pills. Three of thirteen at one size and ten at another is the inconsistency this batch
    keeps finding assembled.
  -->
  <Style Selector="TextBlock.state-glyph">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    One of the six accent swatches: a circle of the colour it stands for, with the state glyph in
    the middle. 28 is the prototype's own diameter and it has no token — the three scales this
    repository gates are the type sizes, the five spaces and the two radii — but 44 is the target
    area every other command control on this page takes, so the circle is 28 inside a 44 button
    rather than a 28 px thing to aim at.

    The border is what says which one is chosen at a glance, and the glyph is what says it in both
    high contrasts, where the six fills resolve to one colour and a border alone would be six
    identical rings.
  -->
  <Style Selector="Button.accent-swatch">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <!-- The token and not a copy of half the side: one number decides every button's shape. -->
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    The chosen swatch, said with the swatch's own edge. It carried the ● and ○ every pill row in this
    tree spends, and the owner was right that it does not belong on a circle of colour: a small ring
    drawn inside a large one reads as a radio button somebody dropped there. The prototype rings the
    chosen swatch in the page's ink instead, and that is geometry in exactly the way the glyph was —
    both high contrast dictionaries paint a border, so nothing is lost where colour says nothing.

    Three pixels of border rather than one, which is what makes it a ring rather than a slightly
    darker edge, and the fill stays the colour it stands for.
  -->
  <Style Selector="Button.accent-swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <!--
    The seventh circle, which is the picker rather than a colour: it wears whatever is in force and
    carries a chevron to say it opens something. Dashed while nothing custom is chosen, so a row of
    six solid circles and one outline reads as "and anything else".
  -->
  <Style Selector="Button.accent-swatch.custom">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--
    One cell of the picker's grid. Square rather than round, and small: forty-eight of these are a
    palette to sweep an eye across, not forty-eight things to aim at one by one — the six presets
    above are the ones sized as targets.

    <b>And it drew a pill for a week while this comment said «square».</b> The withdrawn «round or
    pill» rule turned it on 2026-08-25 and left the sentence above it standing; measured on
    2026-09-01, that rule moved seven classes and this was the only one whose own comment contradicted
    what the setter did. The design does not answer here — the prototype opens the operating system's
    colour control and draws no grid — so what it goes back to is what it was before a retired rule
    changed it, which is a different thing from inventing a shape.
  -->
  <Style Selector="Button.colour-cell">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--
    The hue slider paints the wheel it runs along, which is the one thing a colour picker cannot say
    in words. Six stops and the seventh back at red, because hue is a circle.
  -->
  <Style Selector="Slider.hue /template/ Border#TrackBackground">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#FF0000" />
        <GradientStop Offset="0.166" Color="#FFFF00" />
        <GradientStop Offset="0.333" Color="#00FF00" />
        <GradientStop Offset="0.5" Color="#00FFFF" />
        <GradientStop Offset="0.666" Color="#0000FF" />
        <GradientStop Offset="0.833" Color="#FF00FF" />
        <GradientStop Offset="1" Color="#FF0000" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!--
    The prototype's seg(false), and the two setters that were wrong are the two that make a group of
    pills read as a group: <b>no border and the quiet ink.</b>

    It carried ShellBorderBrush and TextPrimaryBrush, so the two options nobody had chosen were drawn
    with a full outline and full-strength text — three pills that all look chosen, with one of them a
    little bluer. «Los botones de filtro de Biblioteca no son iguales a los del prototipo. Cuando
    están seleccionados tienen un estado y cuando no otro», said on 2026-08-25. seg(false) is
    `border: 1px solid transparent; background: var(fill); color: var(text2)`, and that is what
    is here now: the thickness stays so choosing one never shifts the row, and only the colour moves.

    The states go on the presenter, because the presenter is what paints — the same measurement the
    five base states rest on.
  -->
  <Style Selector="Button.theme-option">
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.theme-option /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The chosen one of a group of pills, which is the prototype's seg(true): the subtle accent as fill
    and the accent itself as border, against seg(false)'s plain fill and no border at all.

    It is the second signal and never the only one. Every pill wearing this also carries the state
    glyph beside its label, because both high contrast dictionaries resolve AccentSubtleBrush and
    ControlFillBrush to the same white or the same black - the fill says nothing there, and the glyph
    is what is left. That is the same reason the navigation rail spends a bar and a glyph rather than
    a colour, and it is regla 6 of this tree read as a rule about signals rather than about numbers.
  -->
  <Style Selector="Button.theme-option.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.theme-option.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!--
    The row-card, which is the prototype's unit for one setting: the name, the sentence that says what
    it does underneath it, and the control against the right edge. It draws
    `padding:13px 16px; border-radius:10; gap:14` over the card surface with a hairline border, and what is
    written here is 12/16, CornerRadiusMedium and Space16 - the steps this scale already has. Three
    scalars declared to be within a pixel of the prototype would be three numbers nothing else spends,
    which is the shape FontSizeMono was refused for, and the difference is invisible on a screen.

    The hairline and not ShellBorderBrush: this border separates two surfaces rather than enclosing a
    control, and it is solid black or solid white in the two high contrasts, where CardSurfaceBrush and
    ShellSurfaceBrush are the same colour and the border is the only thing that says where the card is.

    <b>The Grid that goes inside belongs to the view, and it has to be a Grid.</b> A horizontal
    StackPanel offers its children infinite width, so the sentence on the left would never wrap and
    the control would end up drawn off the side - nine measurements of that shape in this repository,
    and one of them is why AppearanceSettingsTests refuses a stack around the theme pills. The starred
    column holds the words and gives way; the Auto column holds the control and keeps the width it
    asks for.
  -->
  <Style Selector="Border.setting-row">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!--
      10, and not the medium token: the design draws this row at 10 and the scale stops at 8. A value
      with no token is written as a literal, because rounding to the nearest one draws a shape the
      design does not have - ADR-0007's first consequence, and ScalarTokenTests still forbids writing
      a number that HAS a token, which is a different thing.
    -->
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,12" />
    <!-- The prototype's elev shadow, and most of what reads as depth: a hairline alone is a drawing. -->
    <Setter Property="BoxShadow" Value="{DynamicResource ElevationShadow}" />
  </Style>

  <Style Selector="TextBlock.setting-name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.setting-description">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    The word beside the switch - "Activado" / "Desactivado" - which the prototype puts to the left of
    every toggle. It is Raw to the accessibility tree on purpose: the checkbox next to it already
    announces its own checked state, so a reader that also read this would hear the answer twice, and
    the second time in a voice that cannot be wrong about it. Same decision the magnifier took.
  -->
  <Style Selector="TextBlock.setting-state">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--
    The review inbox's candidate card. The prototype tints its <b>whole</b> border rather than a left
    edge - `borderColor: accent` above 60 %, `warn` below it - and the border is the one signal that
    survives a high contrast, where CardSurfaceBrush and ShellSurfaceBrush are the same colour.

    The class is switched from the model with Classes.suggested / Classes.pending rather than through
    a converter, because the two states are already two booleans on the card and a converter would be
    a third place that decides which is which.
  -->
  <Style Selector="Border.candidate-card">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!--
      10, the same literal the settings row carries and for the same reason: the design draws this
      card at 10, and it drew the medium 8 until 2026-09-03.
    -->
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.candidate-card.suggested">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.candidate-card.pending">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <!--
    The badge in the card's top right corner. The prototype draws a pill; this draws the radius the
    scale has, because a third radius declared for one consumer is what FontSizeMono was refused for.

    It keeps a border where the prototype has a transparent one: the two tinted backgrounds collapse
    into the surface in both high contrasts, and a badge told apart from its card by fill alone would
    stop existing there.
  -->
  <Style Selector="Border.state-chip">
    <Setter Property="BorderThickness" Value="1" />
    <!--
      The pill, and it read as the medium 8 until 2026-09-03: the prototype's tag is a capsule - a
      nowrap span with 2px 8px of padding and no fixed height - rather than a rounded box.
    -->
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
  </Style>

  <Style Selector="Border.state-chip.suggested">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.state-chip.pending">
    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <!--
    The green chip: a file that is there, said in colour as well as in the word, because a table of
    eight columns is scanned rather than read. There is no red twin — what a file that is NOT there
    gets is UnavailableBadge, the one control that says it, and a second shape saying the same thing
    is what UnavailableBadgeTests exists to refuse.
  -->
  <Style Selector="Border.state-chip.ok">
    <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PositiveBorderBrush}" />
  </Style>

  <Style Selector="Border.state-chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    The label over a value - "Confianza". Small and secondary, which is the only way a card can name
    five things without any of them shouting.

    IT WAS CALLED card-eyebrow AND TWELVE SITES WORE IT UNTIL 2026-09-03, eleven of them shouting:
    the eight column headings of the duplicates table and three of the candidate card's four labels.
    An eyebrow is an overline, and this class carries no tracking at all, so every one of those was
    drawing capitals with no spacing between them - the one thing every overline in the design does.
    They now wear column-overline and section-overline. The name went with them: this comment already
    said "without any of them shouting" while eleven of its readers shouted, and a name that invites
    the wrong use is how that happens twice.

    "Confianza" stays because the design agrees: 12px in the secondary ink, in ordinary case, beside
    the figure in semi-bold. The resource shouted that one too, and no longer does.
  -->
  <Style Selector="TextBlock.card-caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    Six px and not the poster's three: this bar is the value, not a mark across a picture, and it is
    the height the prototype gives it. MinHeight and MinWidth go with it for the reason PosterCardView
    measured - the base ControlTheme sets a minimum of its own, and Height alone lost to it.
  -->
  <Style Selector="ProgressBar.confidence">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ProgressBar.confidence.pending">
    <Setter Property="Foreground" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <!--
    THE COURSE'S THREAD CARD - «Dónde lo dejaste», the one panel of a course that answers where you
    were. The prototype washes it in the accent and rings it in the accent itself, which is what
    makes it the loudest thing on that screen without any of its text growing: the tree drew it as an
    ordinary card - the shell's border over the card's surface - and gave the loudness to a 20 px
    heading instead.

    12, and it is the design's own number rather than the medium token. The scale stops at 8 and this
    is a card rather than a row, which is the same reading Border.setting-row wrote at 10: a value
    with no token is a literal, and ScalarTokenTests forbids writing a number that HAS one, which is
    a different thing.

    IT LIVES HERE RATHER THAN IN THE VIEW, and that is the whole point of the batch this belongs to:
    a corner written into a view's own markup is invisible to SurfaceCornerTests, which pairs
    classes. Eighty-six sites were doing that on 2026-09-03; this is the first of them to move.
  -->
  <Style Selector="Border.thread-card">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!--
    The mark's notice, INSIDE the thread card and therefore over the accent's wash rather than over
    the page. It is the one element of this card the prototype does not draw - there a mark raises a
    toast, and this tree has no toast - so its shape is not read off the design: what is read off the
    design is that it has to stay visible now that the card behind it is the wash the notice used to
    use for itself.

    Hence the card's own surface with the accent around it. The border is not decoration: both high
    contrast dictionaries resolve AccentSubtleBrush and CardSurfaceBrush to the same ink, and a
    notice told apart from its card by fill alone would stop existing there - which is the reading
    Border.state-chip already wrote.
  -->
  <Style Selector="Border.thread-notice">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!--
    The rule over «Lo último que viste», which the prototype draws as a hairline across the card with
    ten pixels under it rather than as a gap. A gap alone would read as more spacing; the rule is what
    says the recap is a section of the card and not a third paragraph of it.
  -->
  <Style Selector="Border.thread-recap">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellHairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,10,0,0" />
  </Style>

  <!--
    THE REST OF THE THREAD CARD'S NUMBERS, and they live here for the same reason its corner does:
    ScalarTokenTests forbids a view writing a size or a spacing of its own, and every one of these is
    a value the scale does not carry. Ten, six and three are not steps of the spacing scale and
    fifteen and twelve and a half are not steps of the type scale - they are what the prototype draws
    for this one card, and CourseThreadCardTests reads each of them out of the design rather than
    trusting the numbers written below.

    A class per element and not one clever shared one: the lesson and the minute differ in size,
    weight AND ink, and a class that had to pick would be wrong on the line a person came to read.
  -->
  <Style Selector="StackPanel.thread-column">
    <Setter Property="Spacing" Value="10" />
  </Style>

  <!--
    Three pixels between the lesson and its minute, which the prototype writes as the minute's own
    top margin. It is the tightest gap in the card on purpose: the two lines are one answer, and
    anything wider reads as two.
  -->
  <Style Selector="StackPanel.thread-head">
    <Setter Property="Spacing" Value="3" />
  </Style>

  <!-- The lesson itself: the one line the whole card exists to show, and the only 15 in the design. -->
  <Style Selector="TextBlock.thread-lesson">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The minute under it and every line of the recap: the same half-pixel step in the same ink. -->
  <Style Selector="TextBlock.thread-detail">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    The recap's bullet, in the accent rather than in the text it sits beside. It is the same size as
    that text so the two share a line, and it carries no ink of the secondary sort: the dot is what
    ties the recap back to the accent the card is washed in.
  -->
  <Style Selector="TextBlock.thread-bullet">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="StackPanel.thread-recap-body">
    <Setter Property="Spacing" Value="6" />
  </Style>
</Styles>
<?xml version="1.0" encoding="utf-8"?>
<!--
  WIN-002: what this process asks of Windows, written down instead of inherited.

  longPathAware lifts the 260-character ceiling on machines whose policy already allows it: a
  library under a deep NAS folder must not silently lose the files whose paths run long.

  PerMonitorV2 keeps the player's windows honest across monitors with different scale factors; the
  window coordinator already computes geometry in logical units on the assumption that rendering
  and layout share them.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
